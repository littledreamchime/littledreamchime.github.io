---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import '../styles/global.css';
import YoutubeIcon from './icons/YoutubeIcon.astro'
import XIcon from './icons/XIcon.astro';
import GithubIcon from './icons/GithubIcon.astro';
import MenuIcon from './icons/MenuIcon.astro'
---

<header class="custom-header">
	<!--Logo and mobile menu-->
	<div class="header-top">
		<!--logo-->
		<h2 class="header-signature"><a href="/">{SITE_TITLE}</a></h2>

		<!--mobile menu -->
		<button id="mobile-menu-btn" class="mobile-menu-btn" aria-label="Toggle menu">
			<MenuIcon/>
		</button>
	</div>

	<!--Main menu and socialMedia -->
	<div id="mobile-menu-content" class="header-menu-content">
		<!--Main menu -->
		<nav id="header-nav" class="header-nav">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/devlog">Devlog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</nav>
		<!--Social media -->
		<div class="header-social">
			<!--1.Youtube channel -->
			<a href="https://www.youtube.com/@LittleDreamChime" class="social-youtube" target="_blank" rel="noopener noreferrer">
				<span class="sr-only">Go to my YouTube channel</span>
				<YoutubeIcon />
			</a>
			<!--2.X account -->
			<a href="https://x.com/I_Life_Soul" class="social-x" target="_blank">
				<XIcon/>
			</a>
			<!--3.github -->
			<a href="https://github.com/littledreamchime" class="social-github" target="_blank">
				<GithubIcon/>				
			</a>
		</div>
	</div>
</header>


<style>
/* Header */
.custom-header{
    --header-dark-purple:rgba(48,10,60,0.9);
    --header-transparent:rgba(48,10,60,0);
    --header-menu-mobile:#31052f;
    --text-active:linear-gradient(0deg, #a329bb, #e3c1e4,#ffffff);
    --text-hover:#d8b4fe;
    --text-hover-line:#a46ae2;
    --social-youtube-hover:#e93232;
    --social-X-hover:#52174d;
    --social-github-hover:#52174d;

    position:fixed;
    display:flex;
    justify-content:space-between;
    align-items:start;
    top:0;
    left:0;
    z-index:300;

    box-sizing: border-box; 
    width: 100%;
    padding: 1.5rem 2rem;

    background: linear-gradient(to bottom,var(--header-dark-purple),var(--header-transparent));
}
/*Logo and mobile menu */
.header-top{
    display:flex;
    align-items: center;
}
/*Mobile menu*/
.mobile-menu-btn {
    display: none; 

    border: none;
    color: inherit;
    background: transparent;

    cursor: pointer;
}
.header-menu-content {
    display: flex;
    align-items: center;
    gap:0.2rem;
}
/*Logo*/
.header-signature{
    margin:0;

    font-family:var(--font-title);
    font-size:4rem;
    font-weight:normal;

    transform: translateY(-0.75rem);
}
.header-signature a{
    color:var(--text-primary);

    text-decoration: none;

    cursor: pointer;
}

/*Nav menu*/
.header-nav{
    display:flex;
    align-items: center;
    position:absolute;
    left:50%;
    gap:0.2rem;

    /*Hide At Start*/
    transform: translate(-50%,-150%);
    opacity: 0;
    pointer-events: none;
}
.header-nav.is-visible{
    opacity: 1;

    transform: translate(-50%,0);
    pointer-events: auto;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.8s ease;
}

.header-nav a{
    position:relative;

    width: 5rem;
    padding-top:0.6rem;

    color:var(--text-primary);

    font-family: var(--font-nav);
    font-size:1.1rem;
    text-align: center;
    text-decoration: none;

    transition:color 0.3s ease;
}
.header-nav a.active{
    background-image: var(--text-active);
    -webkit-background-clip: text;
    background-clip:text;
    color:transparent;
    text-decoration:none;
}
.header-nav a.active:hover{
    background-image: var(--text-active);
    -webkit-background-clip: text;
    background-clip:text;
    color:transparent;

    text-decoration:none;
}
.header-nav a::before {
    position: absolute;
    top: 0;
    left: 50%; 

    width: 0; 
    height: 3px; 
    border-radius: 2px;

    background-color: var(--text-hover-line);
    content: '';

    transform: translateX(-50%);
    transition: width 0.3s ease; 
}
.header-nav a:hover{
    color:var(--text-hover);
}
.header-nav a:hover::before,
.header-nav a.active::before {
    width: 100%;
}
/*Social*/
.header-social{
    display:flex;
    gap:2rem;

    transform: translateY(0.45rem);
}
.header-social a {
  display:flex;

  color: var(--text-primary);

  transition: color 0.3s ease,transform 0.3s ease;
}
.header-social a:hover {
  transform:scale(1.3);
}
.header-social a.social-youtube:hover {
    color: var(--social-youtube-hover);
}
.header-social a.social-x:hover {
    color: var(--social-X-hover);
}
.header-social a.social-github:hover {
    color: var(--social-github-hover);
}

/*Mobile*/
@media (max-width: 768px) {
	/* Header */
    .custom-header {
        flex-direction: column;
        align-items: stretch;

        padding: 1rem;

    	background: linear-gradient(to bottom,var(--header-dark-purple),var(--header-transparent));
    }
	/*Logo and mobile menu */
    .header-top {
        justify-content: space-between;
		
        width: 100%;
    }
	/*Mobile menu*/
    .mobile-menu-btn {
        display: block; 

        /* hide at start*/
        transform: translateY(-150%);
        opacity: 0;
        pointer-events: none;
        transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.8s ease;
    }
    .mobile-menu-btn.is-visible{
        opacity: 1;

        transform: translateY(0);
        pointer-events: auto;
    }


    .header-menu-content {
        display: flex; 
        flex-direction: column;
		overflow:hidden;
        gap: 1rem;

		width: 100%;
		max-height: 0;
        padding-top:0;
		padding-bottom: 0;
        margin-top: 0;
        border-top: 1px solid transparent;
		border-radius: 0.5rem;
		box-sizing: border-box;

		background-color: var(--header-menu-mobile);
		opacity:0;

		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .header-menu-content.show {
        display: flex;

        padding: 1.5rem; 
		max-height: 400px;
        margin-top: 1rem;
        border-top: 1px solid rgba(128, 128, 128, 0.2);

        opacity: 1;
        background-color: var(--header-menu-mobile);
    }
	/*Title*/
    .header-signature
    {
        transform:translateY(0.3rem);
    }
	/*Nav menu*/
    .header-nav {
        position:static;
        flex-direction: column;
        align-items: center; 
        gap: 1rem;

        width: 100%;

        transform:none !important;
        opacity: 1 !important;
        pointer-events: auto !important;
        transition: none;
    }
    .header-nav a::before {
        top: 55%;
        left: 0;
		
        width: 0.2rem;
        height: 0;

        transform: translateY(-50%);
        transition: height 0.3s ease;
    }
	.header-nav a:hover::before,
    .header-nav a.active::before {
        width: 0.2rem;
        height: 100%;
    }
	/*Social*/
    .header-social {
        justify-content: center;

        padding-bottom: 0.5rem;
        width: 100%;
    }
}

.no-transition {
    transition: none !important;
}
</style>

<script>
    import { isWelcomeDismissed } from "../store";

    document.addEventListener('astro:page-load',()=>
    {
        /* Hambuger menu*/
        const btn = document.getElementById('mobile-menu-btn');
        const content = document.getElementById('mobile-menu-content');
        const header_nav= document.getElementById('header-nav');

        if (btn && content) {
            btn.onclick = () => {
                content.classList.toggle('show');
            };
        }

        /* hide header nav*/
        if (window.location.pathname !== '/') {
            isWelcomeDismissed.set(true);
        }

        if(isWelcomeDismissed.get())
        {
            if(header_nav) {
                header_nav.classList.add('no-transition');
                header_nav.classList.add('is-visible');
            }
            if(btn) {
                btn.classList.add('no-transition');
                btn.classList.add('is-visible');
            }
        }
    });




    isWelcomeDismissed.listen((dismissed)=>
    {
        if(dismissed){
            const header_nav= document.getElementById('header-nav');
            const mobileBtn = document.getElementById('mobile-menu-btn');
            if(header_nav) {
                header_nav.classList.remove('no-transition');
                header_nav.classList.add('is-visible');
            }
            if(mobileBtn) {
                mobileBtn.classList.remove('no-transition');
                mobileBtn.classList.add('is-visible');
            }
        }
    });

    /*Get current page */
    import { currentView } from "../store";
    currentView.subscribe((view)=>{
        /*Change the nav menu*/
        const navLinks = document.querySelectorAll('#header-nav a');
        if (!navLinks.length) return;
        const viewToPath = {
            'Home': '/',
            'Blog': '/blog',
            'Devlog': '/devlog',
            'About': '/about'
        };
    const targetPath = viewToPath[view as keyof typeof viewToPath];

    navLinks.forEach(link => {
          let href = link.getAttribute('href');
          if(!href) return;
          let normalizedHref = href === '/' ? '/' : href.replace(/\/$/, '');

          if (normalizedHref === targetPath) {
              link.classList.add('active');
          } else {
              link.classList.remove('active');
          }
      });


    });
</script>