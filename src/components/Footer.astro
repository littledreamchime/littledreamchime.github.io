---
import '../styles/global.css';
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer class="customer-footer">
	<div class="footer-content">
		<!--Footer left ( Menu and info ) -->
		<div class="footer-left">
			<!--Nav Menu -->
			<div class="footer-nav">
				<a href="#top">↑ Back to top</a>
				<a href="/about">About Me</a>
				<a href="mailto:littledreamchime@gmail.com">Mail Me ✉️</a>
			</div>
			<!--Web info -->
			<div class="footer-info">
				<p>・Email: littledreamchime@gmail.com</p>
				<p> ・Since 2026 | 0 Posts | 0 Notes</p>
				<p>・Built with <a href="https://astro.build"target="_blank" rel="noopener noreferrer">Astro</a> | Hosted on github
				</p>
				<p> &copy; {today.getFullYear()} Bob Smith. No rights reserved.😋</p>
			</div>
		</div>
		<!--Footer right ( Logo )-->
		<div class="footer-right">
			<h2 class="footer-signature"><a href="/">{SITE_TITLE}</a></h2>
		</div>
	</div>
</footer>

<style>
	/*Main footer*/
	.customer-footer
	{
		--border: #64467c;
		--footer-text:#949494;
		--footer-link:#825491;
		--footer-link-hover:linear-gradient(0deg, #a329bb, #e3c1e4,#ffffff);

		padding:0.8rem 2rem;
		border-top: 1px dashed var(--border);

		text-align: left;
		font-size:0.9rem;
	}
	/*Footer content*/
	.footer-content{
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
	}
	/*Footer left ( Menu and info )*/
	.footer-left{
		display: flex;
		flex-direction: column;
	}
	/*Footer right ( Logo )*/
	.footer-right{
		display: flex;
		align-items: center;

		padding-right: 0.5rem;
		padding-bottom: 0.5rem;
	}
	.footer-signature{ 
        font-family: var(--font-title), serif; 
        font-size: 3rem;
        font-weight: normal;
        opacity: 0.5;

        transition: opacity 0.3s ease;
	}
	.footer-signature:hover {
        opacity: 1;
    }
	/*Nav Menu*/
	.customer-footer a{
		display: inline-block;

		color:var(--footer-link);

		text-decoration: none;
		white-space: nowrap;

		transition: transform 0.2s ease; 
	}
	@media(max-width:480px)
	{
		.foot-nav{
			flex-direction: column;
			gap:0.8rem;
		}
	}
	.customer-footer a:hover{
		background-image: var(--footer-link-hover);
		-webkit-background-clip: text;
		background-clip:text;
		color:transparent;

		text-decoration:none;

		transform: scale(1.2); 
	}
	.footer-nav{
		display: flex;
		gap: 2rem;
	}
	.footer-nav a{
		text-decoration: none;
	}
	/*info*/
	.customer-footer p {
		margin: 0.2rem 0; 
	}
	.footer-info a{
		padding: 0.2rem 0.2rem; 
		margin: -0.2rem 0.1rem; 
		
		color:var(--footer-link);
	}
	.footer-info p{
		color:var(--footer-text);
		line-height: 1;
	}
</style>
