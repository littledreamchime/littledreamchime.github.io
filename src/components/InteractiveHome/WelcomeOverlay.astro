---
import ScrollArrowIcon from "../icons/ScrollArrowIcon.astro"
---


<div id="welcome-overlay" class="welcome-overlay">
    <!-- Content -->
    <div class="content">
        <h1 id="type-title" data-text="[ WELCOME ]"></h1>
        <p id="type-subtitle" class="subtitle" data-text="Loading resources...^ Loading Successfully, scroll to access."></p>
    </div>

    <!--Scroll arrow -->
    <ScrollArrowIcon width="48"/> 
</div>

<style>
    /* Main */
    .welcome-overlay {
        display: flex;
        position: fixed;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        inset: 0; 
        z-index: 200; 
        
        background: linear-gradient(
            to bottom, 
            rgba(0, 0, 0, 1) 30%,
            rgba(0,0,0,0.6) 60%,
            rgba(0, 0, 0, 0.05) 90%,
            rgba(0, 0, 0, 0) 100%
        );
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(12px);
        color: white;
        
        transition: transform 1s cubic-bezier(0.7, 0, 0.3, 1), 
                    opacity 1s ease-in-out,
                    backdrop-filter 1s ease;
    }
    .welcome-overlay.dismissed {
        opacity: 0;
        backdrop-filter: blur(0px); 

        pointer-events: none;
        transform: translateY(-100vh);
    }

    /*Content*/
    .content {
        text-align: center;
        margin: 5%;

        transform: translateY(-2rem);
    }
    /* title */
    h1 {
        margin-bottom: 0.5rem;

        font-size: clamp(2rem, 5vw, 4rem);
        letter-spacing: 0.2rem;
    }
    .subtitle {
        color: #a3a3a3;

        font-family: monospace;
        letter-spacing: 0.1rem;
        font-size:1.75rem;
    }
    @media (max-width: 400px){
        .content{
            text-align:left;
        }
        h1{
            font-size: clamp(1.75rem, 4vw, 4rem);
        }
        .subtitle {
            font-size:1.125rem;
        }
    } 
    .typing-cursor::after {
        content: '█'; 
        margin-left:
        color: #be0abe; 
        animation: cursorBlink 0.8s step-end infinite;
    }
    @keyframes cursorBlink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
    }
    :global(#scroll-arrow) {
        opacity: 0;
        pointer-events: none;
    }
    :global(#scroll-arrow.visible) {
        opacity: 1;
        pointer-events: auto;
    }
</style>

<script>
    import { isWelcomeDismissed,preloadAssets } from "../../store";
    document.addEventListener('astro:page-load', () => {

        const overlay = document.getElementById('welcome-overlay');
        const arrowBtn = document.getElementById('scroll-arrow');
        const titleEl = document.getElementById('type-title');
        const subtitleEl = document.getElementById('type-subtitle');
        let isDismissed = false;
        let canDismiss = false;
        
        if (!overlay || !arrowBtn || !titleEl || !subtitleEl) return;

        /*Input Overlay*/
        if (sessionStorage.getItem('introSeen') === 'true' || isWelcomeDismissed.get()===true) {
            overlay.style.display = 'none';
            document.body.style.overflow = '';
            isWelcomeDismissed.set(true);  
            preloadAssets(); 
            return;
        }
        document.body.style.overflow = 'hidden';
        const dismissOverlay = () => {
            if (!canDismiss || isDismissed) return;
            isDismissed = true;

            sessionStorage.setItem('introSeen', 'true');
            overlay.classList.add('dismissed');
            isWelcomeDismissed.set(true);   

            setTimeout(() => {
                document.body.style.overflow = '';
                overlay.style.display = 'none'; 
            }, 1000); 
        };

        /*Type Writer*/
        function typeWriter(element: HTMLElement | null, baseSpeed: number, onComplete?: () => void) {
            if (!element) return;
            
            const text = element.getAttribute('data-text') || '';
            element.classList.add('typing-cursor'); 

            let i = 0;
            function type() {
                if(!element) return;
                if (i < text.length) {
                    const char = text.charAt(i); 
                    i++; 

                    if (char === '^') {
                        element.innerHTML += '<br>'; 
                        setTimeout(type, 1000);
                        return;
                    }
                    if(char==='~')
                    {
                        element.innerHTML += '<br>'; 
                        setTimeout(type, 10);
                        return;
                    }

                    element.innerHTML += char;
                    const randomDelay = baseSpeed + Math.random() * 50; 
                    setTimeout(type, randomDelay);
                } else {
                    element.classList.remove('typing-cursor'); 
                    if (onComplete) onComplete(); 
                }
            }
            type();
        }

        const typeWriterPromise= new Promise((resolve)=>{
            setTimeout(() => {
                typeWriter(titleEl, 3, () => {
                    typeWriter(subtitleEl, 3, () => {
                        if(subtitleEl) subtitleEl.classList.add('typing-cursor'); 
                        resolve(true);
                    });
                });
            }, 500);
        });

        const assetsPromise=preloadAssets();

        Promise.all([typeWriterPromise,assetsPromise]).then(()=>{
            canDismiss=true;
            if(arrowBtn) arrowBtn.classList.add('visible');
        });


        /*Event Listener*/
        arrowBtn.addEventListener('click', dismissOverlay);
        window.addEventListener('wheel', (e) => {
            if (e.deltaY > 0) dismissOverlay();
        });
        let touchStartY = 0;
        window.addEventListener('touchstart', (e) => {
            touchStartY = e.touches[0].clientY;
        });
        window.addEventListener('touchmove', (e) => {
            let currentY = e.touches[0].clientY;
            if (touchStartY - currentY > 50) dismissOverlay();
        });
    });
</script>