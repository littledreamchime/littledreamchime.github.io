---
import '../../../styles/zIndex.css';
import PowerIcon from '../../icons/PowerIcon.astro';
import ReturnIcon from '../../icons/ReturnIcon.astro';
---

<div id="computer-screen" class="computer-screen" transition:persist="computer-screen">
    <div class="screen-inner">
        <div class="screen-body">
            <div id="computer-wrapper" class="computer-wrapper"></div>
        </div>

        <!-- Bottom -->
        <div class="bottom-bar">
        
            <!-- Buttons -->
            <div class="left-controls">
                <!-- ClosePower -->
                <button id="power-btn" class="ctrl-btn">
                    <PowerIcon size="1cqi" />
                </button>
                <!-- Return -->
                <button id="return-btn" class="ctrl-btn">
                    <ReturnIcon size="1cqi" />
                </button>
            </div>

            <!-- Title -->
            <div class="center-text">
                Blog Storage System
            </div>

            <!-- signature -->
            <div class="right-signature">
                @BobSmith
            </div>

        </div>
    </div>
</div>


<style>
    /*screen*/
    .computer-screen {
        position: absolute;
        top:50%;
        left: 50%;
        transform: translate(-50%, -50%);
        padding: 0.45cqi;
        z-index: var(--z-desk-items-mid);
        will-change: transform;

        width: 45%;
        height: 45%;
        border-radius: 0.6cqi;
        background: linear-gradient(145deg, #1a1a1a, #0a0a0a);
        border: 0.05cqi solid #2a2a2a;
        box-shadow: 
        0 0.8cqi 2cqi rgba(0, 0, 0, 0.8),
        inset 0 0.05cqi 0.1cqi rgba(255, 255, 255, 0.08),
        inset 0 -0.05cqi 0.1cqi rgba(0, 0, 0, 0.5);
        
        box-sizing: border-box;
    }
    .screen-inner {
        display: flex;
        flex-direction: column;
        gap: 0.5cqi;

        width: 100%;
        height: 100%;
    }

    /*computer-wrapper*/
    .screen-body{
        flex: 1;
        overflow: hidden;
        width: 100%;
        position: relative;

        box-shadow: inset 0 0 100cqi rgba(0, 0, 0, 0.9);
        border: 0.05cqi solid #1f2937;
        border-radius: 0.5cqi;

        background-color: #161616; /* #1f0826 */
    }
    .computer-wrapper {
        flex: 1;
        inset:0;
        overflow: hidden;
        position: absolute;
        transform-origin: center center; 
        
        width: 100%;
        height: 100%;
        box-shadow: inset 0 0 100cqi rgba(0, 0, 0, 0.9);
        border: 0.05cqi solid #1f2937;
        border-radius: 0.5cqi;

        background-color: #1f0826; /* #1f0826 */
        opacity: 0;
        
        transform: scale(0);
    }
    /*Animation*/
    .computer-wrapper.power-on {
        animation: tv-on 0.5s cubic-bezier(0.23, 1, 0.32, 1) forwards;
    }
    .computer-wrapper.power-off {
        animation: tv-off 0.4s cubic-bezier(0.23, 1, 0.32, 1) forwards;
    }
    .computer-wrapper.power-on::after,
    .computer-wrapper.is-on::after {
        content: "";
        position: absolute;
        inset: 0;

        background: linear-gradient(to bottom, rgba(255, 255, 255, 0.155) 50%, rgba(0, 0, 0, 0.1) 50%);
        background-size: 100% 0.2cqi;
        opacity: 0.25;

        pointer-events: none;
    }
    @keyframes tv-on {
        0% {
            transform: scale(0.01, 0.01);
            opacity: 0;
            filter: brightness(10) contrast(3);
        }
        40% {
            transform: scale(1, 0.01);
            opacity: 1;
            filter: brightness(5) contrast(2);
        }
        80% {
            transform: scale(1, 1);
            filter: brightness(1.5);
        }
        100% {
            transform: scale(1, 1);
            opacity: 1;
            filter: brightness(1) contrast(1);
        }
    }

    @keyframes tv-off {
        0% {
            transform: scale(1, 1);
            opacity: 1;
            filter: brightness(1);
        }
        40% {
            transform: scale(1, 0.01);
            filter: brightness(5);
        }
        80% {
            transform: scale(0.01, 0.01);
            opacity: 1;
            filter: brightness(10);
        }
        100% {
            transform: scale(0, 0);
            opacity: 0;
            filter: brightness(0);
        }
    }

    .computer-wrapper.is-on{
        transform: scale(1, 1);
        opacity: 1;
        filter: brightness(1) contrast(1);
    }
    .computer-wrapper.is-off{
        transform: scale(0, 0);
        opacity: 0;
        filter: brightness(0);
    }


    /*bottom*/
    .bottom-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        height: 0.6cqi;
        padding: 0 0.4cqi;
    }

    /*buttons*/
    .left-controls {
        display: flex;
        gap: 1.5cqi;
        align-items: center;
        flex: 1; 
    }

    .ctrl-btn {
        display: flex;
        align-items: center;
        justify-content: center;

        border: none;
        padding: 0.3cqi;

        color: #4b5563;
        background: none;

        cursor: pointer;
        transition: color 0.3s ease, transform 0.1s ease;
    }

    .ctrl-btn.is-white:hover {
        color: #c460fa;
        filter: drop-shadow(0 0 1cqi rgba(201, 96, 250, 0.6)); 
    }

    .ctrl-btn.is-white {
        color: #d1d5db; 
        filter: drop-shadow(0 0 0.5cqi rgba(255,255,255,0.5)); 
    }

    /* text */
    .center-text, .right-signature {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Courier New", monospace;
        font-size: 0.7cqi;
        color: #666;
        letter-spacing: 0.05cqi;
    }

    .center-text {
        flex: 1;
        
        text-align: center;
        text-transform: uppercase;
        font-weight: 600;
        color: #796b80;
        font-weight: bold;
        text-shadow: 0 0 0.4cqi rgb(153, 112, 192);
    }

    .right-signature {
        flex: 1;
        text-align: right;
        font-style: italic;
        color: #594b63;
    }
    .no-animation {
        animation: none !important;
        transition: none !important;
    }
</style>

<script>
    import { addLeaveHook, currentView } from "../../../store";
    import { navigateWithAnimation } from "../../../utils/navigation";

    document.addEventListener('astro:page-load',()=>{
        const powerBtn=document.getElementById("power-btn");
        const returnBtn=document.getElementById("return-btn");
        const computerWrapper=document.getElementById("computer-wrapper");
        if(!powerBtn || !returnBtn) return;

        /* Btn Event*/
        /*Power Button*/
        if (!powerBtn.dataset.initialized) {
            powerBtn.addEventListener('click', () => {
                if(currentView.get().startsWith('Blog'))
                    navigateWithAnimation('/');
                else
                    navigateWithAnimation('/blog');
            });
            powerBtn.dataset.initialized = 'true';
        }
        if(currentView.get().startsWith('Blog')){
            powerBtn.classList.add('is-white');
        }
        else{
            powerBtn.classList.remove('is-white');
        }

        /*Return Button*/
        const ReturnBtnEvent=()=>{
            navigateWithAnimation('/blog');
        };
        if(currentView.get()!=='Blog' && currentView.get().startsWith('Blog')){
            if(!returnBtn.dataset.initialized){
                returnBtn?.addEventListener('click',ReturnBtnEvent);
                returnBtn.dataset.initialized = 'true';
            }
            returnBtn?.classList.add('is-white');
        }else{
            returnBtn.classList.remove('is-white');
            returnBtn.removeEventListener('click',ReturnBtnEvent);
            returnBtn.dataset.initialized = 'false';
        }

        /* Power on/off */
        
        if(!computerWrapper) return;
        
        
        if(currentView.get().startsWith('Blog')){
            computerWrapper.classList.remove('power-off','power-on','is-off'); 
            computerWrapper.classList.add('is-on');   
        }
        else{
            computerWrapper.classList.remove('power-off','power-on','is-on'); 
            computerWrapper.classList.add('is-off');   
        }

        addLeaveHook((targetView)=>{
            /* on */
            if(!currentView.get().startsWith('Blog') && targetView.startsWith('Blog')){
                computerWrapper.classList.remove('power-off','is-off','is-on'); 
                computerWrapper.classList.add('power-on');     
            }
            /* off */
            if(currentView.get().startsWith('Blog') && !targetView.startsWith('Blog')){
                computerWrapper.classList.remove('power-on','is-off','is-on');  
                computerWrapper.classList.add('power-off');    
            }
            return Promise.resolve();
        });
        
    });
</script>