---
import ScrollArrowIcon from "../../icons/ScrollArrowIcon.astro";
import { ANIMATION_TIMES } from "../../../config";
import '../../../styles/zIndex.css';
const headerShow=`${ANIMATION_TIMES.HEADER_SHOW}ms`;
import { getCollection } from 'astro:content';

const allDevlogs = await getCollection('devlog');
const allBlogs = await getCollection('blog');
const autoPreloadDevlogUrls = allDevlogs
    .filter(post => !post.id.endsWith('/config'))
    .map(post => encodeURI(`/devlog/${post.id}`)); 
const autoPreloadBlogUrls = allBlogs
    .filter(post => !post.id.endsWith('/config'))
    .map(post => encodeURI(`/blog/${post.id}`)); 
const allPreloadUrls = [...autoPreloadDevlogUrls, ...autoPreloadBlogUrls];
---
<script is:inline>
    if (typeof sessionStorage !== 'undefined' && sessionStorage.getItem('introSeen') === 'true') {
        document.documentElement.classList.add('hide-welcome');
    }
</script>
<script is:inline define:vars={{ allPreloadUrls }}>
    window.__AUTO_PRELOAD_URLS__ = allPreloadUrls;
</script>

<div id="welcome-overlay" class="welcome-overlay">
    <!-- 赛博网格背景 -->
    <div class="cyber-grid"></div>

    <!-- 核心内容区 -->
    <div class="content-wrapper">
        <!-- 标题区 -->
        <div class="header-section">
            <h1 id="type-title" data-text="HELLO! WELCOME!"></h1>
        </div>

        <!-- 加载动画区 (转圈 + 无限进度条) -->
        <div id="loading-ui" class="loading-ui">
            <div class="spinner-ring"></div>
            <div class="progress-track">
                <div class="progress-glow"></div>
            </div>
        </div>

        <!-- 终端日志区 -->
        <div class="terminal-logs">
            <p id="type-subtitle" class="subtitle"></p>
        </div>
    </div>

    <!--Scroll arrow -->
    <ScrollArrowIcon id="scroll-arrow" width="48" class="welcome-arrow" /> 
</div>

<style define:vars={{headerShow}}>
    :global(html.hide-welcome) .welcome-overlay {
        display: none !important;
    }

    /* =========================================
       Main Overlay (Holographic Terminal)
    ========================================= */
    .welcome-overlay {
        display: flex;
        position: fixed;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        inset: 0; 
		z-index: var(--z-welcome);
        
        /* 深邃的暗紫黑渐变底色 */
        background: radial-gradient(circle at center, rgba(30, 15, 45, 0.9) 0%, rgba(5, 2, 10, 1) 100%);
        backdrop-filter: blur(30px) saturate(150%);
        -webkit-backdrop-filter: blur(30px) saturate(150%);
        color: #e2d8ee;
        
        transition: transform var(--headerShow) cubic-bezier(0.7, 0, 0.3, 1), 
                    opacity var(--headerShow) ease-in-out;
    }
    
    .welcome-overlay.dismissed {
        opacity: 0;
        pointer-events: none;
        transform: translateY(-100vh);
    }

    /* 极弱的背景网格，增加科技感 */
    .cyber-grid {
        position: absolute;
        inset: 0;
        background: 
            linear-gradient(rgba(139, 92, 246, 0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(139, 92, 246, 0.03) 1px, transparent 1px);
        background-size: 40px 40px;
        pointer-events: none;
        z-index: 0;
    }

    /* =========================================
       Content Layout
    ========================================= */
    .content-wrapper {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        max-width: 600px;
        padding: 2rem;
        transform: translateY(-2rem);
    }

    /* Title */
    .header-section {
        margin-bottom: 2rem;
        text-align: center;
    }
    h1 {
        margin: 0;
        font-family: 'Inter', ui-monospace, SFMono-Regular, monospace;
        font-size: clamp(1.8rem, 4vw, 3.5rem);
        font-weight: 700;
        letter-spacing: 0.15em;
        color: #f3e8ff;
        text-shadow: 0 0 20px rgba(167, 139, 250, 0.6);
    }

    /* =========================================
       Loading UI (Spinner & Progress Bar)
    ========================================= */
    .loading-ui {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
        transition: opacity 0.5s ease, transform 0.5s ease;
    }
    .loading-ui.fade-out {
        opacity: 0;
        transform: scale(0.95);
        pointer-events: none;
    }

    /* 科技感加载环 */
    .spinner-ring {
        width: 40px;
        height: 40px;
        border: 2px solid rgba(139, 92, 246, 0.1);
        border-top: 2px solid #a78bfa;
        border-right: 2px solid #a78bfa;
        border-radius: 50%;
        animation: spin 1s cubic-bezier(0.68, -0.55, 0.265, 1.55) infinite;
        box-shadow: 0 0 15px rgba(139, 92, 246, 0.4);
    }
    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    /* 无限扫描进度条 */
    .progress-track {
        width: 80%;
        max-width: 300px;
        height: 2px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 2px;
        position: relative;
        overflow: hidden;
    }
    .progress-glow {
        position: absolute;
        top: 0; left: 0;
        height: 100%;
        width: 40%;
        background: linear-gradient(90deg, transparent, #d8b4fe, #ffffff, transparent);
        box-shadow: 0 0 10px #d8b4fe;
        animation: scan-bar 1.5s linear infinite;
    }
    @keyframes scan-bar {
        0% { transform: translateX(-100%); }
        100% { transform: translateX(300%); }
    }

    /* =========================================
       Terminal Logs
    ========================================= */
    .terminal-logs {
        text-align: center;
        min-height: 4rem; /* 预留高度防止跳动 */
    }
    .subtitle {
        margin: 0;
        color: #a78bfa;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        letter-spacing: 0.05em;
        font-size: clamp(0.9rem, 2vw, 1.2rem);
        line-height: 1.6;
        text-shadow: 0 0 8px rgba(139, 92, 246, 0.3);
    }

    /* 打字机光标 */
    .typing-cursor::after {
        content: '█'; 
        margin-left: 4px;
        color: #d8b4fe; 
        animation: cursorBlink 0.8s step-end infinite;
        text-shadow: 0 0 8px #d8b4fe;
    }
    @keyframes cursorBlink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
    }

    /* =========================================
       Arrow Wrapper
    ========================================= */
    #scroll-arrow.welcome-arrow {
        /* 初始状态：冻结动画并隐藏 */
        animation-play-state: paused;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
    }
    
    #scroll-arrow.welcome-arrow.visible {
        /* 触发状态：恢复动画播放 */
        animation-play-state: running;
        visibility: visible;
        pointer-events: auto;
    }

    /* Mobile Tweaks */
    @media (max-width: 400px){
        .content-wrapper { padding: 1.5rem; }
        .progress-track { width: 100%; }
    } 
</style>

<script >
    import { isWelcomeDismissed } from "../../../store";
    import { preloadAssets } from "../../../utils/assets";
    document.addEventListener('astro:page-load', () => {

        const overlay = document.getElementById('welcome-overlay');
        const arrowBtn = document.getElementById('scroll-arrow');
        const titleEl = document.getElementById('type-title');
        const subtitleEl = document.getElementById('type-subtitle');
        const loadingUi = document.getElementById('loading-ui'); 
        
        let isDismissed = false;
        let canDismiss = false;
        
        if (!overlay || !arrowBtn || !titleEl || !subtitleEl) return;

        /* =========================================================
           【静默检查核心逻辑】
           如果用户已经看过开场动画，直接隐藏 Overlay 并调用 preloadAssets()。
           由于我们在 assets.ts 中移除了拦截，这里每次页面跳转都会执行静默检查。
           如果有缺失的资源，它会在后台默默下载，完全不会打扰用户。
           ========================================================= */
        if (sessionStorage.getItem('introSeen') === 'true' || isWelcomeDismissed.get()===true) {
            overlay.style.display = 'none';
            document.body.style.overflow = '';
            isWelcomeDismissed.set(true);  
            
            // 静默触发资源检查与下载
            preloadAssets(); 
            return; // 提前返回，后续的打字机动画代码不会执行！
        }
        
        document.body.style.overflow = 'hidden';
        const dismissOverlay = () => {
            if (!canDismiss || isDismissed) return;
            isDismissed = true;

            sessionStorage.setItem('introSeen', 'true');
            overlay.classList.add('dismissed');
            isWelcomeDismissed.set(true);   

            setTimeout(() => {
                document.body.style.overflow = '';
                overlay.style.display = 'none'; 
            }, 1000); 
        };

        /*Type Writer*/
        function typeWriter(element: HTMLElement | null, text: string, baseSpeed: number, onComplete?: () => void) {
            if (!element) return;
            element.classList.add('typing-cursor'); 

            let i = 0;
            function type() {
                if(!element) return;
                if (i < text.length) {
                    const char = text.charAt(i); 
                    i++; 

                    if (char === '^') {
                        element.innerHTML += '<br>'; 
                        setTimeout(type, 1000);
                        return;
                    }
                    if(char==='~') {
                        element.innerHTML += '<br>'; 
                        setTimeout(type, 10);
                        return;
                    }

                    element.innerHTML += char;
                    const randomDelay = baseSpeed + Math.random() * 50; 
                    setTimeout(type, randomDelay);
                } else {
                    element.classList.remove('typing-cursor'); 
                    if (onComplete) onComplete(); 
                }
            }
            type();
        }
        
        setTimeout(() => {
            const titleText = titleEl.getAttribute('data-text') || 'HELLO! WELCOME';
            
            typeWriter(titleEl, titleText, 3, () => {
                
                typeWriter(subtitleEl, "> Loading core resources...", 3, () => {
                    if(subtitleEl) subtitleEl.classList.add('typing-cursor'); 
                    
                    // 首次访问：带动画的加载
                    preloadAssets().then(() => {
                        if(loadingUi) loadingUi.classList.add('fade-out');
                        
                        if(subtitleEl) subtitleEl.classList.remove('typing-cursor'); 
                        typeWriter(subtitleEl, "^> Loading Successfully.^> Scroll to access system.", 3, () => {
                            
                            if(subtitleEl) subtitleEl.classList.add('typing-cursor'); 
                            canDismiss = true;
                            if(arrowBtn) arrowBtn.classList.add('visible');
                        });
                    });
                });
            });
        }, 500);

        /*Event Listener*/
        arrowBtn.addEventListener('click', dismissOverlay);
        window.addEventListener('wheel', (e) => {
            if (e.deltaY > 0) dismissOverlay();
        });
        let touchStartY = 0;
        window.addEventListener('touchstart', (e) => {
            touchStartY = e.touches[0].clientY;
        });
        window.addEventListener('touchmove', (e) => {
            let currentY = e.touches[0].clientY;
            if (touchStartY - currentY > 50) dismissOverlay();
        });
    });
</script>