---
import { SITE_TITLE } from '../../../consts';
import HeaderLink from '../.././HeaderLink.astro';
import '../../../styles/global.css';
import '../../../styles/zIndex.css';
import YoutubeIcon from '../.././icons/YoutubeIcon.astro'
import XIcon from '../.././icons/XIcon.astro';
import GithubIcon from '../.././icons/GithubIcon.astro';
import MenuIcon from '../.././icons/MenuIcon.astro'
import { ANIMATION_TIMES } from '../../../config';
const headerShow=`${ANIMATION_TIMES.HEADER_SHOW}ms`;
const littleTime=`${ANIMATION_TIMES.NO_ZOOM_LITTLE_WAIT}ms`;
---

<header class="custom-header">
	<!--Logo and mobile menu-->
	<div class="header-top">
		<!--logo-->
		<h2 class="header-signature"><a href="/">{SITE_TITLE}</a></h2>

		<!--mobile menu -->
		<button id="mobile-menu-btn" class="mobile-menu-btn" aria-label="Toggle menu">
			<MenuIcon/>
		</button>
	</div>

	<!--Main menu and socialMedia -->
	<div id="mobile-menu-content" class="header-menu-content">
		<!--Main menu -->
		<nav id="header-nav" class="header-nav">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/devlog">Devlog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</nav>
		<!--Social media -->
		<div class="header-social">
			<!--1.Youtube channel -->
			<a href="https://www.youtube.com/@LittleDreamChime" class="social-youtube" target="_blank" rel="noopener noreferrer">
				<span class="sr-only">Go to my YouTube channel</span>
				<YoutubeIcon />
			</a>
			<!--2.X account -->
			<a href="https://x.com/I_Life_Soul" class="social-x" target="_blank">
				<XIcon/>
			</a>
			<!--3.github -->
			<a href="https://github.com/littledreamchime" class="social-github" target="_blank">
				<GithubIcon/>				
			</a>
		</div>
	</div>
</header>
<style define:vars={{headerShow,littleTime}}>
/* Header */
.custom-header{
    --header-dark-purple:rgba(48,10,60,0.9);
    --header-transparent:rgba(48,10,60,0);
    --header-menu-mobile:rgba(25, 5, 30, 0.85); 
    --text-active:linear-gradient(0deg, #a329bb, #e3c1e4,#ffffff);
    --text-hover:#d8b4fe;
    --text-hover-line:#a46ae2;
    --social-youtube-hover:#e93232;
    --social-X-hover:#a01cac;
    --social-github-hover:#a01cac;

    position:fixed;
    display:flex;
    justify-content:space-between;
    align-items:start;
    top:0;
    left:0;
    z-index: var(--z-header-footer);

    box-sizing: border-box; 
    width: 100%;
    padding: 1.5rem 2rem;

    background: linear-gradient(to bottom,var(--header-dark-purple),var(--header-transparent));
}

/*Logo and mobile menu */
.header-top{
    display:flex;
    align-items: center;
}

/*Mobile menu Btn*/
.mobile-menu-btn {
    display: none; 
    border: none;
    color: inherit;
    background: transparent;
    cursor: pointer;
    transition: filter 0.3s ease, transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
}
.mobile-menu-btn:hover {
    filter: drop-shadow(0 0 8px var(--text-hover-line));
    transform: scale(1.1);
}

.header-menu-content {
    display: flex;
    align-items: center;
    gap:0.2rem;
}

/*Logo*/
.header-signature{
    margin:0;
    font-family:var(--font-title);
    font-size:4rem;
    font-weight:normal;
    transform: translateY(-0.75rem);
}
.header-signature a{
    color:var(--text-primary);
    text-decoration: none;
    cursor: pointer;
    transition: filter 0.3s ease;
}
.header-signature a:hover {
    filter: drop-shadow(0 0 10px rgba(216, 180, 254, 0.4));
}

/*Nav menu (Desktop HUD Style)*/
.header-nav{
    display:flex;
    align-items: center;
    position:absolute;
    left:50%;
    gap: 0.5rem; 

    transform: translate(-50%,-150%);
    opacity: 0;
    pointer-events: none;
}
.header-nav.is-visible{
    opacity: 1;
    transform: translate(-50%,0);
    pointer-events: auto;
    transition: transform var(--headerShow) cubic-bezier(0.22, 1, 0.36, 1), opacity var(--headerShow) ease;
}

.header-nav a{
    position:relative;
    z-index: 1; /* 【修复关键】创建独立的层级上下文 */
    width: 5rem;
    padding: 0.5rem 0;
    border-radius: 6px;

    color:var(--text-primary);
    font-family: var(--font-nav);
    font-size:1.1rem;
    text-align: center;
    text-decoration: none;

    transition: all var(--littleTime) cubic-bezier(0.22, 1, 0.36, 1);
}

/* 【修复】使用 ::after 独立渲染背景，绝不干扰你的文字渐变！ */
.header-nav a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 6px;
    background: rgba(164, 106, 226, 0.1);
    opacity: 0;
    z-index: -1; /* 放在文字下方 */
    transition: opacity var(--littleTime) cubic-bezier(0.22, 1, 0.36, 1);
}

/* 悬浮时显示玻璃态背景 */
.header-nav a:hover {
    color: var(--text-hover);
}
.header-nav a:hover::after {
    opacity: 1;
}

/* 【保留】你的渐变文字逻辑 */
.header-nav a.active{
    background-image: var(--text-active);
    -webkit-background-clip: text;
    background-clip:text;
    color:transparent;
    text-decoration:none;
    filter: drop-shadow(0 0 8px rgba(216, 180, 254, 0.6));
}
.header-nav a.active:hover{
    background-image: var(--text-active);
    -webkit-background-clip: text;
    background-clip:text;
    color:transparent;
    text-decoration:none;
}

/* 底部发光能量射线 */
.header-nav a::before {
    position: absolute;
    bottom: 0; 
    left: 50%; 
    width: 0; 
    height: 2px; 
    border-radius: 2px;
    background: linear-gradient(90deg, transparent, var(--text-hover-line), transparent);
    box-shadow: 0 0 8px var(--text-hover-line);
    content: '';
    transform: translateX(-50%);
    transition: width var(--littleTime) cubic-bezier(0.22, 1, 0.36, 1); 
}
.header-nav a:hover::before,
.header-nav a.active::before {
    width: 80%; 
}

/*Social*/
.header-social{
    display:flex;
    gap:2rem;
    transform: translateY(0.45rem);
}
.header-social a {
  display:flex;
  color: var(--text-primary);
  transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
}
.header-social a:hover {
  transform: scale(1.2) translateY(-2px);
}
.header-social a.social-youtube:hover {
    color: var(--social-youtube-hover);
    filter: drop-shadow(0 0 10px var(--social-youtube-hover));
}
.header-social a.social-x:hover {
    color: var(--social-X-hover);
    filter: drop-shadow(0 0 10px var(--social-X-hover));
}
.header-social a.social-github:hover {
    color: var(--social-github-hover);
    filter: drop-shadow(0 0 10px var(--social-github-hover));
}

/* =========================================
   Mobile (Holographic Glass Menu)
========================================= */
@media (max-width: 768px) {
    .custom-header {
        flex-direction: column;
        align-items: stretch;
        padding: 1rem;
    	background: linear-gradient(to bottom,var(--header-dark-purple),var(--header-transparent));
    }
	
    .header-top {
        justify-content: space-between;
        width: 100%;
    }
	
    .mobile-menu-btn {
        display: block; 
        transform: translateY(-150%);
        opacity: 0;
        pointer-events: none;
        transition: transform var(--headerShow) cubic-bezier(0.22, 1, 0.36, 1), opacity var(--headerShow) ease;
    }
    .mobile-menu-btn.is-visible{
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
    }

    .header-menu-content {
        display: flex; 
        flex-direction: column;
		overflow:hidden;
        gap: 1rem;
		width: 100%;
		max-height: 0;
        padding-top:0;
		padding-bottom: 0;
        margin-top: 0;
        
		background-color: var(--header-menu-mobile);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        
        border: 1px solid transparent;
		border-radius: 12px; 
		box-sizing: border-box;
		opacity:0;

		transition: all var(--littleTime) cubic-bezier(0.4, 0, 0.2, 1);
    }
    .header-menu-content.show {
        display: flex;
        padding: 1.5rem; 
		max-height: 400px;
        margin-top: 1rem;
        
        border: 1px solid rgba(164, 106, 226, 0.3);
        box-shadow: 
            0 15px 35px rgba(0,0,0,0.6),
            inset 0 0 20px rgba(164, 106, 226, 0.1);
        opacity: 1;
    }

    .header-signature {
        transform:translateY(0.3rem);
    }
	
    /* 移动端 Nav menu */
    .header-nav {
        position:static;
        flex-direction: column;
        align-items: stretch; 
        gap: 0.5rem;
        width: 100%;
        transform:none !important;
        opacity: 1 !important;
        pointer-events: auto !important;
        transition: none;
    }
    
    .header-nav a {
        width: 100%;
        text-align: left;
        padding: 0.8rem 1.5rem;
    }
    
    /* 【修复】移动端激活态背景高亮，同样作用于 ::after */
    .header-nav a.active::after {
        background: linear-gradient(90deg, rgba(164, 106, 226, 0.15), transparent);
        opacity: 1;
        border-radius: 4px;
    }

    /* 移动端左侧发光指示条 */
    .header-nav a::before {
        top: 50%;
        left: 0;
        bottom: auto;
        width: 3px;
        height: 0;
        background: var(--text-hover-line);
        box-shadow: 0 0 8px var(--text-hover-line);
        transform: translateY(-50%);
        transition: height var(--littleTime) cubic-bezier(0.22, 1, 0.36, 1);
    }
	.header-nav a:hover::before,
    .header-nav a.active::before {
        width: 3px;
        height: 60%; 
    }
	
    /*Social*/
    .header-social {
        justify-content: center;
        padding-top: 1rem;
        padding-bottom: 0.5rem;
        width: 100%;
        border-top: 1px dashed rgba(164, 106, 226, 0.2); 
    }
}

.no-transition {
    transition: none !important;
}
</style>
<script>
    /* JS 逻辑完全保留 */
    import { isWelcomeDismissed ,currentView} from "../../../store";
    import {getViewMeta, handleAnimatedLinkClick} from "../../../utils/navigation";

    document.addEventListener('astro:page-load',()=>
    {
        /* Hambuger menu*/
        const btn = document.getElementById('mobile-menu-btn');
        const content = document.getElementById('mobile-menu-content');
        const header_nav= document.getElementById('header-nav');

        if (btn && content) {
            btn.onclick = () => {
                content.classList.toggle('show');
            };
        }


        if(isWelcomeDismissed.get())
        {
            if(header_nav) {
                header_nav.classList.add('no-transition');
                header_nav.classList.add('is-visible');
            }
            if(btn) {
                btn.classList.add('no-transition');
                btn.classList.add('is-visible');
            }
        }

        /* Redefine logo and nav menu click event */
        const navLinks=document.querySelectorAll('#header-nav a');
        const logoLink=document.querySelector('.header-signature a');
        const allLinks = [...navLinks, logoLink].filter(Boolean);


        allLinks.forEach(link => {
            if(!link) return;
            link.addEventListener('click', (e: Event) => {

                const content = document.getElementById('mobile-menu-content');
                if (content && content.classList.contains('show')) {
                    content.classList.remove('show');
                }
                handleAnimatedLinkClick(e);
            });
        });
    });

    isWelcomeDismissed.listen((dismissed: boolean)=>
    {
        if(dismissed){
            const header_nav= document.getElementById('header-nav');
            const mobileBtn = document.getElementById('mobile-menu-btn');
            if(header_nav) {
                header_nav.classList.remove('no-transition');
                header_nav.classList.add('is-visible');
            }
            if(mobileBtn) {
                mobileBtn.classList.remove('no-transition');
                mobileBtn.classList.add('is-visible');
            }
        }
    });

    /*Get current page */
    currentView.subscribe((view: string)=>{
        /*Change the nav menu*/
        const navLinks = document.querySelectorAll('#header-nav a');
        if (!navLinks.length) return;

        const viewToPath = {
            'Home': '/',
            'Blog': '/blog',
            'BlogBinder': '/blog',
            'BlogPaper': '/blog',
            'Devlog': '/devlog',
            'DevlogBinder': '/devlog',
            'DevlogPaper': '/devlog',
            'About': '/about'
        };
        const targetPath = viewToPath[view as keyof typeof viewToPath];

        navLinks.forEach(link => {
            let href = link.getAttribute('href');
            if(!href) return;
            let normalizedHref = href === '/' ? '/' : href.replace(/\/$/, '');

            if (normalizedHref === targetPath) {
                link.classList.add('active');
            } else {
                link.classList.remove('active');
            }
        });
    });
</script>