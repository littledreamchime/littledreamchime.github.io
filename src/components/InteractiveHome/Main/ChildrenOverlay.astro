---
interface Props {
    id: string;
}
const { id } = Astro.props;
---

<div id={id} class="children-overlay" transition:animate="none"></div>

<style>
    .children-overlay {
        position: fixed;
        top: 0; 
        left: 0;
        z-index: 275;

        width: 100%; 
        height: 100%;
        
        background: rgba(0, 0, 0, 0.6); 
        backdrop-filter: blur(4px);
        
        opacity: 0;
        pointer-events: none;
        
        transition: opacity 0.5s ease; 
    }
    
    .children-overlay.show {
        opacity: 1;
        pointer-events: auto;
    }
</style>