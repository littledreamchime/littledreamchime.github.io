---
import { ANIMATION_TIMES } from '../../../config';
import '../../../styles/zIndex.css';
const switchTime=`${ANIMATION_TIMES.CHILD_SWITCH}ms`;
interface Props {
    id: string;
    zIndex?: string | number; 
    width?: string;           
    height?: string;
    top?:string;
    left?:string;          
}
const { 
    id, 
    zIndex = 'var(--z-view-overlay)', 
    width = '100%', 
    height = '100%' ,
    top='0',
    left='0',
} = Astro.props;
---

<div id={id} class="children-overlay" transition:persist={id}} ></div>

<style define:vars={{ switchTime, zIndex, width, height,top,left }}>
    .children-overlay {
        position: fixed;
        top: var(--top); 
        left: var(--left);
        z-index: var(--zIndex);

        width: var(--width);  
        height: var(--height);
        
        background: rgba(0, 0, 0, 0.6); 
        backdrop-filter: blur(8px);
        
        opacity: 0;
        pointer-events: none;
        
        transition: opacity var(--switchTime) ease; 
    }
    
    .children-overlay.show {
        opacity: 1;
        pointer-events: auto;
    }
</style>