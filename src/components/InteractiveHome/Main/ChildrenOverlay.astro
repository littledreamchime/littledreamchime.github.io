---
import { ANIMATION_TIMES } from '../../../config';
import '../../../styles/zIndex.css';
const switchTime=`${ANIMATION_TIMES.CHILD_SWITCH}ms`;
interface Props {
    id: string;
}
const { id } = Astro.props;
---

<div id={id} class="children-overlay" transition:persist="children-overlay" ></div>

<style define:vars={{switchTime}}>
    .children-overlay {
        position: fixed;
        top: 0; 
        left: 0;
        z-index: var(--z-view-overlay);

        width: 100%; 
        height: 100%;
        
        background: rgba(0, 0, 0, 0.6); 
        backdrop-filter: blur(8px);
        
        opacity: 0;
        pointer-events: none;
        
        transition: opacity var(--switchTime) ease; 
    }
    
    .children-overlay.show {
        opacity: 1;
        pointer-events: auto;
    }
</style>