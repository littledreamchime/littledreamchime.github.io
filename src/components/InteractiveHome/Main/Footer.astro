---
import '../../../styles/global.css';
import '../../../styles/zIndex.css';
import { SITE_TITLE } from '../../../consts';
const today = new Date();
import { getCollection } from "astro:content";
const devlogs = (await getCollection('devlog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const blogs=(await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<footer class="customer-footer" >
	<div class="footer-content">
		<!--Footer left ( Menu and info ) -->
		<div class="footer-left">
			<!--Nav Menu -->
			<div class="footer-nav">
				<a href="#top">↑ Back to top</a>
				<a href="/about">About Me</a>
				<a href="mailto:littledreamchime@gmail.com">Mail Me ✉️</a>
			</div>
			<!--Web info -->
			<div class="footer-info">
				<p>・Email: littledreamchime@gmail.com</p>
				<p> ・Since 2026 | {blogs.length} Posts | {devlogs.length} Notes</p>
				<p>・Built with <a href="https://astro.build"target="_blank" rel="noopener noreferrer">Astro</a> | Hosted on github
				</p>
				<p> &copy; {today.getFullYear()} Bob Smith. No rights reserved.😋</p>
			</div>
		</div>
		<!--Footer right ( Logo )-->
		<div class="footer-right">
			<h2 class="footer-signature"><a href="/">{SITE_TITLE}</a></h2>
		</div>
	</div>
</footer>

<style>
	/*Main footer*/
	.customer-footer
	{
		--border: #64467c;
		--footer-text:#949494;
		--footer-link:#825491;
		--footer-link-hover:linear-gradient(0deg, #a329bb, #e3c1e4,#ffffff);

		padding:0.8rem 2rem;
		border-top: 1px dashed var(--border);
		z-index: var(--z-view-overlay);

		text-align: left;
		font-size:0.9rem;
	}
	/*Footer content*/
	.footer-content{
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
	}
	/*Footer left ( Menu and info )*/
	.footer-left{
		display: flex;
		flex-direction: column;
	}
	/*Footer right ( Logo )*/
	.footer-right{
		display: flex;
		align-items: center;

		padding-right: 0.5rem;
		padding-bottom: 0.5rem;
	}
	.footer-signature{ 
        font-family: var(--font-title), serif; 
        font-size: 3rem;
        font-weight: normal;
        opacity: 0.5;

        transition: opacity 0.3s ease;
	}
	.footer-signature:hover {
        opacity: 1;
    }
	/*Nav Menu*/
	.customer-footer a{
		display: inline-block;

		color:var(--footer-link);

		text-decoration: none;
		white-space:nowrap;

		transition: transform 0.2s ease; 
	}
	.customer-footer a:hover{
		background-image: var(--footer-link-hover);
		-webkit-background-clip: text;
		background-clip:text;
		color:transparent;

		text-decoration:none;

		transform: scale(1.2); 
	}
	.footer-nav{
		display: flex;
		gap: 2rem;
		flex-wrap: wrap;
	}
	.footer-nav a{
		text-decoration: none;
	}
	/*info*/
	.customer-footer p {
		margin: 0.2rem 0; 
	}
	.footer-info a{
		padding: 0.2rem 0.2rem; 
		margin: -0.2rem 0.1rem; 
		
		color:var(--footer-link);
	}
	.footer-info p{
		color:var(--footer-text);

		line-height: 1;overflow-wrap: break-word;
        word-break: break-all;
	}
	@media(max-width:480px)
	{
		.footer-content {
            flex-direction: column; 
            align-items: flex-start;
            gap: 0.4rem;
        }
		.footer-nav{
			flex-direction: column;
			gap:0.01rem;
		}
		.footer-right {
            padding-right: 0;
            padding-bottom: 0;
        }
	}
</style>

<script>
    import { handleAnimatedLinkClick } from "../../../utils/navigation";

    document.addEventListener('astro:page-load', () => {
        const footerLinks = document.querySelectorAll('.customer-footer a');
        
        footerLinks.forEach(link => {
            link.addEventListener('click', handleAnimatedLinkClick);
        });
    });
</script>