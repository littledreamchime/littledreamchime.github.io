---
import '../../../styles/global.css';
import '../../../styles/zIndex.css';
import { SITE_TITLE } from '../../../consts';
const today = new Date();
import { getCollection } from "astro:content";
const devlogs = (await getCollection('devlog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const blogs=(await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<footer class="customer-footer" >
	<div class="footer-content">
		<!--Footer left ( Menu and info ) -->
		<div class="footer-left">
			<!--Nav Menu -->
			<div class="footer-nav">
				<a href="#top">↑ BACK TO TOP</a>
				<a href="/about">ABOUT ME</a>
				<a href="mailto:littledreamchime@gmail.com">MAIL ME ✉️</a>
			</div>
			<!--Web info -->
			<div class="footer-info">
				<p><span class="sys-prefix">> Contant Me:</span> littledreamchime@gmail.com</p>
				<p><span class="sys-prefix">> This Blog:</span> Since 2026 | {blogs.length} Posts | {devlogs.length} Notes</p>
				<p><span class="sys-prefix">> The Core:</span> Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a> | Hosted on github</p>
				<p><span class="sys-prefix">></span> &copy; {today.getFullYear()} Bob Smith. No rights reserved.😋</p>
			</div>
		</div>
		<!--Footer right ( Logo )-->
		<div class="footer-right">
			<h2 class="footer-signature"><a href="/">{SITE_TITLE}</a></h2>
		</div>
	</div>
</footer>

<style>
	/* =========================================
       Main Footer (Solid Dark & Premium)
    ========================================= */
	.customer-footer {
		--border: #64467c;
		--footer-text: #8b7a9f; /* 调整为更柔和的紫灰色 */
		--footer-link: #a78bfa; /* 稍微提亮默认链接颜色 */
		--footer-link-hover: linear-gradient(0deg, #a329bb, #e3c1e4, #ffffff);

		position: relative;
		padding: 2.5rem 2rem 2rem;
		z-index: var(--z-view-overlay);
		
		/* 纯粹的深色背景，无毛玻璃，稳重扎实 */
		background-color: #05020a; 
		text-align: left;
		font-size: 0.9rem;
	}

	/* 顶部发光能量线 */
	.customer-footer::before {
		content: '';
		position: absolute;
		top: 0; left: 0; right: 0;
		height: 1px;
		background: linear-gradient(90deg, transparent, rgba(139, 92, 246, 0.5), transparent);
		box-shadow: 0 0 10px rgba(139, 92, 246, 0.3);
	}

	/* Footer content */
	.footer-content {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		max-width: 1200px;
		margin: 0 auto;
	}

	/* Footer left ( Menu and info ) */
	.footer-left {
		display: flex;
		flex-direction: column;
		gap: 1.5rem; /* 增加导航和信息之间的呼吸感 */
	}

	/* Footer right ( Logo ) */
	.footer-right {
		display: flex;
		align-items: center;
		padding-right: 0.5rem;
		padding-bottom: 0.5rem;
	}
	
	.footer-signature { 
        font-family: var(--font-title), serif; 
        font-size: 3.5rem;
        font-weight: normal;
        margin: 0;
        opacity: 0.3; /* 默认更暗，不抢视觉焦点 */
        transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.footer-signature a {
		color: #e9d5ff;
		text-decoration: none;
	}
	.footer-signature:hover {
        opacity: 0.8;
		filter: drop-shadow(0 0 15px rgba(139, 92, 246, 0.4)); /* 悬浮微微发光 */
    }

	/* =========================================
       Nav Menu
    ========================================= */
	.footer-nav {
		display: flex;
		gap: 2rem;
		flex-wrap: wrap;
	}
	.footer-nav a {
		display: inline-block;
		color: var(--footer-link);
		font-family: 'Inter', ui-monospace, SFMono-Regular, sans-serif;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-decoration: none;
		white-space: nowrap;
		transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1); 
	}
	
	/* 【保留】你的专属渐变，改用更高级的微动效和发光 */
	.footer-nav a:hover {
		background-image: var(--footer-link-hover);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		text-decoration: none;
		
		transform: translateY(-2px); /* 微微上浮代替夸张的放大 */
		filter: drop-shadow(0 0 8px rgba(216, 180, 254, 0.5)); /* 渐变发光 */
	}

	/* =========================================
       Terminal Info
    ========================================= */
	.footer-info {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
	.footer-info p {
		margin: 0; 
		color: var(--footer-text);
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.85rem;
		line-height: 1.4;
		overflow-wrap: break-word;
        word-break: break-all;
	}
	
	/* 极客前缀 */
	.sys-prefix {
		color: #6d28d9;
		font-weight: bold;
		margin-right: 0.2rem;
	}

	.footer-info a {
		color: var(--footer-link);
		text-decoration: none;
		border-bottom: 1px solid rgba(167, 139, 250, 0.3);
		transition: all 0.2s ease;
	}
	.footer-info a:hover {
		color: #d8b4fe;
		border-color: #d8b4fe;
		text-shadow: 0 0 8px rgba(167, 139, 250, 0.6);
	}

	/* =========================================
       Mobile
    ========================================= */
	@media (max-width: 768px) {
		.customer-footer {
			padding: 2rem 1.5rem;
		}
		.footer-content {
            flex-direction: column; 
            align-items: flex-start;
            gap: 2rem;
        }
		.footer-nav {
			flex-direction: column;
			gap: 1rem;
		}
		.footer-right {
            padding-right: 0;
            padding-bottom: 0;
        }
		.footer-signature {
			font-size: 2.5rem;
		}
	}
</style>

<script>
    import { handleAnimatedLinkClick } from "../../../utils/navigation";

    document.addEventListener('astro:page-load', () => {
        const footerLinks = document.querySelectorAll('.customer-footer a');
        
        footerLinks.forEach(link => {
            link.addEventListener('click', handleAnimatedLinkClick);
        });
    });
</script>