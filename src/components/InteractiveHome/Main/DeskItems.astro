---
import about_Image from '../../../assets/Images/about.png';
import bookshelf_Image from '../../../assets/Images/bookshelf.png';
import { getOptimizedImageUrl } from '../../../utils/assets';
import '../../../styles/zIndex.css';
import ComputerBackGround from './ComputerBackGround.astro';

const about_Image_url=await getOptimizedImageUrl(about_Image);
const bookshelf_Image_url=await getOptimizedImageUrl(bookshelf_Image);
---

<button class="desk-item bookshelf" data-target="Devlog" aria-label="Browse Devlogs">
</button>
<ComputerBackGround/>
<button class="desk-item paper" data-target="About" aria-label="About Me">
</button>

<div id="cursor-tooltip" class="cursor-tooltip"></div>

<style define:vars={{about_Image_url , bookshelf_Image_url}}>
    /* =========================================
       Desk Items Base
    ========================================= */
    .desk-item {
        position: absolute;
        outline: none;
        border: none;
        cursor: pointer;
        
        /* 丝滑的悬浮放大与发光过渡 */
        transition: 
            filter 0.4s cubic-bezier(0.22, 1, 0.36, 1), 
            transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .desk-item:hover {
        /* 悬浮时物品整体散发全息紫光 */
        filter: drop-shadow(0 0 15px rgba(139, 92, 246, 0.6));
    }
    
    /* =========================================
       Holographic Scanline Animation
    ========================================= */
    @keyframes holo-scan {
        0% { background-position: 0 -100%; }
        100% { background-position: 0 200%; }
    }

    .bookshelf::after, .paper::after {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        
        /* 科技感霓虹紫能量线 */
        background: linear-gradient(to bottom, 
            rgba(139, 92, 246, 0) 0%, 
            rgba(139, 92, 246, 0.6) 50%, 
            rgba(139, 92, 246, 0) 100%);
        background-size: 100% 50%;
        background-repeat: no-repeat;
        
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.4s ease;
        
        animation: holo-scan 2s linear infinite;
    }

    .bookshelf:hover::after, .paper:hover::after {
        opacity: 1;
    }

    /* =========================================
       BookShelf
    ========================================= */
    .bookshelf {
        top: 0%;        
        left: 0%;      
        z-index: var(--z-desk-items-bottom);     

        width: 25.8125%;      
        height: 80.30%;     

        background-color: transparent;
        background-image: var(--bookshelf_Image_url);
        background-size: contain; 
        background-repeat: no-repeat;
        background-position: center; 
    }
    /* 利用 Mask 让扫描线只在书架图像内部显示 */
    .bookshelf::after {
        -webkit-mask-image: var(--bookshelf_Image_url);
        -webkit-mask-size: contain;
        -webkit-mask-repeat: no-repeat;
        -webkit-mask-position: center;
        mask-image: var(--bookshelf_Image_url);
        mask-size: contain;
        mask-repeat: no-repeat;
        mask-position: center;
    }

    /* =========================================
       Paper (About)
    ========================================= */
    .paper {
        bottom: calc(100% - var(--paper-origin-y));
        right: calc(100% - var(--paper-origin-x));
        z-index: var(--z-desk-items-top);

        width: 10%;
        height: 18%;
        
        background-color: transparent;
        background-image: var(--about_Image_url);
        background-size: contain; 
        background-repeat: no-repeat;
        background-position: center; 
    }
    .paper::after {
        -webkit-mask-image: var(--about_Image_url);
        -webkit-mask-size: contain;
        -webkit-mask-repeat: no-repeat;
        -webkit-mask-position: center;
        mask-image: var(--about_Image_url);
        mask-size: contain;
        mask-repeat: no-repeat;
        mask-position: center;
    }
    
    /* =========================================
       HUD Cursor Tooltip (全息仪表盘提示框)
    ========================================= */
    .cursor-tooltip {
        position: fixed;
        top: 0;
        left: 0;
        z-index: var(--z-tooltip);
        pointer-events: none;

        /* 玻璃态背景与科技边框 */
        padding: 0.5rem 1rem;
        background: rgba(13, 9, 20, 0.85);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(139, 92, 246, 0.4);
        border-left: 3px solid #8b5cf6; /* 左侧高亮指示条 */
        border-radius: 4px;
        
        /* 悬浮光晕 */
        box-shadow: 
            0 4px 15px rgba(0, 0, 0, 0.6), 
            0 0 15px rgba(139, 92, 246, 0.2);

        /* 极客字体排版 */
        color: #f3e8ff;
        font-family: 'Inter', ui-monospace, SFMono-Regular, monospace;
        font-size: clamp(0.8rem, 2cqi, 1.1rem);
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        white-space: nowrap;
        text-shadow: 0 0 8px rgba(139, 92, 246, 0.5);
        
        opacity: 0;
        /* 偏移 15px 防止遮挡鼠标指针 */
        transform: translate(calc(var(--x, 0px) + 15px), calc(var(--y, 0px) + 15px));
        transition: opacity 0.2s ease;
    }


    .cursor-tooltip.is-visible {
        opacity: 1;
    }
</style>

<script>
    /* JS 逻辑完全保留 */
    import { navigateWithAnimation } from "../../../utils/navigation";
    import { currentView, isAnimating } from "../../../store";

    document.addEventListener('astro:page-load',()=>{
        const tooltip=document.getElementById('cursor-tooltip');
        const isNotHome=(currentView.get()!=='Home');
        /* add computer*/
        
        const computerWrapper = document.querySelector('.screen-body');
        if (computerWrapper) {
            computerWrapper.classList.add('desk-item');
            computerWrapper.setAttribute('data-target', 'Blog');
            computerWrapper.setAttribute('aria-label', 'Browse Blogs');
            const targetCursor=currentView.get().startsWith('Blog')? 'default' : 'pointer';
            (computerWrapper as HTMLElement).style.cursor = targetCursor; 
        }
        
        const items=document.querySelectorAll('.desk-item');

        /*click event*/
        const handleClick=(e: MouseEvent)=>{
            const target=e.target as HTMLElement;
            const btn=target.closest('.desk-item');
            if(!btn) return;
            const targetView=btn.getAttribute('data-target');
            if(!targetView)return;
            if(tooltip) tooltip.classList.remove('is-visible');
            const href = `/${targetView.toLowerCase()}`;

            navigateWithAnimation(href);
        };

        /*cursor tooltip */
        const handleMouseEnter=(e:MouseEvent)=>{
            if(isAnimating.get() || !tooltip || isNotHome) return;
            const target=e.currentTarget as HTMLElement;
            const text=target.getAttribute('aria-label');

            if(text){
                tooltip.textContent=text;
                tooltip.style.transition = 'none';
                tooltip.style.setProperty('--x', `${e.clientX}px`);
                tooltip.style.setProperty('--y', `${e.clientY}px`);
                
                void tooltip.offsetWidth; 
                
                tooltip.style.transition = ''; 
                tooltip.classList.add('is-visible');
            }
        };

        const handleMouseMove=(e:MouseEvent)=>{
            if(!tooltip || !tooltip.classList.contains('is-visible') ||isNotHome) return;
            tooltip.style.setProperty('--x', `${e.clientX}px`);
            tooltip.style.setProperty('--y', `${e.clientY}px`);
        }

        const handleMouseLeave = () => {
            if (tooltip&& !isNotHome) {
                tooltip.classList.remove('is-visible');
            }
        };

        items.forEach(item=>{
            item.addEventListener('click', handleClick as EventListener);
            item.addEventListener('mouseenter', handleMouseEnter as EventListener);
            item.addEventListener('mousemove', handleMouseMove as EventListener);
            item.addEventListener('mouseleave', handleMouseLeave as EventListener);
        });
    });
</script>