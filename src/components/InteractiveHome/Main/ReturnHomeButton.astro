<button id="return-home-btn" class="return-btn" aria-label="Return to home" transition:persist="">
    ←Back
</button>

<style>
    
    /*Return btn*/
    .return-btn {
        position: absolute;
        top: clamp(7.5rem, 10vh, 10rem);
        left: clamp(1rem, 4vw, 4rem);
        z-index: var(--z-return-btn); 
        
        padding: clamp(0.3rem, 1.5vh, 1.5rem) clamp(0.6rem, 3vw, 1.5rem);
        
        background: rgba(164, 80, 189, 0.232);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(216, 180, 254, 0.25);
        border-radius: 2rem;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
        
        font-family: var(--font-nav, sans-serif);
        font-size: clamp(0.6rem, 2vw, 1.5rem);
        color: #f3e8ff;
        cursor: pointer;
        
        opacity: 0;
        pointer-events: none;
        transform: translateY(-10px);
        transition: opacity 0.5s ease, transform 0.5s ease, background 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }
    
    .return-btn.is-visible {
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0);
    }
    @media (hover: hover) {
        .return-btn:hover {
            background: rgba(141, 37, 172, 0.237);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
            border-color: rgba(216, 180, 254, 0.5);
        }
    }
    .no-transition {
        transition: none !important;
    }
</style>

<script>
    import { currentView } from "../../../store";
import { getViewMeta, navigateWithAnimation } from "../../../utils/navigation";

    let unsubscribe:()=> void=()=>{}; 

    document.addEventListener('astro:page-load', () => {
        const returnBtn = document.getElementById('return-home-btn');
        if(!returnBtn) return;

        const expectedView=currentView.get();
        const isNotHome=(expectedView!=='Home');
        if(isNotHome){
            returnBtn.classList.add('no-transition');
        }

        
        unsubscribe = currentView.subscribe((view: string) => {
            returnBtn.classList.remove('is-visible');
            const meta=getViewMeta(view);
            if (meta.showReturnBtn) {
                returnBtn.classList.add('is-visible');
            } 
        });
        
        if(isNotHome){
            returnBtn.offsetHeight;
            returnBtn.classList.remove('no-transition');
        }
        
        /* Return button */
        returnBtn.onclick = () => {
            navigateWithAnimation('/','Home');
        };
    });
</script>