---
import '../../../styles/zIndex.css';
const { class: className, ...rest } = Astro.props;
---

<!-- 将 ...rest 展开到根元素上，这样 transition:persist 才能真正挂载到 HTML 上 -->
<div class:list={["particles-wrapper", className]} {...rest}>
    <canvas id="room-particles" class="particles-canvas"></canvas>
</div>

<style>
    .particles-wrapper {
        position: absolute;
        inset: 0; 
        pointer-events: none; 
        z-index: var(--z-particle); 
        overflow: hidden;
    }
    
    .particles-canvas {
        width: 100%;
        height: 100%;
        display: block;
    }
</style>

<script>
    document.addEventListener('astro:page-load', () => {
        const canvas = document.getElementById('room-particles') as HTMLCanvasElement;
        if (!canvas) return;

        // 【核心修复 1】如果 Canvas 已经被持久化，直接跳过初始化！
        // 这样旧的动画循环会继续在后台无缝运行，不会发生闪烁和重置
        if (canvas.dataset.initialized === 'true') {
            return;
        }
        canvas.dataset.initialized = 'true';

        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        let particlesArray: any[] = [];
        let animationFrameId: number;

        const setCanvasSize = () => {
            if (!document.body.contains(canvas)) return;
            canvas.width = canvas.parentElement?.clientWidth || window.innerWidth;
            canvas.height = canvas.parentElement?.clientHeight || window.innerHeight;
        };

        window.addEventListener('resize', setCanvasSize);
        setCanvasSize();

        class Particle {
            x: number; y: number; size: number;
            speedX: number; speedY: number;
            opacity: number; baseOpacity: number;
            angle: number; angleSpeed: number;

            constructor() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.size = Math.random() * 1.5 + 0.5; 
                this.speedX = Math.random() * 0.4 - 0.2; 
                this.speedY = Math.random() * -0.4 - 0.1; 
                this.baseOpacity = Math.random() * 0.4 + 0.1; 
                this.opacity = this.baseOpacity;
                this.angle = Math.random() * Math.PI * 2; 
                this.angleSpeed = Math.random() * 0.015 + 0.005; 
            }

            update() {
                this.y += this.speedY;
                this.x += this.speedX + Math.sin(this.angle) * 0.3; 
                this.angle += this.angleSpeed;
                this.opacity = this.baseOpacity + Math.sin(this.angle * 2) * 0.15;

                if (this.y < 0 - this.size) {
                    this.y = canvas.height + this.size;
                    this.x = Math.random() * canvas.width;
                }
                if (this.x < 0 - this.size) this.x = canvas.width + this.size;
                if (this.x > canvas.width + this.size) this.x = 0 - this.size;
            }

            draw() {
                if (!ctx) return;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fillStyle = `rgba(216, 180, 254, ${Math.max(0, this.opacity)})`;
                ctx.shadowBlur = 6;
                ctx.shadowColor = 'rgba(167, 139, 250, 0.8)'; 
                ctx.fill();
            }
        }

        const init = () => {
            particlesArray = [];
            const numberOfParticles = Math.floor((canvas.width * canvas.height) / 12000); 
            for (let i = 0; i < numberOfParticles; i++) {
                particlesArray.push(new Particle());
            }
        };

        const animate = () => {
            // 【核心修复 2】智能垃圾回收：
            // 不再使用 before-swap 暴力杀进程。
            // 而是每帧检测 Canvas 是否还在 DOM 中。
            // 如果你切换到了一个没有 <Particle /> 的页面，它会被移出 DOM，此时自动停止动画并清理内存。
            if (!document.body.contains(canvas)) {
                cancelAnimationFrame(animationFrameId);
                window.removeEventListener('resize', setCanvasSize);
                return;
            }

            ctx.clearRect(0, 0, canvas.width, canvas.height);
            for (let i = 0; i < particlesArray.length; i++) {
                particlesArray[i].update();
                particlesArray[i].draw();
            }
            animationFrameId = requestAnimationFrame(animate);
        };

        init();
        animate();
    });
</script>