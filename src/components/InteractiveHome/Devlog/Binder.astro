---
import ChildrenOverlay from "../Main/ChildrenOverlay.astro";
import '../../../styles/zIndex.css';
import { ANIMATION_TIMES } from "../../../config";
const binderShowTime=`${ANIMATION_TIMES.BINDER_SHOW}ms`;
// src/components/Binder.astro
const { title, entries,folderSlug } = Astro.props;
---

<ChildrenOverlay id="binder-overlay"  />

<div id="binder-ui" class="binder-ui"  transition:persist="Binder" >
    <!--Header -->
    <div class="binder-header">
        <button id="binder-back-btn" class="back-btn" data-target={`/devlog/${folderSlug}`}>←</button>
        <h2>📂 {title}</h2>
    </div>
    
    <!--Content -->
    <div class="binder-content">
        <ul id="entry-list" class="entry-list">
            {entries.map((entry: any) => (
                <li>
                    <a href={`/devlog/${entry.id}`} class="entry-item">
                        <span class="entry-title-wrapper">
                            <span class="entry-title" data-title={entry.data.title}> {entry.data.title}</span>
                        </span>
                        <span class="entry-date">{entry.data.pubDate.toLocaleDateString()}</span>
                    </a>
                </li>
            ))}
            {entries.length === 0 && <p class="empty-text">Ops! It's empty...</p>}
        </ul>
    </div>
</div>

<style define:vars={{binderShowTime}}>

    /*Binder*/
    .binder-ui {
        position: absolute;
        top: 6.5rem;
        left: 10%;
        display: flex;
        flex-direction: column;
        z-index: var(--z-view-children-binder);

        width: 80%;
        height: calc(95% - 6.5rem);

        border-radius: clamp(0.5rem, 1cqi, 1rem);
        box-shadow: 0 1rem 2rem rgba(65, 27, 74, 0.768);
        border-left: clamp(4px, 1.5cqi, 8px) solid #8c439e;
        padding: clamp(1rem, 3vw, 2rem);

        background-color: #120E1A;
        opacity: 0;
        
        transform: translateY(20%) scale(0.9);
        transition: all var(--binderShowTime) cubic-bezier(0.22, 1, 0.36, 1);
    }
    .binder-ui.open {
        transform: translateY(0) scale(1);
        opacity: 1;
    }
    /*Content*/
    .binder-content {
        flex: 1;
        display: flex;
        flex-direction: column;

        min-height: 0; 
        border-radius: 1rem;

        background: #241627;
    }
    /*Header*/
    .binder-header {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: center;

        border-bottom: 2px dashed #452852;
        padding-bottom: 0.75rem;
        margin-bottom: 0.75rem; 
    }
    .binder-header h2 {
        margin: 0;
        color: #8f8f8f;
        font-size: clamp(1.25rem, 2vw + 0.5rem, 1.75rem);
        
        transition: all var(--binderShowTime) ease;
    }
    /*Back button*/
    .back-btn { 
        display: inline-flex;
        align-items: center;
        justify-content: center;

        border: none; 
        border-radius: 0.5rem; 
        padding: 0.5rem 1rem; 

        background:  #592d6d; 
        color: #c7c7c7; 

        font-weight: bold; 
        font-size: clamp(0.875rem, 1vw + 0.5rem, 1rem);

        cursor: pointer; 
        transition: background 0.2s,transform  0.2s;
    }
    .back-btn:hover {
        background: #602b6f;
        transform: scale(1.05);
    }
    /*List*/
    .entry-list { 
        list-style: none; 
        padding: 0; 
        margin: 0; 
        overflow-y: auto; 
        flex: 1; 

        border-radius: 0.5rem;

        background: #241627;

        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE/Edge */
    }
    .entry-list::-webkit-scrollbar {
        display: none; /* Chrome/Safari */
    }
    /*List items*/
    .entry-item { 
        display: flex; 
        justify-content: space-between; 
        align-items: center; 

        padding: 1rem 1.25rem; 
        border-bottom: 1px solid #3a283c; 
        background: #241627;

        text-decoration: none; 
        color: #ffffff; 

        transition: background 0.2s, padding-left 0.2s;
    }
    .entry-item.active {
        padding-left: 1.75rem; 
        background: #341f38; 
        color: #d979f9;
        border-left: 3px solid #d979f9;
    }
    .entry-item:hover {
        padding-left: 1.75rem; 

        background: #341f38; 
        color: #bf60ea;
    }

    /*items-title*/
    .entry-title-wrapper {
        flex: 1; 
        min-width: 0; 
        overflow: hidden; 
        white-space: nowrap; 
        margin-right: 1rem; 
        container-type: inline-size; 
    }
    
    .entry-title.is-overflowing {
        padding-right: 1rem;
    }

    .entry-title.is-overflowing::after {
        content: attr(data-title);
        position: absolute;
        left: 100%;
        top: 0;
        white-space: nowrap;
    }

    .entry-item:hover .entry-title.is-overflowing,
    .entry-item.active .entry-title.is-overflowing {
        animation: seamless-marquee 4s linear infinite;
    }

    @keyframes seamless-marquee {
        0% { transform: translateX(0); }
        100% { transform: translateX(-100%); }
    }

    .entry-title {
        display: inline-block;
        position: relative;

        padding-right: 1.75rem;
        width: max-content;

        font-weight: bold;
        font-size: clamp(1rem, 1.5vw + 0.5rem, 1.25rem); 
    }
    .entry-date { 
        font-size: 0.875rem; 
        color:  #8f8f8f; 
        white-space: nowrap;

        transition: font-size 0.3s, color 0.3s;
    }
    .entry-item.active .entry-date {
        font-size: 1rem;
        color: #d979f9;
    }
    .entry-item:hover .entry-date{
        font-size: 1rem;
        color: rgb(137, 59, 166);
    }
    
    /*Empty*/
    .empty-text{
        text-align: center;
        padding: 2rem 1rem;
        
        color:#6e6e6e

        font-size: 1rem;
    }

@media (max-width: 768px) {
    .binder-ui {
        width: 95%;
        left: 2.5%;
    }
}

@media (min-width:1080px){
    .binder-header h2{
        position: absolute;
        left: 50%; 
        transform: translateX(-50%); 
        color:#ffffff;
    }
    .back-btn { 
        transform: translateY(-50%);
    }
    .back-btn:hover {
        background: #602b6f;
        transform:translateY(-50%) scale(1.05) ;
    }
}
/* minimized*/
@media(min-width:768px){
    .binder-ui.minimized {
        left: 5%;
        padding: 1rem;

        width: 30%; 
        height: calc(60% - 6.5rem);
    }
    .binder-ui.minimized .binder-header h2 {
        position: static;
        transform: none;
        font-size: 1.2rem;
        color: #8f8f8f;
    }
    .binder-ui.minimized .back-btn { 
        transform: none; 
    }
}

</style>

<script>
    import { addLeaveHook, currentView } from '../../../store';
    import { handleAnimatedLinkClick, navigateWithAnimation } from '../../../utils/navigation';
    import { ANIMATION_TIMES } from '../../../config';

    
    let savedScrollTop=0;
    document.addEventListener('astro:before-swap', () => {
        const scrollContainer = document.getElementById('entry-list');
        if (scrollContainer) savedScrollTop = scrollContainer.scrollTop;
    });
    document.addEventListener('astro:after-swap', () => {
        const scrollContainer = document.getElementById('entry-list');
        if (scrollContainer) scrollContainer.scrollTop = savedScrollTop;
    });

    
    document.addEventListener('astro:page-load', () => {
        const binder = document.getElementById('binder-ui');
        const overlay = document.getElementById('binder-overlay');
        const backBtn = document.getElementById('binder-back-btn');
        const currentPath = decodeURIComponent(window.location.pathname);
        const currentPostName = currentPath.replace(/\/$/, '').split('/').pop();
        if(!binder || !overlay) return;
        /*Overflow*/
        const checkOverflow = () => {
            const wrappers = document.querySelectorAll('.entry-title-wrapper');
            wrappers.forEach(wrapper => {
                const title = wrapper.querySelector('.entry-title');
                if (!title) return;
                
                title.classList.remove('is-overflowing');
                
                if (title.scrollWidth > wrapper.clientWidth - 20) {
                    title.classList.add('is-overflowing');
                }
            });
        };
        window.addEventListener('resize', checkOverflow);

        /*Start*/
        requestAnimationFrame(() => {
            requestAnimationFrame(() => {
            checkOverflow();
            if (!binder.classList.contains('open')) binder.classList.add('open');
            if (!overlay.classList.contains('show')) overlay.classList.add('show');
            });

            if(currentView.get() === "DevlogPaper"){
                binder.classList.add('minimized');
            }
            else{
                binder.classList.remove('minimized');
            }
        });
        
        /*Back button*/
        const goBack = () =>{
            if(currentView.get()!=='DevlogBinder'){
                const targetUrl = backBtn?.getAttribute('data-target') || '/devlog';
                navigateWithAnimation(targetUrl, 'DevlogBinder');
            }else{
                navigateWithAnimation('/devlog', 'Devlog');
            }
        };
        overlay.addEventListener('click', goBack);
        backBtn?.addEventListener('click', goBack);

        /*Deal with links*/
        const entryLinks = document.querySelectorAll('.entry-item');
        entryLinks.forEach(link => {
            link.addEventListener('click', (e) => {
                handleAnimatedLinkClick(e);
            });
            
            const rawHref = link.getAttribute('href');
            if(rawHref){
                const href = decodeURIComponent(rawHref);
                const linkPostName = href.replace(/\/$/, '').split('/').pop();
                if (currentPostName === linkPostName) {
                    link.classList.add('active');
                } else {
                    link.classList.remove('active');
                }
            }
        });

        /*Leave*/
        addLeaveHook((targetView) => {
            if(binder.classList.contains('minimized') && targetView === 'DevlogBinder'){
                return new Promise((resolve) => {
                    binder.classList.remove('minimized');      
                    setTimeout(()=>{
                        resolve();
                    }, ANIMATION_TIMES.BINDER_SHOW); 
                });    
            }
            if(!binder.classList.contains('minimized') && targetView === 'DevlogPaper'){
                return new Promise((resolve) => {
                binder.classList.add('minimized');
                setTimeout(()=>{
                    resolve();
                }, ANIMATION_TIMES.BINDER_SHOW); 
            });
            }

            if (targetView !== 'DevlogBinder' && targetView !== 'DevlogPaper') {
                return new Promise((resolve) => {
                    binder.classList.remove('open');
                    overlay.classList.remove('show');
                    setTimeout(()=>{
                        overlay.style.display = 'none';
                        binder.style.display = 'none';
                        resolve();
                    }, ANIMATION_TIMES.BINDER_SHOW); 
                });
            }
            return Promise.resolve();
        });
    });
</script>