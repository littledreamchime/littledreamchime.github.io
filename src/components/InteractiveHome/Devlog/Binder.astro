---
import ChildrenOverlay from "../Main/ChildrenOverlay.astro";
import '../../../styles/zIndex.css';
import { ANIMATION_TIMES } from "../../../config";
const binderShowTime=`${ANIMATION_TIMES.BINDER_SHOW}ms`;
// src/components/Binder.astro
const { title, entries } = Astro.props;
---

<ChildrenOverlay id="binder-overlay" />

<div id="binder-ui" class="binder-ui"  transition:persist="Binder" transition:animate="none">
    <!--Header -->
    <div class="binder-header">
        <button id="binder-back-btn" class="back-btn">← Back</button>
        <h2>📂 {title}</h2>
    </div>
    
    <!--Content -->
    <div class="binder-content">
        <ul class="entry-list">
            {entries.map((entry: any) => (
                <li>
                    <a href={`/devlog/${entry.id}`} class="entry-item">
                        <span class="entry-title">📄 {entry.data.title}</span>
                        <span class="entry-date">{entry.data.pubDate.toLocaleDateString()}</span>
                    </a>
                </li>
            ))}
            {entries.length === 0 && <p class="empty-text">Ops! It's empty...</p>}
        </ul>
    </div>
</div>

<style define:vars={{binderShowTime}}>

    /*Binder*/
    .binder-ui {
        position: absolute;
        top: 5%;
        left: 20%;
        display: flex;
        flex-direction: column;
        z-index: var(--z-view-children-binder);

        width: 60%;
        height: 90%;

        border-radius: 1cqi;
        box-shadow: 0 2cqi 5cqi rgba(65, 27, 74, 0.768);
        border-left: 1.5cqi solid #8c439e;
        padding: 3cqi;

        background-color: #120E1A;
        opacity: 0;
        
        transform: translateY(20%) scale(0.9);
        transition: all var(--binderShowTime) cubic-bezier(0.22, 1, 0.36, 1);
    }
    .binder-ui.open {
        transform: translateY(0) scale(1);
        opacity: 1;
    }
    /*Content*/
    .binder-content {
        flex: 1;
        display: flex;
        flex-direction: column;

        min-height: 0; 
        border-radius: 1cqi;

        background: #241627;
    }
    /*Header*/
    .binder-header {
        display: flex;
        justify-content: space-between;
        border-bottom: 2px dashed #452852;
        padding-bottom: 1cqi;
        margin-bottom: 1cqi; 

    }
    .binder-header h2 {
        margin: 0;
        color: #8f8f8f;
        font-size: 3cqi;
    }
    /*Back button*/
    .back-btn { 
        display: inline-block;
        margin-bottom: 2cqi;

        border: none; 
        border-radius: 0.5cqi; 
        padding: 0.75cqi 1.5cqi; 

        background:  #592d6d; 
        color: #c7c7c7; 

        font-weight: bold; 
        font-size: 1cqi;

        cursor: pointer; 
        transition: background 0.2s,transform  0.2s;
    }
    .back-btn:hover {
        background: #602b6f;
        transform: scale(125%);
    }
    /*List*/
    .entry-list { 
        list-style: none; 
        padding: 0; 
        margin: 0; 
        overflow-y: auto; 
        flex: 1; 

        border-radius: 1cqi;

        background: #241627;

        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE/Edge */
    }
    .entry-list::-webkit-scrollbar {
        display: none; /* Chrome/Safari */
    }
    /*List items*/
    .entry-item { 
        display: flex; 
        justify-content: space-between; 
        align-items: center; 

        padding: 1.5cqi; 
        border-bottom: 1px solid #3a283c; 
        background: #241627;

        text-decoration: none; 
        color: #ffffff; 

        transition: background 0.2s, padding-left 0.2s;
    }
    .entry-item:hover {
        padding-left: 3cqi; 

        background: #341f38; 
        color: #bf60ea;
    }
    .entry-title {
        font-weight: bold;
        font-size: 1.5cqi; 
    }
    .entry-date { 
        font-size: 1.2cqi; 
        color:  #8f8f8f; 

        transition: font-size 0.3s, color 0.3s;
    }
    .entry-item:hover .entry-date{
        font-size:1.5cqi;
        color: rgb(137, 59, 166);
    }
    
    /*Empty*/
    .empty-text{
        margin: 1px;    
        padding: 10px 20px;

        color:#6e6e6e
    }

@media (max-width: 768px) {
}
</style>

<script>
    import { addLeaveHook } from '../../../store';
    import { navigateWithAnimation } from '../../../utils/navigation';
    import { ANIMATION_TIMES } from '../../../config';
    
    document.addEventListener('astro:page-load', () => {
        const binder = document.getElementById('binder-ui');
        const overlay = document.getElementById('binder-overlay');
        const backBtn = document.getElementById('binder-back-btn');
        if(!binder || !overlay) return;

        requestAnimationFrame(() => {
            requestAnimationFrame(() => {
            if (!binder.classList.contains('open')) binder.classList.add('open');
            if (!overlay.classList.contains('show'))    overlay.classList.add('show');
            });
        });

        const goBack = () => navigateWithAnimation('/devlog', 'Devlog');
        overlay.addEventListener('click', goBack);
        backBtn?.addEventListener('click', goBack);

        const entryLinks = document.querySelectorAll('.entry-item');
        entryLinks.forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault(); 
                const href = link.getAttribute('href');
                if (href) {
                    navigateWithAnimation(href, 'DevlogPaper');
                }
            });
        });


        addLeaveHook((targetView) => {
            if (targetView === 'DevlogBinder' || targetView === 'DevlogPaper') {
                return Promise.resolve();
            }
            return new Promise((resolve) => {
                binder.classList.remove('open');
                overlay.classList.remove('show');
                setTimeout(()=>{
                    overlay.style.display = 'none';
                    binder.style.display = 'none';
                    resolve();
                }, ANIMATION_TIMES.BINDER_SHOW); 
            });
        });
    });
</script>