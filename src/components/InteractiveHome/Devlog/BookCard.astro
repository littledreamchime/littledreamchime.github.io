---
import { Image } from "astro:assets";

const { book, folderSlug } = Astro.props;
---

<a href={`/devlog/${folderSlug}`} class="book-card entry-item">
    <div class="book-volume">
        <div class="book-cover-front">
            {book.data.heroImage ? (
                <Image 
                    src={book.data.heroImage} 
                    alt={book.data.title} 
                    class="cover-image" 
                />
            ) : (
                <div class="cover-image placeholder"></div>
            )}
            <div class="book-text-info">
                <h3>{book.data.title}</h3>
                <time>{book.data.pubDate.toLocaleDateString()}</time>
            </div>
        </div>
    </div>
</a>

<style>
    /* =========================================
       3D Book Card (Desktop)
    ========================================= */
    .book-card {
        flex-shrink: 0;
        /* 【修改】放大基础尺寸，利用 aspect-ratio 锁定你喜欢的宽高比 */
        width: 21cqi; 
        aspect-ratio: 2 / 3;
        height: auto;
        /* 【新增】防止在超宽屏下书本过大导致垂直溢出，保留上下呼吸感 */
        max-height: 65vh; 
        
        perspective: 1200px;
        margin-bottom: 0.5cqi; 
        cursor: pointer;
        text-decoration: none;
    }

    .book-volume {
        position: relative;
        width: 100%;
        height: 100%;
        transform-style: preserve-3d;
        transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.5s ease;
        
        background: linear-gradient(135deg, #2d1b4e 0%, #150e28 100%);
        border-radius: 2px 10px 10px 2px;
        border: 1px solid rgba(139, 92, 246, 0.3);
        border-left: 8px solid #5b21b6; 
        
        box-shadow: 
            inset 4px 0 10px rgba(255,255,255,0.05),
            5px 5px 15px rgba(0,0,0,0.6);
            
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .book-card:hover .book-volume {
        transform: translateZ(30px) translateY(-2cqi) rotateY(-12deg);
        box-shadow: 
            15px 20px 25px rgba(0,0,0,0.8),
            0 0 25px rgba(139, 92, 246, 0.5);
        border-left-color: #8b5cf6; 
    }

    .book-cover-front {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    /* 【修改】强制 1:1 比例，且不裁切图片 */
    .cover-image {
        width: 100%;
        aspect-ratio: 1 / 1;
        height: auto;
        object-fit: contain; /* 保证图片完整显示不裁切 */
        border-bottom: 1px solid rgba(139, 92, 246, 0.4);
        background-color: #1a1025;
        padding: 1cqi; /* 增加一点内边距，让 contain 的图片更有画框感 */
        box-sizing: border-box;
    }

    .cover-image.placeholder {
        background: repeating-linear-gradient(
            45deg,
            #1a1025,
            #1a1025 10px,
            #2d1b4e 10px,
            #2d1b4e 20px
        );
    }

    .book-text-info {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        padding: 1cqi;
        background: linear-gradient(to bottom, transparent, rgba(76, 29, 149, 0.2));
    }

    .book-text-info h3 {
        font-size: 2cqi; /* 稍微调大以适配新尺寸 */
        color: #f3e8ff;
        margin: 0 0 0.5cqi 0;
        text-shadow: 0 0 8px rgba(139, 92, 246, 0.6);
        font-weight: 600;
        line-height: 1.2;
    }

    .book-text-info time {
        font-size: 1.2cqi;
        color: #a78bfa;
        font-family: monospace;
    }

    /* =========================================
       Mobile Mode Overrides
    ========================================= */
    @media (max-width: 768px) {
        .book-card {
            width: 100%;
            height: auto;
            max-height: none;
            aspect-ratio: auto;
            perspective: none;
            margin-bottom: 0;
        }
        .book-volume {
            flex-direction: row;
            transform: none !important;
            border-radius: 8px;
            border-left: 4px solid #6d28d9;
            padding: 1rem;
            gap: 1.5rem;
            align-items: center;
        }
        .book-card:hover .book-volume {
            transform: translateX(10px) !important; 
            box-shadow: 0 0 15px rgba(139, 92, 246, 0.4);
        }
        .book-cover-front {
            flex-direction: row;
            width: 100%;
            align-items: center;
            gap: 1.5rem;
        }
        .cover-image {
            width: 4.5rem;
            height: 4.5rem;
            padding: 0.2rem;
            border-radius: 4px;
            border: 1px solid rgba(139, 92, 246, 0.4);
        }
        .book-text-info {
            align-items: flex-start;
            text-align: left;
            padding: 0;
            background: none;
        }
        .book-text-info h3 {
            font-size: clamp(1.1rem, 4vw, 1.5rem);
        }
        .book-text-info time {
            font-size: clamp(0.8rem, 3vw, 1rem);
        }
    }
</style>