---
import {render } from 'astro:content';
import '../../../styles/zIndex.css';
import { ANIMATION_TIMES } from '../../../config';
const pageShowTime=`${ANIMATION_TIMES.PAGE_SHOW}ms`;

const {post,folderSlug}=Astro.props;
const { Content } = await render(post);
---

<div id="paper-ui" class="paper-ui">
	<div id="paper-header" class="paper-header">
		<button id="paper-back-btn" class="back-btn" data-target={`/devlog/${folderSlug}`}>
			←
		</button>
		<div class="meta">
			<h1>{post.data.title}</h1>
			{post.data.description && <p class="description">{post.data.description}</p>}
			<time>{post.data.pubDate.toLocaleDateString()}</time>
		</div>
	</div>

	<div id="paper-content" class="paper-content">
		<Content />
	</div>
</div>


<style define:vars={{pageShowTime}}>
    /*Main*/
    .paper-ui {
        position: absolute;
        top: 6.5rem;
        left: 50%;
		overflow: hidden;
        display: flex;
        z-index: var(--z-view-children-page);
        flex-direction: column;
        
        width: 90%;
        max-width: 900px;
        height: calc(95% - 6.5rem);
        
        opacity: 0;
        background-color: #211525;
        border-radius: 0.5rem;
        box-shadow: 0 1.5rem 3rem -0.75rem rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(222, 204, 230, 0.1);
        
        transform: translate(-50%, 20%) scale(0.95);
        transition: all var(--pageShowTime) cubic-bezier(0.22, 1, 0.36, 1);
    }
    .paper-ui.open {
        transform: translate(-50%, 0) scale(1);
        opacity: 1;
    }

    /*Header*/
    .paper-header {
        display:flex;
        flex: 0 0 auto;
        flex-direction: column;
        align-items: flex-start;

        padding: 1.5rem clamp(1.5rem, 5vw, 4rem) 0.5rem;
        border-bottom: 3px solid #3c2a45;
        
        max-height: 500px;
        
        opacity: 1;
        transition: all var(--pageShowTime) cubic-bezier(0.4, 0, 0.2, 1);
    }
    .paper-header:hover{
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.5rem 1rem;
        margin-bottom: 1rem;

        border: none;
        border-radius: 0.5rem;

        background:  #592d6d; 
        color: #c7c7c7; 
        font-weight: bold;
        font-size: clamp(0.875rem, 1vw + 0.5rem, 1rem);

        cursor: pointer;
        transition: background 0.2s,transform  0.2s;
    }
    .back-btn:hover { 
        background: #602b6f;
        transform: scale(1.05);
     }
    .meta {
        display: flex;
        flex-direction: column;
        width: 100%;
        gap: 0.5rem;
    }
    .meta h1 {
        margin:0;
        
        font-size: clamp(1.5rem, 4vw + 1rem, 2.5rem);
        color: #f3e8ff;
        font-family: serif; 
        line-height: 1.3;
    }
    .meta .description {
        margin: 0;
        margin-left: ;

        font-size: clamp(1rem, 2vw + 0.5rem, 1.15rem);
        color: #8d8490;
        font-family: sans-serif;
        line-height: 1.4;
    }

    .meta time {
        margin: 0;

        color: #8b7a9f;
        font-size: 0.875rem;
    }

    /*Content*/
    .paper-content {
        overflow-y: auto;
        flex: 1;
        scroll-behavior: smooth;

        padding: 2rem clamp(1.5rem, 5vw, 4rem) 4rem;

        color: #c8bccc;
        font-family: sans-serif;
        line-height: 1.8;
        font-size: 1rem;
        
        scrollbar-width: none;
        -ms-overflow-style: none;
    }
    .paper-content::-webkit-scrollbar { display: none; }

    .paper-content :global(h2) { margin-top: 2rem; color: #d979f9; border-bottom: 1px solid #352a45; padding-bottom: 0.5rem; }
    .paper-content :global(p) { margin-bottom: 1.5rem; }
    .paper-content :global(a) { color: #9f72f4; text-decoration: none; border-bottom: 1px dashed #9972f4; transition: color 0.2s; }
    .paper-content :global(a:hover) { color: #b946ef; border-color: #d946ef; }
    .paper-content :global(code) { background: #2a2136; color: #a472f4; padding: 0.2rem 0.4rem; border-radius: 4px; font-size: 0.9em; }
    .paper-content :global(pre) { background: #110d17; color: #e2d8ee; padding: 1rem; border-radius: 8px; overflow-x: auto; border: 1px solid #2a2136; }

    
@media (max-width: 768px) {
    
    .paper-ui {
        width: 100%;
        height: calc(100% - 6.5rem);
        
    }
    .paper-content {
        font-size: 0.75rem; 
    }
    
    .paper-header.header-hidden{
        max-height: 0;
        padding-top: 0;
        padding-bottom: 0;
        margin-bottom: 0;
        border-bottom-width: 0;
        opacity: 0;
        overflow: hidden;
    }
}


@media (min-width: 769px) {
    .paper-ui {
        left: 37.5%;
        width: 60%;
        max-width: 100000px;
        height: calc(95% - 6.5rem);
        
        transform: translate(0, 20%) scale(0.95);
    }
    .paper-ui.open {
        transform: translate(0, 0) scale(1);
    }
    
    .paper-ui .back-btn {
        display: none;
    }
}
</style>

<script>
    import { addLeaveHook } from '../../../store';
    import { navigateWithAnimation } from '../../../utils/navigation';
    import { ANIMATION_TIMES } from '../../../config';

    document.addEventListener('astro:page-load', () => {
        const paper = document.getElementById('paper-ui');
        const backBtn = document.getElementById('paper-back-btn');
        const content = document.getElementById('paper-content');
        const header = document.getElementById('paper-header');
        if(!paper) return;

        requestAnimationFrame(() => {
            requestAnimationFrame(() => {
                if (!paper.classList.contains('open')) paper.classList.add('open');
            });
        });

        if (content && header) {
            let lastScrollY = content.scrollTop;
            let ticking = false; 

            content.addEventListener('scroll', () => {
                if (!ticking) {
                    window.requestAnimationFrame(() => {
                        const currentScrollY = content.scrollTop;
                        const maxScroll = content.scrollHeight - content.clientHeight;

                        if (currentScrollY <= 0 || currentScrollY >= maxScroll - 10) {
                            lastScrollY = currentScrollY;
                            ticking = false;
                            return; 
                        }

                        if (currentScrollY > lastScrollY && currentScrollY > 50) {
                            header.classList.add('header-hidden');
                        } 
                        else if (currentScrollY < lastScrollY) {
                            header.classList.remove('header-hidden');
                        }
                        
                        lastScrollY = currentScrollY;
                        ticking = false;
                    });
                    ticking = true;
                }
            });

            /*prevent md auto scroll*/
            content.addEventListener('click', (e) => {
                if(!e.target) return;
                const link =(e.target as HTMLElement).closest('a[href^="#"]');
                if (!link) return;
                const targethref=link.getAttribute('href');
                if(!targethref) return;
                const targetId = targethref.substring(1);
                const targetElement = document.getElementById(targetId);

                if (targetElement) {
                    e.preventDefault();

                    const containerRect = content.getBoundingClientRect();
                    const targetRect = targetElement.getBoundingClientRect();
                    const scrollPos = content.scrollTop + (targetRect.top - containerRect.top) - 20;

                    content.scrollTo({ top: scrollPos, behavior: 'smooth' });
                }
            });
        }


        const goBack = () => {
            const targetUrl = backBtn?.getAttribute('data-target') || '/devlog';
            navigateWithAnimation(targetUrl);
        };

        backBtn?.addEventListener('click', goBack);

        addLeaveHook(() => {
            return new Promise((resolve) => {
                paper.classList.remove('open');
                
                setTimeout(() => {
                    paper.style.display = 'none';
                    resolve();
                }, ANIMATION_TIMES.PAGE_SHOW); 
            });
        });
    });
</script>