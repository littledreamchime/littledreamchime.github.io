---
import {render } from 'astro:content';
import ChildrenOverlay from '../Main/ChildrenOverlay.astro';
import '../../../styles/zIndex.css';
import { ANIMATION_TIMES } from '../../../config';
const pageShowTime=`${ANIMATION_TIMES.PAGE_SHOW}ms`;

const {post,folderSlug}=Astro.props;
const { Content } = await render(post);
---


<ChildrenOverlay id="paper-overlay" />

<div id="paper-ui" class="paper-ui" transition:animate="none">
	<div class="paper-header">
		<button id="paper-back-btn" class="back-btn" data-target={`/devlog/${folderSlug}`}>
			← Back
		</button>
		<div class="meta">
			<h1>{post.data.title}</h1>
			<time>{post.data.pubDate.toLocaleDateString()}</time>
		</div>
	</div>

	<div class="paper-content">
		<Content />
	</div>
</div>


<style define:vars={{pageShowTime}}>
    /*Main*/
    .paper-ui {
        position: absolute;
        top: 10%;
        left: 50%;
		overflow: hidden;
        display: flex;
        z-index: var(--z-view-children-page);
        flex-direction: column;
        
        width: 80%;
        height: 80vb;
        
        opacity: 0;
        background-color: #211525;
        border-radius: 4px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8), 0 0 0 0.1cqi rgba(222, 204, 230, 0.2);
        
        transform: translate(-50%, 20%) scale(0.95);
        transition: all var(--pageShowTime) cubic-bezier(0.22, 1, 0.36, 1);
    }
    .paper-ui.open {
        transform: translate(-50%, 0) scale(1);
        opacity: 1;
    }

    /*Header*/
    .paper-header {
        display:flex;
        flex: 0 0 auto;
        flex-direction: column;
        align-items: flex-start;
        container-type: inline-size; 

        padding: 0cqi 0cqi 0cqi 0cqi;
        border-bottom: 3px solid #3c2a45;
        
        transition: height var(--pageShowTime);
    }
    .paper-header:hover{
    }

    .back-btn {
        margin-left: 1.5cqi;
        margin-top: 1cqi;
        display: inline-block;
        padding: 0.675cqi 1.25cqi;

        border: none;
        border-radius: 0.75cqi;

        background:  #592d6d; 
        color: #c7c7c7; 
        font-weight: bold;
        margin-bottom: 1cqi;
        font-size: 0.865cqi;

        cursor: pointer;
        transition: background 0.2s,transform  0.2s;
    }
    .back-btn:hover { 
        background: #602b6f;
        transform: scale(115%);
     }
    .meta {
        display: flex;
        flex-direction: column;
        width: 100%;
    }
    .meta h1 {
        margin-left: 4cqi;   
        margin-top: 0.5cqi;
        
        font-size: 2.5cqi;
        color: #f3e8ff;
        font-family: serif; 
    }
    .meta time {
        margin-left:4cqi;   

        color: #8b7a9f;
        font-size: 1.125cqi;
    }

    /*Content*/
    .paper-content {
        padding: 2rem 4rem 4rem 4rem;
        overflow-y: auto;
        flex: 1;
        color: #c8bccc;
        font-family: sans-serif;
        line-height: 1.8;
        font-size: 1.1rem;
        
        scrollbar-width: none;
        -ms-overflow-style: none;
    }
    .paper-content::-webkit-scrollbar { display: none; }

    .paper-content :global(h2) { margin-top: 2rem; color: #d979f9; border-bottom: 1px solid #352a45; padding-bottom: 0.5rem; }
    .paper-content :global(p) { margin-bottom: 1.5rem; }
    .paper-content :global(a) { color: #9f72f4; text-decoration: none; border-bottom: 1px dashed #9972f4; transition: color 0.2s; }
    .paper-content :global(a:hover) { color: #b946ef; border-color: #d946ef; }
    .paper-content :global(code) { background: #2a2136; color: #a472f4; padding: 0.2rem 0.4rem; border-radius: 4px; font-size: 0.9em; }
    .paper-content :global(pre) { background: #110d17; color: #e2d8ee; padding: 1rem; border-radius: 8px; overflow-x: auto; border: 1px solid #2a2136; }

    
@media (max-width: 768px) {
    
    .paper-ui {
        width: 100%;
    }
}
</style>

<script>
    import { addLeaveHook } from '../../../store';
    import { navigateWithAnimation } from '../../../utils/navigation';
    import { ANIMATION_TIMES } from '../../../config';

    document.addEventListener('astro:page-load', () => {
        const paper = document.getElementById('paper-ui');
        const overlay = document.getElementById('paper-overlay');
        const backBtn = document.getElementById('paper-back-btn');
        if(!paper || !overlay) return;

        requestAnimationFrame(() => {
            requestAnimationFrame(() => {
                if (!paper.classList.contains('open')) paper.classList.add('open');
                if (!overlay.classList.contains('show')) overlay.classList.add('show');
            });
        });

        const goBack = () => {
            const targetUrl = backBtn?.getAttribute('data-target') || '/devlog';
            navigateWithAnimation(targetUrl, 'DevlogBinder');
        };

        overlay.addEventListener('click', goBack);
        backBtn?.addEventListener('click', goBack);

        addLeaveHook(() => {
            return new Promise((resolve) => {
                paper.classList.remove('open');
                overlay.classList.remove('show');
                
                setTimeout(() => {
                    overlay.style.display = 'none';
                    paper.style.display = 'none';
                    resolve();
                }, ANIMATION_TIMES.PAGE_SHOW); 
            });
        });
    });
</script>