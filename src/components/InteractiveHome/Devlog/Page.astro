---
import {render } from 'astro:content';
import '../../../styles/zIndex.css';
import { ANIMATION_TIMES } from '../../../config';
import Giscus from '../Main/Giscus.astro';
const pageShowTime=`${ANIMATION_TIMES.PAGE_SHOW}ms`;

const {post,folderSlug}=Astro.props;
const { Content } = await render(post);
---

<div id="paper-ui" class="paper-ui">
    <!-- 新增：常驻的最小化导航栏 (默认隐藏) -->
    <div id="sticky-header" class="sticky-header">
        <button class="back-btn sticky-back-btn" data-target={`/devlog/${folderSlug}`}>
            ←
        </button>
        <h1 class="sticky-title">{post.data.title}</h1>
    </div>

	<div id="paper-content" class="paper-content">
        <!-- 原本的 Header 移入滚动区域，使其能自然随页面滚走 -->
        <div id="paper-header" class="paper-header">
            <button id="paper-back-btn" class="back-btn" data-target={`/devlog/${folderSlug}`}>
                ←
            </button>
            <div class="meta">
                <h1>{post.data.title}</h1>
                {post.data.description && <p class="description">{post.data.description}</p>}
                <time>{post.data.pubDate.toLocaleDateString()}</time>
            </div>
        </div>

        <!-- 内容区域包裹层，用于替代原本 paper-content 的 padding -->
        <div class="content-wrapper">
		    <Content />
            <Giscus />
        </div>
	</div>
</div>


<style define:vars={{pageShowTime}}>
    /* =========================================
       Main Container (Holographic Glass Panel)
    ========================================= */
    .paper-ui {
        position: absolute;
        top: 6.5rem;
        left: 50%;
		overflow: hidden;
        display: flex;
        z-index: var(--z-view-children-page);
        flex-direction: column;
        
        width: 90%;
        max-width: 900px;
        height: calc(95% - 6.5rem);
        
        background-color: rgba(13, 9, 20, 0.85);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(139, 92, 246, 0.2);
        border-radius: 12px;
        box-shadow: 
            0 1.5rem 3rem -0.75rem rgba(0, 0, 0, 0.9), 
            inset 0 0 30px rgba(139, 92, 246, 0.05);
        
        opacity: 0;
        will-change: transform, opacity;
        transform: translate(-50%, 20%) scale(0.95) translateZ(0);
        transition: all var(--pageShowTime) cubic-bezier(0.22, 1, 0.36, 1);
    }
    .paper-ui.open {
        transform: translate(-50%, 0) scale(1);
        opacity: 1;
    }

    /* =========================================
       Sticky Header (最小化的常驻导航栏)
    ========================================= */
    .sticky-header {
        position: absolute;
        top: 0; left: 0; right: 0;
        display: flex;
        align-items: center;
        padding: 0.75rem clamp(1.5rem, 5vw, 4rem);
        
        /* 稍微深一点的背景，区分正文 */
        background: rgba(13, 9, 20, 0.95);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom: 1px solid rgba(139, 92, 246, 0.4);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
        z-index: 10;
        
        /* 默认向上隐藏 */
        transform: translateY(-100%);
        opacity: 0;
        pointer-events: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .sticky-header.visible {
        transform: translateY(0);
        opacity: 1;
        pointer-events: auto;
    }
    .sticky-header .back-btn {
        margin-bottom: 0;
        margin-right: 1rem;
        padding: 0.4rem 0.8rem;
    }
    .sticky-title {
        font-size: 1.1rem;
        color: #f3e8ff;
        font-family: 'Inter', system-ui, sans-serif; 
        font-weight: 700;
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        text-shadow: 0 0 10px rgba(139, 92, 246, 0.5);
    }

    /* =========================================
       Original Header (Tech Dashboard Style)
    ========================================= */
    .paper-header {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: flex-start;

        padding: 2rem clamp(1.5rem, 5vw, 4rem) 1.5rem;
        background: linear-gradient(to bottom, rgba(76, 29, 149, 0.15), transparent);
    }
    
    .paper-header::after {
        content: '';
        position: absolute;
        bottom: 0; left: 5%; right: 5%;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(139, 92, 246, 0.6), transparent);
        box-shadow: 0 0 10px rgba(139, 92, 246, 0.4);
    }

    /* Back Button */
    .back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.5rem 1rem;
        margin-bottom: 1.5rem;

        border-radius: 0.5rem;
        font-weight: bold;
        font-size: clamp(0.875rem, 1vw + 0.5rem, 1rem);
        cursor: pointer;

        background: rgba(139, 92, 246, 0.1); 
        border: 1px solid rgba(139, 92, 246, 0.3);
        color: #a78bfa; 
        backdrop-filter: blur(4px);
        
        transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .back-btn:hover { 
        background: rgba(139, 92, 246, 0.3);
        border-color: #8b5cf6;
        color: #fff;
        box-shadow: 0 0 15px rgba(139, 92, 246, 0.4);
        transform: scale(1.05);
    }

    /* Meta Info */
    .meta {
        display: flex;
        flex-direction: column;
        width: 100%;
        gap: 0.75rem;
    }
    .meta h1 {
        margin: 0;
        font-size: clamp(1.5rem, 4vw + 1rem, 2.5rem);
        color: #f3e8ff;
        text-shadow: 0 0 15px rgba(139, 92, 246, 0.5);
        font-family: 'Inter', system-ui, sans-serif; 
        font-weight: 700;
        line-height: 1.2;
        letter-spacing: 0.02em;
    }
    .meta .description {
        margin: 0;
        font-size: clamp(1rem, 2vw + 0.5rem, 1.15rem);
        color: #cbd5e1;
        font-family: 'Inter', system-ui, sans-serif;
        line-height: 1.5;
        border-left: 3px solid rgba(139, 92, 246, 0.5);
        padding-left: 1rem;
    }
    .meta time {
        margin: 0;
        color: #a78bfa;
        font-size: 0.875rem;
        font-family: monospace;
        letter-spacing: 0.05em;
    }

    /* =========================================
       Content (Premium Markdown Reader)
    ========================================= */
    .paper-content {
        overflow-y: auto;
        flex: 1;
        scroll-behavior: smooth;
        padding: 0; /* padding 移交给了内部元素 */
        scrollbar-width: none;
        -ms-overflow-style: none;
    }
    .paper-content::-webkit-scrollbar { display: none; }

    .content-wrapper {
        padding: 2rem clamp(1.5rem, 5vw, 4rem) 4rem;
        color: #cbd5e1;
        font-family: 'Inter', system-ui, sans-serif;
        line-height: 1.8;
        font-size: 1.05rem;
        letter-spacing: 0.01em;
    }

    /* Markdown Elements */
    .content-wrapper :global(h2) { 
        margin-top: 3rem; 
        margin-bottom: 1.5rem;
        color: #f3e8ff; 
        border-bottom: 1px solid rgba(139, 92, 246, 0.2); 
        border-left: 4px solid #8b5cf6;
        padding-left: 1rem;
        padding-bottom: 0.5rem; 
        text-shadow: 0 0 10px rgba(139, 92, 246, 0.3);
    }
    .content-wrapper :global(h3) {
        color: #e9d5ff;
        margin-top: 2rem;
    }
    .content-wrapper :global(p) { 
        margin-bottom: 1.5rem; 
    }
    .content-wrapper :global(a) { 
        color: #a78bfa; 
        text-decoration: none; 
        border-bottom: 1px solid rgba(167, 139, 250, 0.4); 
        transition: all 0.2s; 
    }
    .content-wrapper :global(a:hover) { 
        color: #d8b4fe; 
        border-color: #d8b4fe; 
        text-shadow: 0 0 8px rgba(167, 139, 250, 0.6);
    }
    .content-wrapper :global(code) { 
        background: rgba(139, 92, 246, 0.15); 
        color: #d8b4fe; 
        padding: 0.2rem 0.4rem; 
        border-radius: 4px; 
        border: 1px solid rgba(139, 92, 246, 0.3);
        font-family: monospace;
        font-size: 0.9em; 
    }
    .content-wrapper :global(pre) { 
        background: rgba(0, 0, 0, 0.5); 
        color: #e2d8ee; 
        padding: 1.25rem; 
        border-radius: 8px; 
        overflow-x: auto; 
        border: 1px solid rgba(139, 92, 246, 0.2); 
        box-shadow: inset 0 0 15px rgba(0,0,0,0.8);
        margin-bottom: 1.5rem;
    }
    .content-wrapper :global(blockquote) {
        border-left: 4px solid #8b5cf6;
        background: linear-gradient(90deg, rgba(139, 92, 246, 0.1), transparent);
        padding: 1rem 1.5rem;
        margin: 1.5rem 0;
        border-radius: 0 8px 8px 0;
        color: #a78bfa;
        font-style: italic;
    }

    /* =========================================
       Media Queries
    ========================================= */
    @media (max-width: 768px) {
        .paper-ui {
            width: 100%;
            height: calc(100% - 6.5rem);
        }
        .content-wrapper {
            font-size: 0.95rem;
        }
    }

    @media (min-width: 769px) {
        .paper-ui {
            left: 37.5%;
            width: 60%;
            max-width: 100000px;
            height: calc(95% - 6.5rem);
            transform: translate(0, 20%) scale(0.95);
        }
        .paper-ui.open {
            transform: translate(0, 0) scale(1);
        }
        /* 桌面端隐藏返回按钮 */
        .paper-ui .back-btn {
            display: none;
        }
    }
</style>

<script>
    import { addLeaveHook } from '../../../store';
    import { navigateWithAnimation } from '../../../utils/navigation';
    import { ANIMATION_TIMES } from '../../../config';

    document.addEventListener('astro:page-load', () => {
        const paper = document.getElementById('paper-ui');
        const content = document.getElementById('paper-content');
        const header = document.getElementById('paper-header');
        const stickyHeader = document.getElementById('sticky-header');
        
        if(!paper) return;

        requestAnimationFrame(() => {
            requestAnimationFrame(() => {
                if (!paper.classList.contains('open')) paper.classList.add('open');
            });
        });

        if (content && header && stickyHeader) {
            let ticking = false; 

            content.addEventListener('scroll', () => {
                if (!ticking) {
                    window.requestAnimationFrame(() => {
                        const currentScrollY = content.scrollTop;
                        const headerHeight = header.offsetHeight;

                        // 核心逻辑：当向下滚动距离超过原Header的高度时，显示吸顶的Sticky Header
                        // 减去20px是为了让过渡更平滑一点，在原Header快要完全消失时就出现
                        if (currentScrollY > headerHeight - 20) {
                            stickyHeader.classList.add('visible');
                        } else {
                            stickyHeader.classList.remove('visible');
                        }
                        
                        ticking = false;
                    });
                    ticking = true;
                }
            });

            /* prevent md auto scroll */
            content.addEventListener('click', (e) => {
                if(!e.target) return;
                const link =(e.target as HTMLElement).closest('a[href^="#"]');
                if (!link) return;
                const targethref=link.getAttribute('href');
                if(!targethref) return;
                const targetId = targethref.substring(1);
                const targetElement = document.getElementById(targetId);

                if (targetElement) {
                    e.preventDefault();

                    const containerRect = content.getBoundingClientRect();
                    const targetRect = targetElement.getBoundingClientRect();
                    // 减去 sticky-header 的高度 (大约 60px) 防止锚点跳转后标题被遮挡
                    const scrollPos = content.scrollTop + (targetRect.top - containerRect.top) - 60;

                    content.scrollTo({ top: scrollPos, behavior: 'smooth' });
                }
            });
        }

        const goBack = (e:any) => {
            // 获取当前点击的按钮的 target
            const targetUrl = (e.currentTarget as HTMLElement).getAttribute('data-target') || '/devlog';
            navigateWithAnimation(targetUrl);
        };

        // 绑定所有返回按钮 (包括原Header和Sticky Header里的)
        const backBtns = document.querySelectorAll('.back-btn');
        backBtns.forEach(btn => btn.addEventListener('click', goBack));

        addLeaveHook(() => {
            return new Promise((resolve) => {
                paper.classList.remove('open');
                
                setTimeout(() => {
                    paper.style.display = 'none';
                    resolve();
                }, ANIMATION_TIMES.PAGE_SHOW); 
            });
        });
    });
</script>