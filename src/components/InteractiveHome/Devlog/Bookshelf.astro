---
import { getCollection } from "astro:content";
import { ANIMATION_TIMES } from "../../../config";
import { Image } from "astro:assets";
import '../../../styles/zIndex.css';

const devlogSlideIn=`${ANIMATION_TIMES.DEVLOG_SLIDEIN}ms`

const devlogs = (await getCollection('devlog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const books = devlogs.filter(post => post.id.endsWith('/config'));
books.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const getFolderSlug = (id: string) => id.split('/')[0];
---

<div id="bookshelf-ui" class="bookshelf-ui" transition:persist="bookshelf-ui">
    <!--Tmp Title -->
    <div class="placeholder-content">
        <h2>📚 Devlog Bookshelf</h2>
        <p>Markdown list: {books.length} books, { devlogs.length - books.length} devlogs</p>
    </div>
    
    <!--Scroll Container -->
    <div class="bookshelf-scroll-container" id="bookshelf-scroll">
        <div class="bookshelf-track">
            {
                books.map((book) => {
                    const folderSlug = getFolderSlug(book.id);
                    return (
                        /* Items */
                        <a href={`/devlog/${folderSlug}`} class="book-card">
                            <div class="book-content">
                                <div class="book-cover">
                                    {book.data.heroImage ? (
                                        <Image 
                                            src={book.data.heroImage} 
                                            alt={book.data.title} 
                                            class="cover-image" 
                                        />
                                    ) : (
                                        <div class="cover-image placeholder"></div>
                                    )}
                                </div>
                                <h3>{book.data.title}</h3>
                                <time>{book.data.pubDate.toLocaleDateString()}</time>
                            </div>
                        </a>
                    )
                })
            }
        </div>
    </div>
</div>


<style define:vars={{devlogSlideIn}}>
    /* =========================================
    Root
    ========================================= */
    .bookshelf-ui {
        position: absolute;
        top: 0;
        right: 0;
        display: flex;
        flex-direction: column;
        z-index: var(--z-view-main);

        width: 100%;
        height: 100%;
        border-left: 2px solid #666;

        background-color: #4a4a4a; 

        transform: translateX(100%);
        
        transition: transform var(--devlogSlideIn) cubic-bezier(0.22, 1, 0.36, 1);
    }
    .bookshelf-ui.slide-in {
        transform: translateX(0);
    }

    /* =========================================
    Tmp title
    ========================================= */
    .placeholder-content {
        padding: 3cqi;

        color: white;
        font-family: sans-serif;

        flex-shrink: 0;
    }
    .placeholder-content h2 {
        margin-bottom: 2cqi;

        font-size: 5cqi; 
    }
    .placeholder-content p {
        font-size: 2cqi;
    }
    /* =========================================
    Scroll View
    ========================================= */
    .bookshelf-scroll-container {
        flex: 1;
        overflow-x: auto;
        overflow-y: auto;
        
        width: 100%;
        min-height: 0; 
        
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE/Edge */
    }
    .bookshelf-scroll-container::-webkit-scrollbar {
        display: none; /* Chrome/Safari */
    }
    /* Scroll view track*/
    .bookshelf-track {
        display: flex;
        align-items: flex-end; 
        

        min-height: 100%;
        width: max-content;
        padding: 1cqi 5cqi; 
        gap: 3cqi;
    }

    /* =========================================
    Book card Root 
    ========================================= */
    .book-card {
        flex-shrink: 0;
        display: flex;
        justify-content: center;
        align-items: center;

        width: 20cqi;
        height: auto;
        min-height: 24cqi;
        padding: 2cqi;
        border: 1px solid #555;
        border-radius: 12px;
        
        margin: 0; 

        color: #aaa;
        background-color: #2d2d2d;
        
        font-size: 2cqi;
        font-weight: bold;
        text-decoration: none;
        
        transition: transform 0.3s ease, background-color 0.3s ease;
        cursor: pointer;
    }
    .book-card:hover {
        background-color: #3d3d3d;
        color: white;

        transform: translateY(-2cqi);
    }
    /*book card parent*/
    .book-content{
        display: flex;
        flex-direction: column;
        align-items: center;

        width: 100%;

        text-align: center;
    }
    /* Image */
    .book-cover {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 1.5cqi;
        
        width: 12cqi;
        aspect-ratio: 1 / 1;
    }
    .cover-image {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }
    .cover-image.placeholder {
        opacity: 0;
    }
    /* Title */
    .book-content h3 {
        font-size: 2.5cqi;
        margin: 0 0 1cqi 0;
        color: inherit;
    }
    /* Time */
    .book-content time {
        font-size: 1.5cqi;
        opacity: 0.7;
    }
</style>

<script>
    import { ANIMATION_TIMES } from "../../../config";
    import { addLeaveHook } from "../../../store";
    import { handleAnimatedLinkClick } from "../../../utils/navigation";
    
    
    let unsubscribe: () => void = () => {};

    /*Reset Scroll*/
    let savedScrollLeft=0;
    let needReset = false;
    document.addEventListener('astro:before-swap', () => {
        const scrollContainer = document.getElementById('bookshelf-scroll');
        if (needReset) {
            savedScrollLeft = 0;
            needReset = false;
        } else if (scrollContainer) {
            savedScrollLeft = scrollContainer.scrollLeft;
        }
    });
    document.addEventListener('astro:after-swap', () => {
        const scrollContainer = document.getElementById('bookshelf-scroll');
        if (scrollContainer) scrollContainer.scrollLeft = savedScrollLeft;
    });

    /*Main*/
    document.addEventListener('astro:page-load', () => {
        const bookshelf = document.getElementById('bookshelf-ui');
        const scrollContainer = document.getElementById('bookshelf-scroll');
        if(!bookshelf || !scrollContainer)return;

        //Enter
         if (!bookshelf.classList.contains('slide-in')){
            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    bookshelf.classList.add('slide-in');
                });
            });
        }
        
        const entryLinks = scrollContainer.querySelectorAll('.entry-item');
        entryLinks.forEach(link=>{
            link.addEventListener('click', (e) => {
                handleAnimatedLinkClick(e);
            });
        });
        //Leave
        addLeaveHook((targetView) => {
            if (targetView.startsWith('Devlog')) {
                return Promise.resolve();
            }
            needReset = true; 
            return new Promise((resolve) => {
                let isResolved=false;
                
                const handleTransitionEnd = (e :any) => {
                    if (e.propertyName === 'transform' && e.target === bookshelf) {
                        bookshelf.removeEventListener('transitionend', handleTransitionEnd);
                        if (!isResolved) {
                            isResolved = true;
                            resolve();
                        }
                    }
                };
                bookshelf.addEventListener('transitionend', handleTransitionEnd);
                bookshelf.classList.remove('slide-in');

                setTimeout(()=>{
                    if(!isResolved){
                        bookshelf.removeEventListener('transitionend', handleTransitionEnd);
                        isResolved = true;
                        resolve();
                    }
                }, ANIMATION_TIMES.DEVLOG_LEAVE +50);
            });
        });

        //Scroll view
        if (scrollContainer && !scrollContainer.dataset.wheelAttached) {
            const handleWheel = (e: WheelEvent) => {
                if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
                    e.preventDefault();
                    scrollContainer.scrollLeft += e.deltaY;
                }
            };
            scrollContainer.addEventListener('wheel', handleWheel, { passive: false });
            scrollContainer.dataset.wheelAttached = 'true';
        }
    });
</script>