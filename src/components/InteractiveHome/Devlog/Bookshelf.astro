---
import { getCollection } from "astro:content";
import { ANIMATION_TIMES } from "../../../config";
import '../../../styles/zIndex.css';
import BookCard from './BookCard.astro'; 

const devlogSlideIn=`${ANIMATION_TIMES.DEVLOG_SLIDEIN}ms`

const devlogs = (await getCollection('devlog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const books = devlogs.filter(post => post.id.endsWith('/config'));
books.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const getFolderSlug = (id: string) => id.split('/')[0];

const { mode = 'desktop' } = Astro.props;
---

<div id={`bookshelf-ui-${mode}`} class={`bookshelf-ui ${mode}`} transition:persist={`bookshelf-ui-${mode}`}>
    <!-- 科技感细框 Header -->
    <div class="placeholder-content">
        <div class="header-info">
            <h2><span class="icon">📚</span> Devlog Bookshelf</h2>
            <p>  {books.length} BOOKS // { devlogs.length - books.length} DEVLOGS</p>
        </div>
        <div class="led-indicator"></div>
    </div>
    
    <!-- 【修改】新增视口包装层，解决阴影随滚动条移动的问题 -->
    <!-- 【修复】给 shelf-viewport 增加 id，用于移动端记录滚动位置 -->
    <div class="shelf-viewport" id={`shelf-viewport-${mode}`}>
        <div class="bookshelf-scroll-container" id={`bookshelf-scroll-${mode}`}>
            <div class="bookshelf-track">
                {
                    books.map((book) => {
                        const folderSlug = getFolderSlug(book.id);
                        return (
                            <BookCard book={book} folderSlug={folderSlug} />
                        )
                    })
                }
            </div>
        </div>
        <!-- 【新增】固定在顶层的光影遮罩，不参与滚动 -->
        <div class="shelf-lighting-overlay"></div>
    </div>
</div>


<style define:vars={{devlogSlideIn}}>
    /* =========================================
    Root
    ========================================= */
    .bookshelf-ui {
        container-type: inline-size; 
        position: absolute;
        top: 0;
        right: 0;
        display: flex;
        flex-direction: column;
        z-index: var(--z-view-main);

        width: 100%;
        height: 100%;
        
        background-color: rgba(13, 9, 20, 0.95); 
        border-left: 1px solid rgba(139, 92, 246, 0.3);
        box-shadow: -20px 0 50px rgba(0,0,0,0.8);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);

        transform: translateX(100%);
        transition: transform var(--devlogSlideIn) cubic-bezier(0.22, 1, 0.36, 1);
    }
    .bookshelf-ui.slide-in {
        transform: translateX(0);
    }

    /* =========================================
    Header
    ========================================= */
    .placeholder-content {
        margin: 3cqi 4cqi 2cqi 4cqi;
        padding: 1.5cqi 3cqi;
        border: 1px solid rgba(139, 92, 246, 0.4);
        border-radius: 6px;
        background: linear-gradient(90deg, rgba(76, 29, 149, 0.15), transparent);
        box-shadow: inset 0 0 15px rgba(139, 92, 246, 0.1);
        
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-shrink: 0;
    }
    .header-info {
        display: flex;
        align-items: baseline;
        gap: 2cqi;
    }
    .placeholder-content h2 {
        font-size: 2.2cqi; 
        color: #f3e8ff;
        text-shadow: 0 0 10px rgba(139, 92, 246, 0.8);
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .placeholder-content p {
        font-size: 1.2cqi;
        color: #a78bfa;
        margin: 0;
        font-family: monospace;
        letter-spacing: 0.1em;
    }
    .led-indicator {
        width: 1cqi;
        height: 1cqi;
        border-radius: 50%;
        background-color: #0ab83e;
        box-shadow: 0 0 8px #8bfa9d, 0 0 15px #5cf676;
        animation: pulse 2s infinite;
    }
    @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
    }

    /* =========================================
    Scroll View & Overlays
    ========================================= */
    .shelf-viewport {
        flex: 1;
        position: relative;
        width: 100%;
        min-height: 0;
        background: rgba(0, 0, 0, 0.6);
        overflow: hidden; /* 确保遮罩不溢出 */
    }

    .bookshelf-scroll-container {
        width: 100%;
        height: 100%;
        overflow-x: auto;
        overflow-y: hidden; /* 桌面端禁止垂直滚动 */
        scrollbar-width: none; 
        -ms-overflow-style: none; 
    }
    .bookshelf-scroll-container::-webkit-scrollbar {
        display: none; 
    }

    /* 【修改】将内凹阴影和 LED 灯带移到绝对定位的遮罩上，不再随滚动条移动 */
    .shelf-lighting-overlay {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        pointer-events: none; /* 穿透点击，不影响内部滚动 */
        box-shadow: 
            inset 0 25px 30px -10px rgba(0,0,0,0.9),
            inset 0 -25px 30px -10px rgba(0,0,0,0.9);
        border-top: 1px solid rgba(255,255,255,0.05);
        border-bottom: 1px solid rgba(255,255,255,0.05);
        z-index: 10;
    }
    .shelf-lighting-overlay::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        background: linear-gradient(90deg, transparent, #8b5cf6, transparent);
        box-shadow: 0 5px 25px #8b5cf6, 0 0 10px #8b5cf6;
        opacity: 0.7;
    }

    /* =========================================
    Shelf Track
    ========================================= */
    .bookshelf-track {
        display: flex;
        align-items: flex-end; 
        height: 100%;
        width: max-content;
        
        /* 【修改】调整 padding 给放大的书本留出呼吸感 */
        padding: 4cqi 5cqi 2cqi 5cqi; 
        gap: 4cqi; /* 增加书本间距 */
        
        border-bottom: 8px solid #1a1025; 
        box-shadow: 0 -4px 15px rgba(139, 92, 246, 0.15);
        background: linear-gradient(to bottom, rgba(76,29,149,0.05), transparent);
        box-sizing: border-box;
    }

    /* =========================================
    Mobile Mode
    ========================================= */
    .bookshelf-ui.mobile { display: none; }

    @media (max-width: 768px) {
        .bookshelf-ui.desktop { display: none; }
        
        .bookshelf-ui.mobile { 
            display: flex; 
            top: 6.5rem;
            height: calc(100% - 6.5rem);
        }
        
        .placeholder-content {
            margin: 1rem;
            padding: 1rem;
            flex-direction: column;
            align-items: flex-end;
            gap: 0.5rem;
        }
        .header-info {
            flex-direction: column;
            gap: 0.2rem;
        }
        .placeholder-content h2 { font-size: 1.2rem; }
        .placeholder-content p { font-size: 0.8rem;  }
        .led-indicator { display: none; }

        .shelf-viewport {
            overflow-y: auto;
            background: none;
        }
        .bookshelf-scroll-container {
            overflow-y: visible;
            height: auto;
        }
        .shelf-lighting-overlay {
            display: none; /* 移动端隐藏复杂的边缘光影 */
        }

        .bookshelf-track {
            flex-direction: column;
            align-items: stretch;
            width: 100%;
            padding: 1.5rem;
            gap: 1.5rem;
            border-bottom: none;
            background: none;
            box-shadow: none;
        }
        
        .bookshelf-track > :global(*) {
            border-bottom: 2px solid rgba(139, 92, 246, 0.2);
            padding-bottom: 1.5rem;
        }
        .bookshelf-track > :global(*:last-child) {
            border-bottom: none;
        }
    }
</style>

<script>
    import { ANIMATION_TIMES } from "../../../config";
    import { addLeaveHook } from "../../../store";
    import { handleAnimatedLinkClick } from "../../../utils/navigation";
    
    let unsubscribe: () => void = () => {};

    let savedScrollLeft = 0;
    let savedScrollTop = 0;
    let needReset = false;
    
    document.addEventListener('astro:before-swap', () => {
        // 桌面端横向滚动容器
        const scrollDesktop = document.getElementById('bookshelf-scroll-desktop');
        // 【修复】移动端纵向滚动容器变成了 shelf-viewport
        const viewportMobile = document.getElementById('shelf-viewport-mobile'); 
        
        if (needReset) {
            savedScrollLeft = 0;
            savedScrollTop = 0;
            needReset = false;
        } else {
            if (scrollDesktop && scrollDesktop.offsetParent !== null) {
                savedScrollLeft = scrollDesktop.scrollLeft;
            }
            if (viewportMobile && viewportMobile.offsetParent !== null) {
                savedScrollTop = viewportMobile.scrollTop;
            }
        }
    });
    
    document.addEventListener('astro:after-swap', () => {
        const scrollDesktop = document.getElementById('bookshelf-scroll-desktop');
        const viewportMobile = document.getElementById('shelf-viewport-mobile'); 
        
        if (scrollDesktop) scrollDesktop.scrollLeft = savedScrollLeft;
        if (viewportMobile) viewportMobile.scrollTop = savedScrollTop;
    });

    document.addEventListener('astro:page-load', () => {
        const bookshelves = document.querySelectorAll('.bookshelf-ui');
        if(bookshelves.length === 0) return;

        bookshelves.forEach((bookshelf) => {
            const scrollContainer = bookshelf.querySelector('.bookshelf-scroll-container') as HTMLElement;
            if(!scrollContainer) return;

            if (!bookshelf.classList.contains('slide-in')){
                requestAnimationFrame(() => {
                    requestAnimationFrame(() => {
                        bookshelf.classList.add('slide-in');
                    });
                });
            }
            
            const entryLinks = scrollContainer.querySelectorAll('.entry-item');
            entryLinks.forEach(link=>{
                link.addEventListener('click', (e) => {
                    handleAnimatedLinkClick(e);
                });
            });

            if (scrollContainer && !scrollContainer.dataset.wheelAttached) {
                const handleWheel = (e: WheelEvent) => {
                    if (window.innerWidth <= 768) return; 
                    if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
                        e.preventDefault();
                        scrollContainer.scrollLeft += e.deltaY;
                    }
                };
                scrollContainer.addEventListener('wheel', handleWheel as EventListener, { passive: false });
                scrollContainer.dataset.wheelAttached = 'true';
            }
        });

        addLeaveHook((targetView: string) => {
            if (targetView.startsWith('Devlog')) {
                return Promise.resolve();
            }
            needReset = true; 
            return new Promise<void>((resolve) => {
                let isResolved=false;
                
                const activeBookshelf = window.innerWidth <= 768 
                    ? document.getElementById('bookshelf-ui-mobile') 
                    : document.getElementById('bookshelf-ui-desktop');

                if (!activeBookshelf) {
                    resolve();
                    return;
                }
                
                const handleTransitionEnd = (e: any) => {
                    if (e.propertyName === 'transform' && e.target === activeBookshelf) {
                        activeBookshelf.removeEventListener('transitionend', handleTransitionEnd);
                        if (!isResolved) {
                            isResolved = true;
                            resolve();
                        }
                    }
                };
                activeBookshelf.addEventListener('transitionend', handleTransitionEnd);
                
                bookshelves.forEach(b => b.classList.remove('slide-in'));

                setTimeout(()=>{
                    if(!isResolved){
                        activeBookshelf.removeEventListener('transitionend', handleTransitionEnd);
                        isResolved = true;
                        resolve();
                    }
                }, ANIMATION_TIMES.DEVLOG_LEAVE +50);
            });
        });
    });
</script>