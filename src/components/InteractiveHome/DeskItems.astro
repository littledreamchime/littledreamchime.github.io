

<button class="desk-item bookshelf" data-target="Devlog" aria-label="Go to Devlog">
    <span>Bookshelf</span>
</button>
<button class="desk-item computer" data-target="Blog" aria-label="Go to Blog">
    <span>Computer</span>
</button>
<button class="desk-item paper" data-target="About" aria-label="Go to About">
    <span>Paper</span>
</button>

<style>
    .desk-item{
        position:absolute;
        display: flex;
        justify-content: center;
        align-items: center;
        
        outline:none;
        border:none;
        border-radius: 0.5rem;

        color:white;

        font-weight: bold;
        font-size: 1.2rem;
        
        cursor:pointer;
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    /* BookShelf */
    .bookshelf {
        top: 15%;        
        left: 5%;      
        z-index: 10;     

        width: 25%;      
        height: 40%;     

        background-color: #825491; 
    }
    .bookshelf:hover {
        transform: scale(1.05);
    }

    /* Computer */
    .computer {
        top: var(--computer-origin-y); 
        left: var(--computer-origin-x);
        z-index: 20;

        width: 45%;
        height: 40%;
        
        background-color: #4a4e69;
        
        transform: translate(-50%,-50%);
        
    }
    .computer:hover {
        transform: translate(-50%,-50%) scale(1.05);
    }

    /* Paper */
    .paper {
        bottom: calc(100% - var(--paper-origin-y));
        right:calc(100% - var(--paper-origin-x));
        z-index: 30;

        width: 15%;
        height: 25%;

        background-color: #9a8c98; 
        
        transform: rotate(15deg);
    }
    .paper:hover {
        transform: rotate(15deg) scale(1.1);
    }
</style>

<script>
    import { currentView } from "../../store";
    import { ANIMATION_TIMES } from "../../config";
    import { navigate } from 'astro:transitions/client';
    
    import { navigateWithAnimation } from "../../utils/navigation";

    document.addEventListener('astro:page-load',()=>{

        const handleClick=(e: MouseEvent)=>{
            const target=e.target as HTMLElement;
            const btn=target.closest('.desk-item');
            if(!btn) return;
            const targetView=btn.getAttribute('data-target') ;
            if(!targetView)return;
            const href = `/${targetView.toLowerCase()}`;

            navigateWithAnimation(href, targetView);
        };

        const items=document.querySelectorAll('.desk-item');
        items.forEach(item=>item.addEventListener('click',handleClick as EventListener));

    });
</script>
