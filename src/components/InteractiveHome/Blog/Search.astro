---
// src/components/Search.astro
---

<div class="cyber-search-wrapper" id="search-component">
  <div class="search-input-box">
    <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <input 
      type="text" 
      id="search-input" 
      class="search-input" 
      placeholder="Search blogs..." 
      autocomplete="off"
    />
    <div class="search-loader hidden" id="search-loader"></div>
  </div>

  <div class="search-dropdown hidden" id="search-dropdown">
    <ul class="search-results-list" id="search-results-list">
      <!-- JS 会将 template 克隆并注入到这里 -->
    </ul>
  </div>
</div>

<!-- 👇 抽离出的 HTML 模板，Astro 会自动为其内部元素加上作用域 Hash -->
<template id="search-result-template">
  <li>
    <a href="" class="search-result-item" data-index="" data-path="">
      <div class="result-title"></div>
      <div class="result-id"></div>
      <div class="result-desc"></div>
    </a>
  </li>
</template>

<template id="search-empty-template">
  <li class="search-empty">No result...</li>
</template>

<style>
  :root {
    --cyber-bg: rgba(15, 10, 25, 0.6);
    --cyber-bg-solid: #120b1c;
    --cyber-border: rgba(138, 43, 226, 0.3);
    --cyber-border-glow: rgba(186, 85, 211, 0.8);
    --cyber-text-main: #e2d8f0;
    --cyber-text-muted: #8b79a5;
    --cyber-accent: #b026ff;
    --cyber-accent-hover: rgba(176, 38, 255, 0.15);
    /* 20px -> 1.33cqi, 30px -> 2cqi */
    --cyber-shadow: 0 0 1.33cqi rgba(138, 43, 226, 0.2);
    --cyber-shadow-active: 0 0 2cqi rgba(176, 38, 255, 0.4);
    --transition-smooth: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cyber-search-wrapper {
    position: relative;
    width: 100%;
    margin: 0 auto;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }

  .search-input-box {
    overflow: hidden;
    position: relative;
    display: flex;
    align-items: center;

    border-radius: 0.85cqi;
    padding: 0 1cqi;
    height: 100%;

    background: var(--cyber-bg);
    border: 1px solid var(--cyber-border);
    transition: var(--transition-smooth);
    box-shadow: var(--cyber-shadow);
  }

  .search-input-box:focus-within {
    border-color: var(--cyber-border-glow);
    box-shadow: var(--cyber-shadow-active);
    background: rgba(20, 12, 35, 0.8);
  }

  .search-icon {
    width: 1.2cqi;
    height: 1.2cqi;
    color: var(--cyber-text-muted);
    transition: var(--transition-smooth);
  }

  .search-input-box:focus-within .search-icon {
    color: var(--cyber-accent);
    transform: scale(1.1);
  }

  .search-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--cyber-text-main);
    font-size: 0.85cqi;
    padding: 1.5cqi 1cqi;
    outline: none;
    width: 100%;
  }

  .search-input::placeholder {
    color: var(--cyber-text-muted);
    opacity: 0.7;
  }

  .search-dropdown {
    position: absolute;
    top: calc(100% + 0.5cqi);
    left: 0;
    width: 100%;
    background: var(--cyber-bg-solid);
    border: 1px solid var(--cyber-border);
    border-radius: 0.75cqi;
    box-shadow: 0 0.7cqi 2cqi rgba(0, 0, 0, 0.6), var(--cyber-shadow);
    z-index: 100;
    overflow: hidden;
    opacity: 0;
    /* 10px -> 0.66cqi */
    transform: translateY(-0.66cqi) scale(0.98);
    pointer-events: none;
    transition: var(--transition-smooth);
  }

  .search-dropdown.active {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .search-results-list {
    list-style: none;
    margin: 0;
    padding: 0.4cqi;
    max-height: 14cqi;
    overflow-y: auto;
  }

  .search-results-list::-webkit-scrollbar { width: 0.4cqi; }
  .search-results-list::-webkit-scrollbar-track { background: transparent; }
  .search-results-list::-webkit-scrollbar-thumb { background: var(--cyber-border); border-radius: 0.75cqi; }
  .search-results-list::-webkit-scrollbar-thumb:hover { background: var(--cyber-accent); }

  /* Search Item */
  .search-result-item {
    display: block;
    padding: 0.2cqi 0.3cqi;
    margin-bottom: 0.26cqi;
    /* 8px -> 0.53cqi */
    border-radius: 0.53cqi;
    /* 彻底去除 <a> 标签的下划线蓝线 */
    text-decoration: none !important;
    /* 3px -> 0.2cqi */
    border-left: 0.2cqi solid transparent;
    border-bottom: 1px solid #af26ff48;
    transition: var(--transition-smooth);
    position: relative;
    overflow: hidden;
    cursor: pointer;
  }

  .search-result-item:last-child { margin-bottom: 0; }

  .search-result-item:hover,
  .search-result-item.selected {
    background: var(--cyber-accent-hover);
    border-left-color: var(--cyber-accent);
    /* 4px -> 0.26cqi */
    transform: translateX(0.26cqi);
  }

  .search-result-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 50%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(176, 38, 255, 0.1), transparent);
    transition: 0.5s;
  }
  .search-result-item:hover::before { left: 100%; }

  .result-title {
    color: var(--cyber-text-main);
    font-weight: 600;
    font-size: 0.6cqi;
    /* 4px -> 0.26cqi */
    margin-bottom: 0.1cqi;
    transition: color 0.3s ease;
    text-decoration: none !important;
  }

  .search-result-item:hover .result-title,
  .search-result-item.selected .result-title {
    color: #fff;
    /* 8px -> 0.53cqi */
    text-shadow: 0 0 0.53cqi var(--cyber-accent);
  }

  .result-id {
    color: var(--cyber-accent);
    font-family: 'Fira Code', monospace;
    font-size: 0.4cqi;
    opacity: 0.8;
    text-decoration: none !important;
  }

  .result-desc {
    color: var(--cyber-text-muted);
    font-size: 0.45cqi;
    /* 6px -> 0.4cqi */
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-decoration: none !important;
  }

  .search-empty {
    /* 20px -> 1.33cqi */
    padding: 1.33cqi;
    text-align: center;
    color: var(--cyber-text-muted);
    font-size: 1cqi;
  }

  .search-loader {
    /* 18px -> 1.2cqi */
    width: 1.2cqi;
    height: 1.2cqi;
    /* 2px -> 0.13cqi */
    border: 0.13cqi solid var(--cyber-border);
    border-top-color: var(--cyber-accent);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }
  .search-loader.hidden { display: none; }
  @keyframes spin { to { transform: rotate(360deg); } }
  
  @media (max-aspect-ratio: 0.5) {
    
    .search-results-list {
      max-height: 32.75cqi;
    }
    /* Search Item */
    .result-title {
      font-size: 1.2cqi;
      /* 4px -> 0.26cqi */
      margin-bottom: 0.2cqi;
    }
    .result-id {
      font-size: 0.65cqi;
    }
    .result-desc {
      font-size: 0.8cqi;
    }
  }
</style>

<script>
import { navigateWithAnimation } from "../../../utils/navigation";

  function initSearch() {
    const input = document.getElementById('search-input') as HTMLInputElement;
    const dropdown = document.getElementById('search-dropdown');
    const resultsList = document.getElementById('search-results-list');
    const loader = document.getElementById('search-loader');
    
    // 获取模板
    const itemTemplate = document.getElementById('search-result-template') as HTMLTemplateElement;
    const emptyTemplate = document.getElementById('search-empty-template') as HTMLTemplateElement;
    
    if (!input || !dropdown || !resultsList || !itemTemplate || !emptyTemplate) return;

    let posts: any[] = [];
    let isLoaded = false;
    let selectedIndex = -1;

    const handleNavigation = (targetPath: string) => {
      navigateWithAnimation(targetPath);
      dropdown.classList.remove('active');
      input.blur();
    };

    const debounce = (fn: Function, delay: number) => {
      let timeoutId: ReturnType<typeof setTimeout>;
      return (...args: any[]) => {
        clearTimeout(timeoutId);
        timeoutId = setTimeout(() => fn(...args), delay);
      };
    };

    const fetchPosts = async () => {
      if (isLoaded) return;
      loader?.classList.remove('hidden');
      try {
        const res = await fetch('/api/search.json');
        posts = await res.json();
        isLoaded = true;
      } catch (e) {
        console.error("Failed to fetch search data", e);
      } finally {
        loader?.classList.add('hidden');
      }
    };

    const renderResults = (query: string) => {
      selectedIndex = -1;
      resultsList.innerHTML = '';

      if (!query) {
        dropdown.classList.remove('active');
        return;
      }

      const filtered = posts.filter(post => 
        post.title.toLowerCase().includes(query) ||
        post.id.toLowerCase().includes(query) ||
        post.description.toLowerCase().includes(query)
      ).slice(0, 8);

      dropdown.classList.add('active');

      // 渲染空状态模板
      if (filtered.length === 0) {
        resultsList.appendChild(emptyTemplate.content.cloneNode(true));
        return;
      }

      // 渲染结果项模板
      filtered.forEach((post, index) => {
        const clone = itemTemplate.content.cloneNode(true) as DocumentFragment;
        
        const a = clone.querySelector('.search-result-item') as HTMLAnchorElement;
        const title = clone.querySelector('.result-title') as HTMLElement;
        const id = clone.querySelector('.result-id') as HTMLElement;
        const desc = clone.querySelector('.result-desc') as HTMLElement;

        const targetPath = `/blog/${post.id}`;
        
        // 填充数据
        if (a) {
          a.href = targetPath;
          a.setAttribute('data-index', index.toString());
          a.setAttribute('data-path', targetPath);
        }
        if (title) {
          title.textContent = post.title;
          title.style.setProperty('--cyber-accent', post.color || '#b026ff');
        }
        if (id) {
          id.textContent = `/blog/${post.id}`;
        }
        if (desc) {
          desc.textContent = post.description;
        }

        resultsList.appendChild(clone);
      });
    };

    input.addEventListener('focus', fetchPosts);
    
    input.addEventListener('input', debounce((e: Event) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
      renderResults(query);
    }, 250));

    input.addEventListener('keydown', (e) => {
      const items = resultsList.querySelectorAll('.search-result-item');
      if (!dropdown.classList.contains('active') || items.length === 0) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = (selectedIndex + 1) % items.length;
        updateSelection(items);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = (selectedIndex - 1 + items.length) % items.length;
        updateSelection(items);
      } else if (e.key === 'Enter' && selectedIndex >= 0) {
        e.preventDefault();
        const selectedItem = items[selectedIndex] as HTMLElement;
        const path = selectedItem.getAttribute('data-path');
        if (path) handleNavigation(path);
      }
    });

    resultsList.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const item = target.closest('.search-result-item');
      
      if (item) {
        e.preventDefault();
        const path = item.getAttribute('data-path');
        if (path) handleNavigation(path);
      }
    });

    const updateSelection = (items: NodeListOf<Element>) => {
      items.forEach(item => item.classList.remove('selected'));
      if (selectedIndex >= 0) {
        const selectedItem = items[selectedIndex] as HTMLElement;
        selectedItem.classList.add('selected');
        selectedItem.scrollIntoView({ block: 'nearest' });
      }
    };

    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (!document.getElementById('search-component')?.contains(target)) {
        dropdown.classList.remove('active');
      }
    });
  }

  document.addEventListener('astro:page-load', initSearch);
  if (!document.startViewTransition) {
    document.addEventListener('DOMContentLoaded', initSearch);
  }
</script>