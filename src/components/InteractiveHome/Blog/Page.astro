---
import {render } from 'astro:content';
import ChildrenOverlay from '../Main/ChildrenOverlay.astro';
import '../../../styles/zIndex.css';
import { ANIMATION_TIMES } from '../../../config';
const pageShowTime=`${ANIMATION_TIMES.PAGE_SHOW}ms`;

const {post,folderSlug}=Astro.props;
const { Content } = await render(post);
---

<ChildrenOverlay id="page-overlay"/>
<div id="paper-ui" class="paper-ui">
    
    <div class="window-titlebar">
        <div class="titlebar-left">
            <span>Blog Reader.exe</span>
        </div>
        <div class="titlebar-right">
            <button id="paper-back-btn" class="win-btn" data-target={`/blog/${folderSlug}`}>
                ✕
            </button>
        </div>
    </div>

    <div id="paper-header" class="paper-header">
        <div class="meta">
            <h1>{post.data.title}</h1>
            <time>{post.data.pubDate.toLocaleDateString()}</time>
        </div>
    </div>

    <div id="paper-content" class="paper-content">
        <Content />
    </div>
</div>

<style define:vars={{pageShowTime}}>
    /*Main*/
    .paper-ui {
        position: absolute;
        top: 6.5rem;
        left: 50%;
		overflow: hidden;
        display: flex;
        z-index: var(--z-view-children-page);
        flex-direction: column;
        
        width: 90%;
        max-width: 900px;
        height: calc(95% - 6.5rem);
        
        opacity: 0;
        background-color: #0d1117; 
        border-radius: 0.5rem;
        border: 1px solid #30363d;
        box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.9);
        
        transform: translate(-50%, 20%) scale(0.95);
        transition: all var(--pageShowTime) cubic-bezier(0.22, 1, 0.36, 1);
    }
    .paper-ui.open {
        transform: translate(-50%, 0) scale(1);
        opacity: 1;
    }
    /* Windows-titlebar */
    
    .window-titlebar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-shrink: 0;

        padding: 0.5rem 1rem;
        font-family: monospace;
        font-size: 0.85rem;
        
        background-color: #010409;
        border-bottom: 1px solid #30363d;
        color: #8b949e;
    }
    .titlebar-right {
        display: flex;
        gap: 1rem;
    }

    /*Header*/
    .paper-header {
        display:flex;
        flex: 0 0 auto;
        flex-direction: column;
        align-items: flex-start;

        padding: 2rem clamp(1.5rem, 5vw, 4rem) 1rem;
        border-bottom: 1px solid #21262d;
        
        max-height: 500px;
        
        opacity: 1;
        transition: all var(--pageShowTime) cubic-bezier(0.4, 0, 0.2, 1);
    }
    .paper-header:hover{
    }

    .win-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        
        width: 2.5rem; 
        height: 2.5rem;
        font-size: 1.25rem; 

        border: none;
        border-radius: 0.25rem;

        background: transparent;
        color: #8b949e; 
        font-size: 1rem;

        cursor: pointer;
        transition: background 0.2s, color 0.2s;
    }
     
    .win-btn:hover{
        background: #e81123;
        color: #ffffff;
    }
    .meta {
        display: flex;
        flex-direction: column;
        width: 100%;
        gap: 0.5rem;
    }
    .meta h1 {
        margin:0;
        
        font-size: clamp(1.5rem, 4vw + 1rem, 2.5rem);
        color: #e6edf3;
        font-family: monospace;
        line-height: 1.3;
    }
    .meta time {
        margin: 0;

        color: #7d8590;
        font-size: 0.875rem;
    }

    /*Content*/
    .paper-content {
        overflow-y: auto;
        flex: 1;
        scroll-behavior: smooth;

        padding: 2rem clamp(1.5rem, 5vw, 4rem) 4rem;

        color: #c8bccc;
        font-family: sans-serif;
        line-height: 1.8;
        font-size: 1rem;
        
        scrollbar-width: none;
        -ms-overflow-style: none;
    }
    .paper-content::-webkit-scrollbar { display: none; }

    .paper-content :global(h2) { 
        margin-top: 2rem; 
        color: #e6edf3;
        border-bottom: 1px solid #30363d;
        padding-bottom: 0.5rem; 
    }
    .paper-content :global(p) { margin-bottom: 1.5rem; }
    .paper-content :global(a) { 
        color: #58a6ff;
        text-decoration: none; 
        border-bottom: 1px dashed #58a6ff; 
        transition: color 0.2s, border-color 0.2s; 
    }
    .paper-content :global(a:hover) { 
        color: #79c0ff; 
        border-color: #79c0ff; 
    }
    .paper-content :global(code) { 
        background: #161b22;
        color: #4AF626;
        padding: 0.2rem 0.4rem; 
        border-radius: 4px; 
        font-size: 0.9em; 
    }
    .paper-content :global(pre) { 
        background: #000000;
        color: #4AF626;
        padding: 1rem; 
        border-radius: 4px;
        overflow-x: auto; 
        border: 1px solid #30363d;
    }

    
@media (max-width: 768px) {
    
    .paper-ui {
        width: 100%;
        height: calc(100% - 6.5rem);
        
    }
    .paper-content {
        font-size: 0.75rem; 
    }
    
    .window-titlebar {
        padding: 0.25rem 0.5rem;
    }
    
    .paper-header.header-hidden{
        max-height: 0;
        padding-top: 0;
        padding-bottom: 0;
        margin-bottom: 0;
        border-bottom-width: 0;
        opacity: 0;
        overflow: hidden;
    }
    
    .win-btn {
        width: 3rem;      
        height: 3rem;
        font-size: 1.5rem;
    }
}

</style>

<script>
    import { addLeaveHook } from '../../../store';
    import { navigateWithAnimation } from '../../../utils/navigation';
    import { ANIMATION_TIMES } from '../../../config';

    document.addEventListener('astro:page-load', () => {
        const paper = document.getElementById('paper-ui');
        const backBtn = document.getElementById('paper-back-btn');
        const overlay = document.getElementById('page-overlay');
        const content = document.getElementById('paper-content');
        const header = document.getElementById('paper-header');
        if(!paper || !overlay) return;

        requestAnimationFrame(() => {
            requestAnimationFrame(() => {
                if (!paper.classList.contains('open')) paper.classList.add('open');
                if (!overlay.classList.contains('show')) overlay.classList.add('show');
            });
        });

        if (content && header) {
            let lastScrollY = content.scrollTop;
            let ticking = false; 

            content.addEventListener('scroll', () => {
                if (!ticking) {
                    window.requestAnimationFrame(() => {
                        const currentScrollY = content.scrollTop;
                        const maxScroll = content.scrollHeight - content.clientHeight;

                        if (currentScrollY <= 0 || currentScrollY >= maxScroll - 10) {
                            lastScrollY = currentScrollY;
                            ticking = false;
                            return; 
                        }

                        if (currentScrollY > lastScrollY && currentScrollY > 50) {
                            header.classList.add('header-hidden');
                        } 
                        else if (currentScrollY < lastScrollY) {
                            header.classList.remove('header-hidden');
                        }
                        
                        lastScrollY = currentScrollY;
                        ticking = false;
                    });
                    ticking = true;
                }
            });

            /*prevent md auto scroll*/
            content.addEventListener('click', (e) => {
                if(!e.target) return;
                const link =(e.target as HTMLElement).closest('a[href^="#"]');
                if (!link) return;
                const targethref=link.getAttribute('href');
                if(!targethref) return;
                const targetId = targethref.substring(1);
                const targetElement = document.getElementById(targetId);

                if (targetElement) {
                    e.preventDefault();

                    const containerRect = content.getBoundingClientRect();
                    const targetRect = targetElement.getBoundingClientRect();
                    const scrollPos = content.scrollTop + (targetRect.top - containerRect.top) - 20;

                    content.scrollTo({ top: scrollPos, behavior: 'smooth' });
                }
            });
        }


        const goBack = () => {
            const targetUrl = backBtn?.getAttribute('data-target');
            if(!targetUrl) return;
            navigateWithAnimation(targetUrl);
        };
        overlay.addEventListener('click', goBack);

        backBtn?.addEventListener('click', goBack);

        addLeaveHook((targetView) => {
            return new Promise((resolve) => {
                paper.classList.remove('open');
                if(targetView!=='BlogPage')
                    overlay.classList.remove('show');
                
                setTimeout(() => {
                    paper.style.display = 'none';
                    if(targetView!=='BlogPage')
                        overlay.style.display = 'none';
                    resolve();
                }, ANIMATION_TIMES.PAGE_SHOW); 
            });
        });
    });
</script>