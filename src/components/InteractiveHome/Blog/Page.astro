---
import {render } from 'astro:content';
import ChildrenOverlay from '../Main/ChildrenOverlay.astro';
import '../../../styles/zIndex.css';
import { ANIMATION_TIMES } from '../../../config';
import Giscus from '../Main/Giscus.astro';
const pageShowTime=`${ANIMATION_TIMES.PAGE_SHOW}ms`;

const {post,folderSlug}=Astro.props;
const { Content } = await render(post);
---

<ChildrenOverlay id="page-overlay"/>
<div id="paper-ui" class="paper-ui">
    
    <!-- 升级后的 HUD 视窗标题栏 -->
    <div class="window-titlebar">
        <div class="titlebar-left">
            <span class="sys-prefix">SYS.TASK // </span>
            <span class="process-name">BLOG_READER.EXE</span>
            <span class="blinking-cursor">_</span>
        </div>
        <div class="titlebar-right">
            <button id="paper-back-btn" class="win-btn" data-target={`/blog/${folderSlug}`} aria-label="Close Window">
                <span class="btn-icon">✕</span>
            </button>
        </div>
    </div>

    <!-- 渐变发光的头部 -->
    <div id="paper-header" class="paper-header">
        <div class="meta">
            <h1>{post.data.title}</h1>
            {post.data.description && <p class="description">{post.data.description}</p>}
            <time>{post.data.pubDate.toLocaleDateString()}</time>
        </div>
    </div>

    <div id="paper-content" class="paper-content">
        <Content />
        <Giscus />
    </div>
</div>

<style define:vars={{pageShowTime}}>
    /* =========================================
       Main Window (Future Mica Glass)
    ========================================= */
    .paper-ui {
        position: absolute;
        top: 6.5rem;
        left: 50%;
		overflow: hidden;
        display: flex;
        z-index: var(--z-view-children-page);
        flex-direction: column;
        
        width: 90%;
        max-width: 900px;
        height: calc(95% - 6.5rem);
        
        /* 【修改】未来感亚克力玻璃材质 */
        background-color: rgba(13, 9, 20, 0.75); 
        backdrop-filter: blur(24px) saturate(150%);
        -webkit-backdrop-filter: blur(24px) saturate(150%);
        
        border-radius: 12px;
        /* 高级的高光边框与深邃阴影 */
        border: 1px solid rgba(139, 92, 246, 0.25);
        box-shadow: 
            0 2rem 4rem -1rem rgba(0, 0, 0, 0.9),
            inset 0 1px 0 rgba(255, 255, 255, 0.1),
            inset 0 0 20px rgba(139, 92, 246, 0.05);
        
        opacity: 0;
        transform: translate(-50%, 20%) scale(0.95);
        transition: all var(--pageShowTime) cubic-bezier(0.22, 1, 0.36, 1);
    }
    .paper-ui.open {
        transform: translate(-50%, 0) scale(1);
        opacity: 1;
    }

    /* =========================================
       HUD Titlebar
    ========================================= */
    .window-titlebar {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-shrink: 0;

        padding: 0.5rem 1rem;
        font-family: 'Inter', monospace, sans-serif;
        font-size: 0.8rem;
        letter-spacing: 0.05em;
        
        /* 顶部微弱的能量背景 */
        background: linear-gradient(90deg, rgba(139, 92, 246, 0.15), rgba(0,0,0,0.2) 50%, transparent);
        border-bottom: 1px solid rgba(139, 92, 246, 0.2);
        color: #a78bfa;
    }
    
    .titlebar-left {
        display: flex;
        align-items: center;
        gap: 0.2rem;
    }
    .sys-prefix { opacity: 0.5; }
    .process-name { font-weight: bold; color: #e9d5ff; text-shadow: 0 0 8px rgba(139, 92, 246, 0.5); }
    .blinking-cursor { animation: blink 1s step-end infinite; color: #8b5cf6; }
    @keyframes blink { 50% { opacity: 0; } }

    .titlebar-right {
        display: flex;
        gap: 0.5rem;
    }

    /* Holographic Close Button */
    .win-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem; 
        height: 2rem;
        
        border: 1px solid transparent;
        border-radius: 6px;
        background: transparent;
        color: #8b7a9f; 
        font-size: 1.1rem;

        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .win-btn:hover {
        /* 悬浮时呈现赛博警告红 */
        background: rgba(244, 63, 94, 0.15);
        border-color: rgba(244, 63, 94, 0.5);
        color: #fda4af;
        box-shadow: 0 0 15px rgba(244, 63, 94, 0.4);
        transform: scale(1.05);
    }
    .win-btn:active {
        transform: scale(0.95);
    }

    /* =========================================
       Header
    ========================================= */
    .paper-header {
        position: relative;
        display:flex;
        flex: 0 0 auto;
        flex-direction: column;
        align-items: flex-start;

        padding: 2.5rem clamp(1.5rem, 5vw, 4rem) 1.5rem;
        background: linear-gradient(to bottom, rgba(139, 92, 246, 0.05), transparent);
        
        max-height: 500px;
        opacity: 1;
        transition: all var(--pageShowTime) cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    /* 头部底部的发光射线 */
    .paper-header::after {
        content: '';
        position: absolute;
        bottom: 0; left: 5%; right: 5%;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(139, 92, 246, 0.4), transparent);
        box-shadow: 0 0 10px rgba(139, 92, 246, 0.3);
        transition: opacity var(--pageShowTime) ease;
    }

    .meta {
        display: flex;
        flex-direction: column;
        width: 100%;
        gap: 0.75rem;
    }
    .meta h1 {
        margin:0;
        font-size: clamp(1.5rem, 4vw + 1rem, 2.5rem);
        color: #f3e8ff;
        font-family: 'Inter', system-ui, sans-serif;
        font-weight: 700;
        line-height: 1.2;
        letter-spacing: 0.02em;
        text-shadow: 0 0 15px rgba(139, 92, 246, 0.4);
    }
    .meta .description {
        margin: 0;
        font-size: clamp(1rem, 2vw + 0.5rem, 1.15rem);
        color: #cbd5e1;
        font-family: 'Inter', system-ui, sans-serif; 
        line-height: 1.5;
        border-left: 3px solid rgba(139, 92, 246, 0.5);
        padding-left: 1rem;
    }
    .meta time {
        margin: 0;
        color: #a78bfa;
        font-size: 0.85rem;
        font-family: monospace;
        letter-spacing: 0.05em;
    }
    .meta time::before {
        content: 'CREATED: ';
        opacity: 0.5;
    }

    /* =========================================
       Content (Premium Terminal Reader)
    ========================================= */
    .paper-content {
        overflow-y: auto;
        flex: 1;
        scroll-behavior: smooth;

        padding: 2rem clamp(1.5rem, 5vw, 4rem) 4rem;

        color: #cbd5e1;
        font-family: 'Inter', system-ui, sans-serif;
        line-height: 1.8;
        font-size: 1.05rem;
        letter-spacing: 0.01em;
        
        scrollbar-width: none;
        -ms-overflow-style: none;
    }
    .paper-content::-webkit-scrollbar { display: none; }

    .paper-content :global(h2) { 
        margin-top: 3rem; 
        margin-bottom: 1.5rem;
        color: #f3e8ff;
        border-bottom: 1px solid rgba(139, 92, 246, 0.2);
        border-left: 4px solid #8b5cf6;
        padding-left: 1rem;
        padding-bottom: 0.5rem; 
        text-shadow: 0 0 10px rgba(139, 92, 246, 0.3);
    }
    .paper-content :global(h3) { color: #e9d5ff; margin-top: 2rem; }
    .paper-content :global(p) { margin-bottom: 1.5rem; }
    
    .paper-content :global(a) { 
        color: #a78bfa;
        text-decoration: none; 
        border-bottom: 1px solid rgba(167, 139, 250, 0.4); 
        transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1); 
    }
    .paper-content :global(a:hover) { 
        color: #d8b4fe; 
        border-color: #d8b4fe; 
        text-shadow: 0 0 8px rgba(167, 139, 250, 0.6);
    }
    
    .paper-content :global(code) { 
        background: rgba(139, 92, 246, 0.15);
        color: #d8b4fe;
        padding: 0.2rem 0.4rem; 
        border-radius: 4px; 
        border: 1px solid rgba(139, 92, 246, 0.3);
        font-family: monospace;
        font-size: 0.9em; 
    }
    .paper-content :global(pre) { 
        background: rgba(0, 0, 0, 0.6);
        color: #e2d8ee;
        padding: 1.25rem; 
        border-radius: 8px;
        overflow-x: auto; 
        border: 1px solid rgba(139, 92, 246, 0.2);
        box-shadow: inset 0 0 15px rgba(0,0,0,0.8);
        margin-bottom: 1.5rem;
    }
    .paper-content :global(blockquote) {
        border-left: 4px solid #8b5cf6;
        background: linear-gradient(90deg, rgba(139, 92, 246, 0.1), transparent);
        padding: 1rem 1.5rem;
        margin: 1.5rem 0;
        border-radius: 0 8px 8px 0;
        color: #a78bfa;
        font-style: italic;
    }

    /* =========================================
       Media Queries
    ========================================= */
    @media (max-width: 768px) {
        .paper-ui {
            width: 100%;
            height: calc(100% - 6.5rem);
            border-radius: 0; /* 移动端占满屏幕时去掉圆角 */
            border: none;
        }
        .paper-content {
            font-size: 0.95rem; 
        }
        
        .window-titlebar {
            padding: 0.4rem 0.8rem;
        }
        
        .paper-header.header-hidden {
            max-height: 0;
            padding-top: 0;
            padding-bottom: 0;
            margin-bottom: 0;
            border-bottom-width: 0;
            opacity: 0;
            overflow: hidden;
        }
        .paper-header.header-hidden::after {
            opacity: 0;
        }
        
        .win-btn {
            width: 2.2rem;      
            height: 2.2rem;
            font-size: 1.2rem;
        }
    }
</style>

<script>
    /* JS 逻辑完全保持不变 */
    import { addLeaveHook } from '../../../store';
    import { navigateWithAnimation } from '../../../utils/navigation';
    import { ANIMATION_TIMES } from '../../../config';

    document.addEventListener('astro:page-load', () => {
        const paper = document.getElementById('paper-ui');
        const backBtn = document.getElementById('paper-back-btn');
        const overlay = document.getElementById('page-overlay');
        const content = document.getElementById('paper-content');
        const header = document.getElementById('paper-header');
        if(!paper || !overlay) return;

        requestAnimationFrame(() => {
            requestAnimationFrame(() => {
                if (!paper.classList.contains('open')) paper.classList.add('open');
                if (!overlay.classList.contains('show')) overlay.classList.add('show');
            });
        });

        if (content && header) {
            let lastScrollY = content.scrollTop;
            let ticking = false; 

            content.addEventListener('scroll', () => {
                if (!ticking) {
                    window.requestAnimationFrame(() => {
                        const currentScrollY = content.scrollTop;
                        const maxScroll = content.scrollHeight - content.clientHeight;

                        if (currentScrollY <= 0 || currentScrollY >= maxScroll - 10) {
                            lastScrollY = currentScrollY;
                            ticking = false;
                            return; 
                        }

                        if (currentScrollY > lastScrollY && currentScrollY > 50) {
                            header.classList.add('header-hidden');
                        } 
                        else if (currentScrollY < lastScrollY) {
                            header.classList.remove('header-hidden');
                        }
                        
                        lastScrollY = currentScrollY;
                        ticking = false;
                    });
                    ticking = true;
                }
            });

            /*prevent md auto scroll*/
            content.addEventListener('click', (e) => {
                if(!e.target) return;
                const link =(e.target as HTMLElement).closest('a[href^="#"]');
                if (!link) return;
                const targethref=link.getAttribute('href');
                if(!targethref) return;
                const targetId = targethref.substring(1);
                const targetElement = document.getElementById(targetId);

                if (targetElement) {
                    e.preventDefault();

                    const containerRect = content.getBoundingClientRect();
                    const targetRect = targetElement.getBoundingClientRect();
                    const scrollPos = content.scrollTop + (targetRect.top - containerRect.top) - 20;

                    content.scrollTo({ top: scrollPos, behavior: 'smooth' });
                }
            });
        }

        const goBack = () => {
            const targetUrl = backBtn?.getAttribute('data-target');
            if(!targetUrl) return;
            navigateWithAnimation(targetUrl);
        };
        overlay.addEventListener('click', goBack);

        backBtn?.addEventListener('click', goBack);

        addLeaveHook((targetView) => {
            return new Promise((resolve) => {
                paper.classList.remove('open');
                if(targetView!=='BlogPage')
                    overlay.classList.remove('show');
                
                setTimeout(() => {
                    paper.style.display = 'none';
                    if(targetView!=='BlogPage')
                        overlay.style.display = 'none';
                    resolve();
                }, ANIMATION_TIMES.PAGE_SHOW); 
            });
        });
    });
</script>