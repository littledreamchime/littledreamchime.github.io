---
import { render } from 'astro:content';
import ChildrenOverlay from '../Main/ChildrenOverlay.astro';
import '../../../styles/zIndex.css';
import { ANIMATION_TIMES } from '../../../config';
import Giscus from '../Main/Giscus.astro';
const pageShowTime=`${ANIMATION_TIMES.PAGE_SHOW}ms`;

const { post, folderSlug } = Astro.props;
const { Content } = await render(post);

// 【修改】安全提取背景大图：仅使用 detailImage，没有则直接不展示
const { detailImage } = post.data;
const bgImageUrl = detailImage ? (typeof detailImage === 'string' ? detailImage : detailImage.src) : null;
---

<ChildrenOverlay id="page-overlay"/>
<div id="paper-ui" class="paper-ui">
    
    <!-- 升级后的 HUD 视窗标题栏 -->
    <div class="window-titlebar" id="window-titlebar" data-post-title={post.data.title}>
        <div class="titlebar-left">
            <span class="sys-prefix">SYS.TASK // </span>
            <!-- 【新增】加上 id="process-name" 以便 JS 操作，并增加防溢出样式 -->
            <span class="process-name" id="process-name">BLOG_READER.EXE</span>
            <span class="blinking-cursor">_</span>
        </div>
        <div class="titlebar-right">
            <button id="paper-back-btn" class="win-btn" data-target={`/blog/${folderSlug}`} aria-label="Close Window">
                <span class="btn-icon">✕</span>
            </button>
        </div>
    </div>

    <div id="paper-content" class="paper-content">
        <!-- 【修改】将 paper-header 移入滚动区域，使其自然滚走 -->
        <div id="paper-header" class="paper-header">
            
            <!-- 画廊级全息背景图层 -->
            {bgImageUrl && (
                <div class="header-bg-wrapper">
                    <div class="header-bg-image" style={`background-image: url('${bgImageUrl}')`}></div>
                    <div class="header-bg-overlay"></div>
                </div>
            )}

            <div class="meta">
                <h1>{post.data.title}</h1>
                {post.data.description && <p class="description">{post.data.description}</p>}
                <time>{post.data.pubDate.toLocaleDateString()}</time>
            </div>
        </div>

        <!-- 【新增】内容包裹层，接管原本 paper-content 的 padding -->
        <div class="content-wrapper">
            <Content />
            <Giscus />
        </div>
    </div>
</div>

<style define:vars={{pageShowTime}}>
    /* =========================================
       Main Window (Future Mica Glass)
    ========================================= */
    .paper-ui {
        position: absolute;
        top: 6.5rem;
        left: 50%;
		overflow: hidden;
        display: flex;
        z-index: var(--z-view-children-page);
        flex-direction: column;
        
        width: 90%;
        max-width: 900px;
        height: calc(95% - 6.5rem);
        
        background-color: rgba(13, 9, 20, 0.75); 
        backdrop-filter: blur(24px) saturate(150%);
        -webkit-backdrop-filter: blur(24px) saturate(150%);
        
        border-radius: 12px;
        border: 1px solid rgba(139, 92, 246, 0.25);
        box-shadow: 
            0 2rem 4rem -1rem rgba(0, 0, 0, 0.9),
            inset 0 1px 0 rgba(255, 255, 255, 0.1),
            inset 0 0 20px rgba(139, 92, 246, 0.05);
        
        opacity: 0;
        will-change: transform, opacity;
        transform: translate(-50%, 20%) scale(0.95) translateZ(0);
        transition: all var(--pageShowTime) cubic-bezier(0.22, 1, 0.36, 1);
    }
    .paper-ui.open {
        transform: translate(-50%, 0) scale(1);
        opacity: 1;
    }

    /* =========================================
       HUD Titlebar
    ========================================= */
    .window-titlebar {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-shrink: 0;

        padding: 0.5rem 1rem;
        font-family: 'Inter', monospace, sans-serif;
        font-size: 0.8rem;
        letter-spacing: 0.05em;
        
        background: linear-gradient(90deg, rgba(139, 92, 246, 0.15), rgba(0,0,0,0.2) 50%, transparent);
        border-bottom: 1px solid rgba(139, 92, 246, 0.2);
        color: #a78bfa;
    }
    
    .titlebar-left {
        display: flex;
        align-items: center;
        gap: 0.2rem;
        /* 【新增】防止左侧内容挤压右侧按钮 */
        flex: 1;
        min-width: 0; 
        padding-right: 1rem;
    }
    .sys-prefix { 
        opacity: 0.5; 
        flex-shrink: 0;
    }
    .process-name { 
        font-weight: bold; 
        color: #e9d5ff; 
        text-shadow: 0 0 8px rgba(139, 92, 246, 0.5); 
        /* 【新增】超出省略号显示，防止长标题破坏布局 */
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        transition: color 0.3s ease;
    }
    .blinking-cursor { 
        animation: blink 1s step-end infinite; 
        color: #8b5cf6; 
        flex-shrink: 0;
    }
    @keyframes blink { 50% { opacity: 0; } }

    .titlebar-right {
        display: flex;
        gap: 0.5rem;
        flex-shrink: 0;
    }

    .win-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem; 
        height: 2rem;
        
        border: 1px solid transparent;
        border-radius: 6px;
        background: transparent;
        color: #8b7a9f; 
        font-size: 1.1rem;

        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .win-btn:hover {
        background: rgba(244, 63, 94, 0.15);
        border-color: rgba(244, 63, 94, 0.5);
        color: #fda4af;
        box-shadow: 0 0 15px rgba(244, 63, 94, 0.4);
        transform: scale(1.05);
    }
    .win-btn:active {
        transform: scale(0.95);
    }

    /* =========================================
       Header
    ========================================= */
    .paper-header {
        position: relative;
        display:flex;
        flex: 0 0 auto;
        flex-direction: column;
        align-items: flex-start;

        padding: 2.5rem clamp(1.5rem, 5vw, 4rem) 1.5rem;
        background: transparent;
        
        max-height: 500px;
        opacity: 1;
        /* 移除了原本 header-hidden 的过渡动画，因为现在是自然滚动 */
    }
    
    .paper-header::after {
        content: '';
        position: absolute;
        bottom: 0; left: 5%; right: 5%;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(139, 92, 246, 0.4), transparent);
        box-shadow: 0 0 10px rgba(139, 92, 246, 0.3);
    }

    /* =========================================
       画廊级背景动画层
    ========================================= */
    .header-bg-wrapper {
        position: absolute;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
        -webkit-mask-image: linear-gradient(to bottom, black 0%, black 60%, transparent 100%);
        mask-image: linear-gradient(to bottom, black 0%, black 60%, transparent 100%);
    }

    .header-bg-image {
        position: absolute;
        top: 0; 
        left: 0; 
        width: 120%; 
        height: 100%;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        opacity: 0.4; 
        
        animation: gallery-pan 20s cubic-bezier(0.2, 0, 0.2, 1) forwards;
    }

    @keyframes gallery-pan {
        0% { transform: translateX(0); }
        100% { transform: translateX(-16.666%); }
    }

    .header-bg-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to right,
            rgba(13, 9, 20, 0.8) 0%,
            rgba(13, 9, 20, 0.4) 50%,
            rgba(13, 9, 20, 0.8) 100%
        );
    }

    /* =========================================
       Meta Content
    ========================================= */
    .meta {
        position: relative;
        z-index: 1; 
        display: flex;
        flex-direction: column;
        width: 100%;
        gap: 0.75rem;
    }
    .meta h1 {
        margin:0;
        font-size: clamp(1.5rem, 4vw + 1rem, 2.5rem);
        color: #f3e8ff;
        font-family: 'Inter', system-ui, sans-serif;
        font-weight: 700;
        line-height: 1.2;
        letter-spacing: 0.02em;
        text-shadow: 0 0 15px rgba(139, 92, 246, 0.4);
    }
    .meta .description {
        margin: 0;
        font-size: clamp(1rem, 2vw + 0.5rem, 1.15rem);
        color: #cbd5e1;
        font-family: 'Inter', system-ui, sans-serif; 
        line-height: 1.5;
        border-left: 3px solid rgba(139, 92, 246, 0.5);
        padding-left: 1rem;
    }
    .meta time {
        margin: 0;
        color: #a78bfa;
        font-size: 0.85rem;
        font-family: monospace;
        letter-spacing: 0.05em;
    }
    .meta time::before {
        content: 'CREATED: ';
        opacity: 0.5;
    }

    /* =========================================
       Content (Premium Terminal Reader)
    ========================================= */
    .paper-content {
        overflow-y: auto;
        flex: 1;
        scroll-behavior: smooth;
        padding: 0; /* 【修改】外层 padding 归零，交给 content-wrapper */
        scrollbar-width: none;
        -ms-overflow-style: none;
    }
    .paper-content::-webkit-scrollbar { display: none; }

    .content-wrapper {
        padding: 2rem clamp(1.5rem, 5vw, 4rem) 4rem;
        color: #cbd5e1;
        font-family: 'Inter', system-ui, sans-serif;
        line-height: 1.8;
        font-size: 1.05rem;
        letter-spacing: 0.01em;
    }

    .content-wrapper :global(h2) { 
        margin-top: 3rem; 
        margin-bottom: 1.5rem;
        color: #f3e8ff;
        border-bottom: 1px solid rgba(139, 92, 246, 0.2);
        border-left: 4px solid #8b5cf6;
        padding-left: 1rem;
        padding-bottom: 0.5rem; 
        text-shadow: 0 0 10px rgba(139, 92, 246, 0.3);
    }
    .content-wrapper :global(h3) { color: #e9d5ff; margin-top: 2rem; }
    .content-wrapper :global(p) { margin-bottom: 1.5rem; }
    
    .content-wrapper :global(a) { 
        color: #a78bfa;
        text-decoration: none; 
        border-bottom: 1px solid rgba(167, 139, 250, 0.4); 
        transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1); 
    }
    .content-wrapper :global(a:hover) { 
        color: #d8b4fe; 
        border-color: #d8b4fe; 
        text-shadow: 0 0 8px rgba(167, 139, 250, 0.6);
    }
    
    .content-wrapper :global(code) { 
        background: rgba(139, 92, 246, 0.15);
        color: #d8b4fe;
        padding: 0.2rem 0.4rem; 
        border-radius: 4px; 
        border: 1px solid rgba(139, 92, 246, 0.3);
        font-family: monospace;
        font-size: 0.9em; 
    }
    .content-wrapper :global(pre) { 
        background: rgba(0, 0, 0, 0.6);
        color: #e2d8ee;
        padding: 1.25rem; 
        border-radius: 8px;
        overflow-x: auto; 
        border: 1px solid rgba(139, 92, 246, 0.2);
        box-shadow: inset 0 0 15px rgba(0,0,0,0.8);
        margin-bottom: 1.5rem;
    }
    .content-wrapper :global(blockquote) {
        border-left: 4px solid #8b5cf6;
        background: linear-gradient(90deg, rgba(139, 92, 246, 0.1), transparent);
        padding: 1rem 1.5rem;
        margin: 1.5rem 0;
        border-radius: 0 8px 8px 0;
        color: #a78bfa;
        font-style: italic;
    }

    /* =========================================
       Media Queries
    ========================================= */
    @media (max-width: 768px) {
        .paper-ui {
            width: 100%;
            height: calc(100% - 6.5rem);
            border-radius: 0; 
            border: none;
        }
        .content-wrapper {
            font-size: 0.95rem; 
        }
        
        .window-titlebar {
            padding: 0.4rem 0.8rem;
        }
        
        .win-btn {
            width: 2.2rem;      
            height: 2.2rem;
            font-size: 1.2rem;
        }
    }
</style>

<script>
    import { addLeaveHook } from '../../../store';
    import { navigateWithAnimation } from '../../../utils/navigation';
    import { ANIMATION_TIMES } from '../../../config';

    document.addEventListener('astro:page-load', () => {
        const paper = document.getElementById('paper-ui');
        const backBtn = document.getElementById('paper-back-btn');
        const overlay = document.getElementById('page-overlay');
        const content = document.getElementById('paper-content');
        const header = document.getElementById('paper-header');
        
        // 【新增】获取标题栏相关元素
        const titlebar = document.getElementById('window-titlebar');
        const processName = document.getElementById('process-name');

        if(!paper || !overlay) return;

        requestAnimationFrame(() => {
            requestAnimationFrame(() => {
                if (!paper.classList.contains('open')) paper.classList.add('open');
                if (!overlay.classList.contains('show')) overlay.classList.add('show');
            });
        });

        if (content && header && titlebar && processName) {
            const originalName = "BLOG_READER.EXE";
            const postTitle = titlebar.getAttribute('data-post-title') || originalName;
            let isTitleChanged = false;
            let ticking = false; 

            content.addEventListener('scroll', () => {
                if (!ticking) {
                    window.requestAnimationFrame(() => {
                        const currentScrollY = content.scrollTop;
                        const headerHeight = header.offsetHeight;

                        // 【核心逻辑】当向下滚动距离超过原Header的高度时，替换标题文字
                        if (currentScrollY > headerHeight - 20) {
                            if (!isTitleChanged) {
                                processName.textContent = postTitle;
                                // 可选：改变颜色以示区分
                                processName.style.color = '#f3e8ff';
                                isTitleChanged = true;
                            }
                        } else {
                            if (isTitleChanged) {
                                processName.textContent = originalName;
                                processName.style.color = ''; // 恢复默认颜色
                                isTitleChanged = false;
                            }
                        }
                        
                        ticking = false;
                    });
                    ticking = true;
                }
            });

            content.addEventListener('click', (e) => {
                if(!e.target) return;
                const link =(e.target as HTMLElement).closest('a[href^="#"]');
                if (!link) return;
                const targethref=link.getAttribute('href');
                if(!targethref) return;
                const targetId = targethref.substring(1);
                const targetElement = document.getElementById(targetId);

                if (targetElement) {
                    e.preventDefault();

                    const containerRect = content.getBoundingClientRect();
                    const targetRect = targetElement.getBoundingClientRect();
                    // 这里的偏移量保持 -20 即可，因为 titlebar 并不在滚动区域内，不会遮挡内容
                    const scrollPos = content.scrollTop + (targetRect.top - containerRect.top) - 20;

                    content.scrollTo({ top: scrollPos, behavior: 'smooth' });
                }
            });
        }

        const goBack = () => {
            const targetUrl = backBtn?.getAttribute('data-target');
            if(!targetUrl) return;
            navigateWithAnimation(targetUrl);
        };
        overlay.addEventListener('click', goBack);

        backBtn?.addEventListener('click', goBack);

        addLeaveHook((targetView) => {
            return new Promise((resolve) => {
                paper.classList.remove('open');
                if(targetView!=='BlogPage')
                    overlay.classList.remove('show');
                
                setTimeout(() => {
                    paper.style.display = 'none';
                    if(targetView!=='BlogPage')
                        overlay.style.display = 'none';
                    resolve();
                }, ANIMATION_TIMES.PAGE_SHOW); 
            });
        });
    });
</script>