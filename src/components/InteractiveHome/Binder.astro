---
// src/components/Binder.astro
const { title, entries } = Astro.props;
---

<div id="binder-overlay" class="binder-overlay" transition:animate="none" ></div>

<div id="binder-ui" class="binder-ui"  transition:persist="Binder" transition:animate="none">
    <!--Header -->
    <div class="binder-header">
        <button id="binder-back-btn" class="back-btn">← Back</button>
        <h2>📂 {title}</h2>
    </div>
    
    <!--Content -->
    <div class="binder-content">
        <ul class="entry-list">
            {entries.map((entry: any) => (
                <li>
                    <a href={`/devlog/${entry.id}`} class="entry-item">
                        <span class="entry-title">📄 {entry.data.title}</span>
                        <span class="entry-date">{entry.data.pubDate.toLocaleDateString()}</span>
                    </a>
                </li>
            ))}
            {entries.length === 0 && <p class="empty-text">Ops! It's empty...</p>}
        </ul>
    </div>
</div>

<style>
    :root{
        --blinder-slide-in-time: 0.6s;
    }
    /*Overlay*/
    .binder-overlay {

        position: fixed;
        top: 0; 
        left: 0; 
        background: rgba(0, 0, 0, 0.5);
        z-index: 275;
        backdrop-filter: blur(4px);

        width: 100%; 
        height: 100%;

        opacity: 0;

        pointer-events: none;
        transition: opacity calc(var(--blinder-slide-in-time)/3*2) ease;
    }
    .binder-overlay.show {
        opacity: 1;
        pointer-events: auto;
    }

    /*Binder*/
    .binder-ui {
        position: absolute;
        top: 5%;
        left: 20%;
        display: flex;
        flex-direction: column;
        z-index: 300;

        width: 60%;
        height: 90%;

        border-radius: 1cqi;
        box-shadow: 0 2cqi 5cqi rgba(0,0,0,0.5);
        border-left: 1.5cqi solid #825491;
        padding: 3cqi;

        background-color: #f4f1ea;
        opacity: 0;
        
        transform: translateY(20%) scale(0.9);
        transition: all var(--blinder-slide-in-time) cubic-bezier(0.22, 1, 0.36, 1);
    }
    .binder-ui.open {
        transform: translateY(0) scale(1);
        opacity: 1;
    }
    /*Content*/
    .binder-content {
        flex: 1;
        display: flex;
        flex-direction: column;

        min-height: 0; 

        background-color:  #edeae0;
    }
    /*Header*/
    .binder-header {
        border-bottom: 2px dashed #ccc;
        padding-bottom: 1cqi;
        margin-bottom: 1cqi; 
    }
    .binder-header h2 {
        margin: 0;
        color: #333;
        font-size: 3cqi;
    }
    /*Back button*/
    .back-btn { 
        display: inline-block;
        margin-bottom: 1cqi;

        border: none; 
        border-radius: 0.5cqi; 
        padding: 0.75cqi 1.5cqi; 

        background: #e0dcd3; 
        color: #333; 

        font-weight: bold; 
        font-size: 1cqi;

        cursor: pointer; 
        transition: background 0.2s;
    }
    .back-btn:hover {
        background: #9c988e;
    }
    /*List*/
    .entry-list { 
        list-style: none; 
        padding: 0; 
        margin: 0; 
        overflow-y: auto; 
        flex: 1; 

        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE/Edge */
    }
    .entry-list::-webkit-scrollbar {
        display: none; /* Chrome/Safari */
    }
    /*List items*/
    .entry-item { 
        display: flex; 
        justify-content: space-between; 
        align-items: center; 

        padding: 1rem; 
        border-bottom: 1px solid #e0dcd3; 

        text-decoration: none; 
        color: #444; 

        transition: background 0.2s, padding-left 0.2s;
    }
    .entry-item:hover {
        padding-left: 4cqi; 

        background: #ebe7df; 
        color: #825491;
    }
    .entry-title {
        font-weight: bold;
        font-size: 1.5cqi; 
    }
    .entry-date { 
        font-size: 1.2cqi; 
        color: #888; 
    }
    
    /*Empty*/
    .empty-text{
        margin: 1px;    
        padding: 10px 20px;

        color:#333
    }
</style>

<script>
    import { addLeaveHook } from '../../store';
    import { navigateWithAnimation } from '../../utils/navigation';
    
    document.addEventListener('astro:page-load', () => {
        const binder = document.getElementById('binder-ui');
        const overlay = document.getElementById('binder-overlay');
        const backBtn = document.getElementById('binder-back-btn');
        if(!binder || !overlay) return;

        requestAnimationFrame(() => {
            requestAnimationFrame(() => {
            if (!binder.classList.contains('open')) binder.classList.add('open');
            if (!overlay.classList.contains('show'))    overlay.classList.add('show');
            });
        });

        const goBack = () => navigateWithAnimation('/devlog', 'Devlog');
        overlay.addEventListener('click', goBack);
        backBtn?.addEventListener('click', goBack);

        const entryLinks = document.querySelectorAll('.entry-item');
        entryLinks.forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault(); 
                const href = link.getAttribute('href');
                if (href) {
                    navigateWithAnimation(href, 'DevlogPaper');
                }
            });
        });


        addLeaveHook((targetView) => {
            if (targetView === 'DevlogBinder' || targetView === 'DevlogPaper') {
                return Promise.resolve();
            }
            return new Promise((resolve) => {
                binder.classList.remove('open');
                overlay.classList.remove('show');
                setTimeout(()=>{
                    overlay.style.display = 'none';
                    binder.style.display = 'none';
                    resolve();
                }, 600); 
            });
        });
    });
</script>