---
// src/components/Binder.astro
const { title, entries } = Astro.props;
---

<div id="binder-overlay" class="binder-overlay" transition:animate="none" ></div>

<div id="binder-ui" class="binder-ui" transition:animate="none" >
    <div class="binder-header">
        <button id="binder-back-btn" class="back-btn">← Back</button>
        <h2>📂 {title}</h2>
    </div>
    
    <div class="binder-content">
        <ul class="entry-list">
            {entries.map((entry: any) => (
                <li>
                    <a href={`/devlog/${entry.id}`} class="entry-item">
                        <span class="entry-title">📄 {entry.data.title}</span>
                        <span class="entry-date">{entry.data.pubDate.toLocaleDateString()}</span>
                    </a>
                </li>
            ))}
            {entries.length === 0 && <p class="empty-text">oh no! It's empty!...</p>}
        </ul>
    </div>
</div>

<style>
    .binder-overlay {
        position: fixed;
        top: 0; 
        left: 0; 
        width: 100%; 
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(4px);
        
        z-index: 275;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.4s ease;
    }
    .binder-overlay.show {
        opacity: 1;
        pointer-events: auto;
    }

    .binder-ui {
        position: absolute;
        top: 10%;
        left: 20%;
        width: 60%;
        height: 80%;
        background-color: #f4f1ea;
        border-radius: 12px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        border-left: 15px solid #825491;
        padding: 3cqi;
        display: flex;
        flex-direction: column;
        
        z-index: 300;
        transform: translateY(20%) scale(0.9);
        opacity: 0;
        transition: all 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .binder-ui.open {
        transform: translateY(0) scale(1);
        opacity: 1;
    }
    .binder-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 0; 

        background-color:  #edeae0;
    }


    .binder-header { border-bottom: 2px dashed #ccc; padding-bottom: 1rem; margin-bottom: 1rem; }
    .back-btn { display: inline-block; padding: 0.5rem 1rem; background: #e0dcd3; color: #333; border: none; border-radius: 6px; font-weight: bold; margin-bottom: 1rem; cursor: pointer; transition: background 0.2s; }
    .back-btn:hover { background: #d1ccbf; }
    .binder-header h2 { margin: 0; color: #333; font-size: 3cqi; }
    .entry-list { list-style: none; padding: 0; margin: 0; overflow-y: auto; flex: 1; 
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE/Edge */}
        
    .entry-list::-webkit-scrollbar {
        display: none; /* Chrome/Safari */
    }
    .entry-item { display: flex; justify-content: space-between; align-items: center; padding: 1rem; border-bottom: 1px solid #e0dcd3; text-decoration: none; color: #444; transition: background 0.2s, padding-left 0.2s; }
    .entry-item:hover { background: #ebe7df; padding-left: 1.5rem; color: #825491; }
    .entry-title { font-weight: bold; font-size: 1.5cqi; }
    .entry-date { font-size: 1.2cqi; color: #888; }
</style>

<script>
    import { addLeaveHook } from '../../store';
    import { navigateWithAnimation } from '../../utils/navigation';
    
    document.addEventListener('astro:page-load', () => {
        const binder = document.getElementById('binder-ui');
        const overlay = document.getElementById('binder-overlay');
        const backBtn = document.getElementById('binder-back-btn');
        if(!binder || !overlay) return;

        requestAnimationFrame(() => {
            requestAnimationFrame(() => {
                
            if (!binder.classList.contains('open')) binder.classList.add('open');
            if (!overlay.classList.contains('show'))    overlay.classList.add('show');
            });
        });

        const goBack = () => navigateWithAnimation('/devlog', 'Devlog');
        overlay.addEventListener('click', goBack);
        backBtn?.addEventListener('click', goBack);

        addLeaveHook(() => {
            return new Promise((resolve) => {
                binder.classList.remove('open');
                overlay.classList.remove('show');
                setTimeout(()=>{
                    overlay.style.display = 'none';
                    binder.style.display = 'none';
                    resolve();
                }, 600); 
            });
        });
    });
</script>