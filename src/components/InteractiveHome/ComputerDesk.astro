<div class ="desk-container">
    <button class="desk-item bookshelf" aria-label="Go to Devlog">
        <span>Bookshelf</span>
    </button>
    <button class="desk-item computer" aria-label="Go to Blog">
        <span>Computer</span>
    </button>
    <button class="desk-item paper" aria-label="Go to About">
        <span>Paper</span>
    </button>
</div>

<style>
    /*Desk*/
    .desk-container{
        --desk-background:#1c0e20;

        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow:hidden;
        aspect-ratio: 16 / 8.05;

        width:100%;

        background-color: var(--desk-background) ;
        color:#ffffff ;
    }
    /*Items*/
    .desk-item{
        position:absolute;
        display: flex;
        justify-content: center;
        align-items: center;
        
        outline:none;
        border:none;
        border-radius: 0.5rem;

        color:white;

        font-weight: bold;
        font-size: 1.2rem;
        
        cursor:pointer;
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    /* BookShelf */
    .bookshelf {
        top: 15%;        
        left: 5%;      
        z-index: 10;     

        width: 25%;      
        height: 40%;     

        background-color: #825491; 
    }
    .bookshelf:hover {
        transform: scale(1.05);
    }

    /* Computer */
    .computer {
        bottom: 20%; 
        left: 50%;
        z-index: 20;

        width: 45%;
        height: 40%;
        
        background-color: #4a4e69; 
        
        transform: translateX(-50%); 
    }
    .computer:hover {
        transform: translateX(-50%) scale(1.05);
    }

    /* Paper */
    .paper {
        bottom: 10%;
        right: 15%;
        z-index: 30;

        width: 15%;
        height: 25%;

        background-color: #9a8c98; 
        
        transform: rotate(15deg);
    }
    .paper:hover {
        transform: rotate(15deg) scale(1.1);
    }
</style>
