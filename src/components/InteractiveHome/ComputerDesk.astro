<div class ="desk-container">
    <div class="desk-main">
        <button class="desk-item bookshelf" aria-label="Go to Devlog">
            <span>Bookshelf</span>
        </button>
        <button class="desk-item computer" aria-label="Go to Blog">
            <span>Computer</span>
        </button>
        <button class="desk-item paper" aria-label="Go to About">
            <span>Paper</span>
        </button>
    </div>
    <button id="return-home-btn" class="return-btn" aria-label="Return to home">
        ←Back
    </button>
</div>

<style>
    /*Desk container*/
    .desk-container{
        /*Background*/
        --desk-background:#1c0e20;
        --desk-main:#8d6b9b;
        --ratio-w:16;
        --ratio-h:7.925;

        /*Main desk*/
        --time-zoom-in: 1.2s;
        --time-zoom-out: 3.0s;
        --ease-silky:cubic-bezier(0.22, 1, 0.36, 1);
        /*Paper*/
        --paper-zoom-scale:3.5;
        --paper-origin-x:85%;
        --paper-origin-y:90%;
        /*Computer*/
        --computer-zoom-scale: 2.2;
        --computer-origin-x: 50%;
        --computer-origin-y: 70%;

        position:relative;
        display: flex;
        overflow:hidden;
        justify-content: center;
        align-items: center;
        z-index: 100;

        width:100%;
        height: 100vh;

        background-color: var(--desk-background) ;
    }
    .desk-container::before {
        content: '';
        position: absolute;
        inset: -5%; 
        z-index: -1;

        background-image: url('/Images/desk_bg_Template.png');
        background-size: cover; 
        background-position: center;
        filter: blur(20px); 
        opacity: 0.6; 
    }
    .desk-main{
        position: relative;

        width:100%;
        max-width: calc(100vh * (var(--ratio-w) / var(--ratio-h) ));
        max-height: 100vh;
        aspect-ratio:var(--ratio-w) / var(--ratio-h);
        box-shadow: 0 0 60px rgba(41, 5, 50, 0.927);

        background-image: url('/Images/desk_bg_Template.png');background-size: 100% 100%; 
        background-position: center;
        background-repeat: no-repeat;

        transition: transform var(--time-zoom-in) var(--ease-silky),transform-origin var(--time-zoom-out) ease;
    }
    /*Items*/
    .desk-item{
        position:absolute;
        display: flex;
        justify-content: center;
        align-items: center;
        
        outline:none;
        border:none;
        border-radius: 0.5rem;

        color:white;

        font-weight: bold;
        font-size: 1.2rem;
        
        cursor:pointer;
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    /* BookShelf */
    .bookshelf {
        top: 15%;        
        left: 5%;      
        z-index: 10;     

        width: 25%;      
        height: 40%;     

        background-color: #825491; 
    }
    .bookshelf:hover {
        transform: scale(1.05);
    }

    /* Computer */
    .computer {
        top: var(--computer-origin-y); 
        left: var(--computer-origin-x);
        z-index: 20;

        width: 45%;
        height: 40%;
        
        background-color: #4a4e69;
        
        transform: translate(-50%,-100%);
        
    }
    .computer:hover {
        transform: translate(-50%,-100%) scale(1.05);
    }

    /* Paper */
    .paper {
        bottom: calc(100% - var(--paper-origin-y));
        right:calc(100% - var(--paper-origin-x));
        z-index: 30;

        width: 15%;
        height: 25%;

        background-color: #9a8c98; 
        
        transform: rotate(15deg);
    }
    .paper:hover {
        transform: rotate(15deg) scale(1.1);
    }

    /*Return btn*/
    .return-btn {
    position: absolute;
    top: 10rem;
    left: 2rem;
    z-index: 400; 
    
    padding: 0.8rem 1.5rem;
    
    background: var(--header-dark-purple, rgba(48,10,60,0.9));
    color: white;
    border: 1px solid #d8b4fe;
    border-radius: 0.5rem;
    
    font-family: var(--font-nav, sans-serif);
    font-size: 1.1rem;
    cursor: pointer;
    
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
    }
    .return-btn.is-visible {
        opacity: 1;
        pointer-events: auto;
    }

    /*Zoom in*/
    .desk-main.zoom-to-paper{
        transform-origin: var(--paper-origin-x) var(--paper-origin-y);
        transform: scale(var(--paper-zoom-scale));
        transition: transform var(--time-zoom-in) var(--ease-silky);
    }
    .desk-main.zoom-to-computer{
        transform-origin: var(--computer-origin-x) calc(var(--computer-origin-y)- 20%);
        transform: scale(var(--computer-zoom-scale));
        transition: transform var(--time-zoom-in) var(--ease-silky);
    }
    .desk-main.zoom-to-others{
    }
</style>

<script>
    import { currentView } from "../../store";
    const paperBtn=document.querySelector('.paper');
    const deskMain=document.querySelector('.desk-main');
    const returnBtn=document.querySelector('.return-btn');
    const computerBtn=document.querySelector('.computer');

    if(paperBtn && deskMain && returnBtn && computerBtn){

    paperBtn.addEventListener('click', () => {
        deskMain.classList.add('zoom-to-paper');
        deskMain.classList.remove('zoom-to-computer');
        returnBtn.classList.add('is-visible');
        currentView.set('About'); 
    });

    computerBtn.addEventListener('click',()=>{
        deskMain.classList.add('zoom-to-computer');
        deskMain.classList.remove('zoom-to-paper');
        returnBtn.classList.add('is-visible');
        currentView.set('Blog'); 
    });

    returnBtn.addEventListener('click', () => {
        deskMain.classList.remove('zoom-to-paper');
        deskMain.classList.remove('zoom-to-computer');
        returnBtn.classList.remove('is-visible');
        currentView.set('Home');
    }); 

}
</script>
