<div class ="desk-container">
    <div class="desk-main">
        <button class="desk-item bookshelf" aria-label="Go to Devlog">
            <span>Bookshelf</span>
        </button>
        <button class="desk-item computer" aria-label="Go to Blog">
            <span>Computer</span>
        </button>
        <button class="desk-item paper" aria-label="Go to About">
            <span>Paper</span>
        </button>
    </div>
</div>

<style>
    /*Desk container*/
    .desk-container{
        --desk-background:#1c0e20;
        --desk-main:#8d6b9b;
        --ratio-w:16;
        --ratio-h:7.925;

        position:relative;
        display: flex;
        overflow:hidden;
        justify-content: center;
        align-items: center;
        z-index: 100;

        width:100%;
        height: 100vh;

        background-color: var(--desk-background) ;
    }
    .desk-container::before {
        content: '';
        position: absolute;
        inset: -5%; 
        z-index: -1;

        background-image: url('/Images/desk_bg_Template.png');
        background-size: cover; 
        background-position: center;
        filter: blur(20px); 
        opacity: 0.6; 
    }
    .desk-main{
        position: relative;

        width:100%;
        max-width: calc(100vh * (var(--ratio-w) / var(--ratio-h) ));
        max-height: 100vh;
        aspect-ratio:var(--ratio-w) / var(--ratio-h);
        box-shadow: 0 0 60px rgba(100, 86, 109, 0.8);

        background-image: url('/Images/desk_bg_Template.png');background-size: 100% 100%; 
        background-position: center;
        background-repeat: no-repeat;
    }
    /*Items*/
    .desk-item{
        position:absolute;
        display: flex;
        justify-content: center;
        align-items: center;
        
        outline:none;
        border:none;
        border-radius: 0.5rem;

        color:white;

        font-weight: bold;
        font-size: 1.2rem;
        
        cursor:pointer;
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    /* BookShelf */
    .bookshelf {
        top: 15%;        
        left: 5%;      
        z-index: 10;     

        width: 25%;      
        height: 40%;     

        background-color: #825491; 
    }
    .bookshelf:hover {
        transform: scale(1.05);
    }

    /* Computer */
    .computer {
        bottom: 20%; 
        left: 50%;
        z-index: 20;

        width: 45%;
        height: 40%;
        
        background-color: #4a4e69; 
        
        transform: translateX(-50%); 
    }
    .computer:hover {
        transform: translateX(-50%) scale(1.05);
    }

    /* Paper */
    .paper {
        bottom: 10%;
        right: 15%;
        z-index: 30;

        width: 15%;
        height: 25%;

        background-color: #9a8c98; 
        
        transform: rotate(15deg);
    }
    .paper:hover {
        transform: rotate(15deg) scale(1.1);
    }
</style>
