---
import { getCollection } from "astro:content";

const devlogs = (await getCollection('devlog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const books = devlogs.filter(post => post.id.endsWith('/config'));
books.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const getFolderSlug = (id: string) => id.split('/')[0];
---

<div id="bookshelf-ui" class="bookshelf-ui" transition:name="bookshelf-ui" transition:persist>
    <div class="placeholder-content">
        <h2>📚 Devlog Bookshelf</h2>
        <p>Markdown list: {books.length} books, { devlogs.length - books.length} devlogs</p>
    </div>
    
    <div class="bookshelf-scroll-container" id="bookshelf-scroll">
        <div class="bookshelf-track">
            {
                books.map((book) => {
                    const folderSlug = getFolderSlug(book.id);
                    return (
                        <a href={`/devlog/${folderSlug}`} class="book-card">
                            <div class="book-content">
                                <h3>{book.data.title}</h3>
                                <time>{book.data.pubDate.toLocaleDateString()}</time>
                            </div>
                        </a>
                    )
                })
            }
        </div>
    </div>
</div>


<style>
    /*main */
    .bookshelf-ui {
        position: absolute;
        top: 0;
        right: 0;
        display: flex;
        flex-direction: column;

        width: 100%;
        height: 100%;
        border-left: 2px solid #666;

        background-color: #4a4a4a; 

        transform: translateX(100%);
        
        transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .bookshelf-ui.slide-in {
        transform: translateX(0);
    }


    /*temp content */
    .placeholder-content {
        padding: 3cqi;

        color: white;
        font-family: sans-serif;

        flex-shrink: 0;
    }
    .placeholder-content h2 {
        margin-bottom: 2cqi;

        font-size: 5cqi; 
    }
    .placeholder-content p {
        font-size: 2cqi;
    }

    /*scroll view*/
    .bookshelf-scroll-container {
        flex: 1;
        overflow-x: auto;
        overflow-y: hidden;
        
        width: 100%;
        min-height: 0; 
        
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE/Edge */
    }
    .bookshelf-scroll-container::-webkit-scrollbar {
        display: none; /* Chrome/Safari */
    }

    .bookshelf-track {
        display: flex;
        align-items: center;
        

        min-height: 100%;
        width: max-content;
        padding: 1cqi 5cqi; 
        gap: 3cqi;
    }

    /* Book card */
    .book-card {
        flex-shrink: 0;
        display: flex;
        justify-content: center;
        align-items: center;

        width: 20cqi;
        height: 20cqi;
        border: 1px solid #555;
        border-radius: 12px;
        
        margin: 3cqi 0; 

        color: #aaa;
        background-color: #2d2d2d;
        
        font-size: 2cqi;
        font-weight: bold;
        text-decoration: none;
        
        transition: transform 0.3s ease, background-color 0.3s ease;
        cursor: pointer;
    }

    .book-card:hover {
        background-color: #3d3d3d;
        color: white;

        transform: translateY(-2cqi);
    }
    
    .book-content h3 {
        font-size: 2.5cqi;
        margin: 0 0 1cqi 0;
        color: inherit;
    }

    .book-content time {
        font-size: 1.5cqi;
        opacity: 0.7;
    }
</style>

<script>
    import { ANIMATION_TIMES } from "../../config";
    import { addLeaveHook } from "../../store";
    
    let unsubscribe: () => void = () => {};

    document.addEventListener('astro:page-load', () => {
        const bookshelf = document.getElementById('bookshelf-ui');
        const scrollContainer = document.getElementById('bookshelf-scroll');
        if(!bookshelf)return;

        //Enter
         if (!bookshelf.classList.contains('slide-in')){
            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    bookshelf.classList.add('slide-in');
                });
            });
        }
        //Leave
        addLeaveHook((targetView) => {
            if (targetView === 'DevlogBinder' || targetView === 'Devlog') {
                return Promise.resolve();
            }
            
            return new Promise((resolve) => {
                bookshelf.classList.remove('slide-in');
                setTimeout(resolve, ANIMATION_TIMES.ZOOM_DEVLOG || 800);
            });
        });

        //Scroll view
        if (scrollContainer) {
            const handleWheel = (e: WheelEvent) => {
                if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
                    e.preventDefault();
                    scrollContainer.scrollLeft += e.deltaY;
                }
            };
            
            scrollContainer.addEventListener('wheel', handleWheel, { passive: false });
        } else {
            console.error("cannot find bookshelf-scroll content");
        }

    });
</script>