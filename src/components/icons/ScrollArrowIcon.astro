---
const { class: className, width = "48", ...rest } = Astro.props;
---

<button 
    id="scroll-arrow" 
    class:list={["scroll-arrow", className]} 
    aria-label="Scroll down to enter"
    {...rest}
>
    <!-- 科技感 HUD 文本区域 -->
    <div class="hud-container">
        <span class="hud-bracket left">[</span>
        <span class="hint-text">  SCROLL  </span>
        <span class="hud-bracket right">]</span>
    </div>
    
    <!-- 能量轨道与箭头 -->
    <div class="scanner-system">
        <div class="energy-track"></div>
        <div class="arrows-container">
            <svg class="chevron chevron-1" xmlns="http://www.w3.org/2000/svg" width={width} viewBox="0 6 24 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="5 9 12 16 19 9"></polyline>
            </svg>
            <svg class="chevron chevron-2" xmlns="http://www.w3.org/2000/svg" width={width} viewBox="0 6 24 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="5 9 12 16 19 9"></polyline>
            </svg>
            <svg class="chevron chevron-3" xmlns="http://www.w3.org/2000/svg" width={width} viewBox="0 6 24 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="5 9 12 16 19 9"></polyline>
            </svg>
        </div>
    </div>
</button>

<style>
    /* =========================================
       Main Container
    ========================================= */
    .scroll-arrow {
        /* 核心定位保留 */
        position: absolute;
        bottom: 8%; 
        
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        
        background: none;
        border: none;
        cursor: pointer;
        outline: none;
        
        animation: systemBoot 1.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    @keyframes systemBoot {
        0% { opacity: 0; transform: translateY(20px) scale(0.95); filter: blur(8px); }
        100% { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
    }

    /* =========================================
       HUD Text System
    ========================================= */
    .hud-container {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: 'Inter', monospace, sans-serif;
    }

    .hud-bracket {
        color: #6d28d9;
        font-size: 1.2rem;
        font-weight: 300;
        text-shadow: 0 0 8px rgba(139, 92, 246, 0.4);
        transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), color 0.4s ease;
    }

    /* 出厂动画：括号向两侧机械展开 */
    .hud-bracket.left { animation: bracketDeployLeft 1.5s 0.2s cubic-bezier(0.22, 1, 0.36, 1) both; }
    .hud-bracket.right { animation: bracketDeployRight 1.5s 0.2s cubic-bezier(0.22, 1, 0.36, 1) both; }

    @keyframes bracketDeployLeft {
        0% { transform: translateX(15px); opacity: 0; }
        100% { transform: translateX(0); opacity: 1; }
    }
    @keyframes bracketDeployRight {
        0% { transform: translateX(-15px); opacity: 0; }
        100% { transform: translateX(0); opacity: 1; }
    }

    .hint-text {
        font-size: 1.5rem;
        letter-spacing: 0.15em;
        color: #a78bfa;
        font-weight: 600;
        text-transform: uppercase;
        
        /* 出厂动画：文字间距拉开与发光 */
        animation: textBoot 1.5s 0.4s cubic-bezier(0.22, 1, 0.36, 1) both, textPulse 3s 2s infinite alternate;
        transition: all 0.4s ease;
    }

    @keyframes textBoot {
        0% { letter-spacing: 0em; opacity: 0; filter: blur(4px); }
        100% { letter-spacing: 0.15em; opacity: 1; filter: blur(0); }
    }
    @keyframes textPulse {
        0%, 100% { opacity: 0.7; text-shadow: 0 0 4px rgba(139, 92, 246, 0.2); }
        50% { opacity: 1; text-shadow: 0 0 10px rgba(139, 92, 246, 0.6); }
    }

    /* =========================================
       Scanner System (Track & Arrows)
    ========================================= */
    .scanner-system {
        position: relative;
        display: flex;
        justify-content: center;
        width: 60px;
        height: 70px;
    }

    /* 垂直能量轨道 */
    .energy-track {
        position: absolute;
        top: 0;
        width: 2px;
        height: 100%;
        background: linear-gradient(to bottom, transparent, rgba(139, 92, 246, 0.3), transparent);
        border-radius: 2px;
        
        /* 出厂动画：轨道从上往下绘制 */
        transform-origin: top;
        animation: drawTrack 1s 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
        transition: all 0.4s ease;
    }

    @keyframes drawTrack {
        0% { transform: scaleY(0); opacity: 0; }
        100% { transform: scaleY(1); opacity: 1; }
    }

    .arrows-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0; 
        margin-top: -5px;
    }

    .chevron {
        color: #8b5cf6;
        filter: drop-shadow(0 0 4px rgba(139, 92, 246, 0.4));
        
        /* 延迟启动，等轨道画完再开始传输 */
        animation: dataFlow 2s infinite;
        transition: all 0.3s ease;
    }

    .chevron-1 { animation-delay: 1.2s; }
    .chevron-2 { animation-delay: 1.4s; }
    .chevron-3 { animation-delay: 1.6s; }

    /* 箭头数据流动画 */
    @keyframes dataFlow {
        0% { opacity: 0; transform: translateY(-10px) scale(0.8); }
        30% { opacity: 1; transform: translateY(0) scale(1); filter: drop-shadow(0 0 8px rgba(139, 92, 246, 0.8)); }
        70% { opacity: 0; transform: translateY(15px) scale(0.8); }
        100% { opacity: 0; transform: translateY(15px); }
    }

    /* =========================================
       Hover Overload (悬浮超载状态)
    ========================================= */
    .scroll-arrow:hover .hud-bracket.left {
        transform: translateX(-6px);
        color: #d8b4fe;
        text-shadow: 0 0 12px #a78bfa;
    }
    .scroll-arrow:hover .hud-bracket.right {
        transform: translateX(6px);
        color: #d8b4fe;
        text-shadow: 0 0 12px #a78bfa;
    }

    .scroll-arrow:hover .hint-text {
        color: #ffffff;
        letter-spacing: 0.25em;
        text-shadow: 0 0 15px rgba(216, 180, 254, 0.8);
        animation: none; /* 悬浮时停止呼吸，保持最高亮度 */
    }

    .scroll-arrow:hover .energy-track {
        background: linear-gradient(to bottom, transparent, #a78bfa, transparent);
        box-shadow: 0 0 15px #8b5cf6, 0 0 5px #d8b4fe;
        width: 3px;
    }

    .scroll-arrow:hover .chevron {
        color: #e9d5ff;
        animation-duration: 1s; /* 悬浮时传输速度翻倍 */
        filter: drop-shadow(0 0 10px #d8b4fe);
    }
</style>