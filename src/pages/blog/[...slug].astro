---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComputerScreen from '../../components/InteractiveHome/Blog/ComputerScreen.astro';
import Page from '../../components/InteractiveHome/Blog/Page.astro';

export async function getStaticPaths() {
    const allBlogs = await getCollection('blog');
    
    const actualPosts = allBlogs.filter(post => !post.id.endsWith('/config'));

    return actualPosts.map(post => {
        const folderSlug = post.id.split('/')[0];
        
        const config = allBlogs.find(p => p.id === `${folderSlug}/config`);
        const folderTitle = config ? config.data.title : folderSlug;

        const entries = allBlogs.filter(p => 
            p.id.startsWith(folderSlug + '/') && !p.id.endsWith('/config')
        ).sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()); 

        return {
            params: { slug: post.id },
            props: { 
                post: post,
                folderTitle: folderTitle,
                entries: entries
            }
        };
    });
}

const { post, folderTitle, entries } = Astro.props;


const { Content } = await render(post);

const folderSlug = post.id.split('/')[0];

---


<BaseLayout title={post.data.title} description="This is blog Page.">
	<ComputerScreen/>
    <Page  slot="overlay" post={post} folderSlug={folderSlug}/>
</BaseLayout>


