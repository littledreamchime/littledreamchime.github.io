---
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
import BaseLayout from '../../layouts/BaseLayout.astro';
import Bookshelf from '../../components/InteractiveHome/Devlog/Bookshelf.astro';
---

 
<BaseLayout title="Devlog" description="This is my Devlog page.">
	<Bookshelf />
	<Bookshelf mode="mobile" slot="overlay" />
</BaseLayout>
