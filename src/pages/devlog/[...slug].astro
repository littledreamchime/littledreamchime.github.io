---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Bookshelf from '../../components/InteractiveHome/Devlog/Bookshelf.astro';
import Binder from '../../components/InteractiveHome/Devlog/Binder.astro';
import Page from '../../components/InteractiveHome/Devlog/Page.astro';

export async function getStaticPaths() {
    const allDevlogs = await getCollection('devlog');
    
    const actualPosts = allDevlogs.filter(post => !post.id.endsWith('/config'));

    return actualPosts.map(post => {
        const folderSlug = post.id.split('/')[0];
        
        const config = allDevlogs.find(p => p.id === `${folderSlug}/config`);
        const folderTitle = config ? config.data.title : folderSlug;

        const entries = allDevlogs.filter(p => 
            p.id.startsWith(folderSlug + '/') && !p.id.endsWith('/config')
        ).sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()); 

        return {
            params: { slug: post.id },
            props: { 
                post: post,
                folderTitle: folderTitle,
                entries: entries
            }
        };
    });
}

const { post, folderTitle, entries } = Astro.props;

const { Content } = await render(post);

const folderSlug = post.id.split('/')[0];

---


<BaseLayout title={post.data.title} description="Devlog Folder" >
	<Bookshelf/>
    <Binder slot="overlay" title={folderTitle} entries={entries} folderSlug={folderSlug}/>
    <Page slot="overlay" post={post} folderSlug={folderSlug}></Page>
</BaseLayout>

