---
// src/pages/devlog/[...slug].astro
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Bookshelf from '../../components/InteractiveHome/Bookshelf.astro';
import Binder from '../../components/InteractiveHome/Binder.astro';
import type { config } from 'astro:schema';

export async function getStaticPaths() {
    const allDevlogs = await getCollection('devlog');
    
    const actualPosts = allDevlogs.filter(post => !post.id.endsWith('/config'));

    return actualPosts.map(post => {
        const folderSlug = post.id.split('/')[0];
        
        const config = allDevlogs.find(p => p.id === `${folderSlug}/config`);
        const folderTitle = config ? config.data.title : folderSlug;

        const entries = allDevlogs.filter(p => 
            p.id.startsWith(folderSlug + '/') && !p.id.endsWith('/config')
        ).sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()); 

        return {
            params: { slug: post.id },
            props: { 
                post: post,
                folderTitle: folderTitle,
                entries: entries
            }
        };
    });
}

const { post, folderTitle, entries } = Astro.props;

const { Content } = await render(post);

const folderSlug = post.id.split('/')[0];

---


<BaseLayout title={post.data.title} description="Devlog Folder" transition:animate="none">
	<Bookshelf/>
    <Binder title={folderTitle} entries={entries}/>
</BaseLayout>

<div id="paper-overlay" class="paper-overlay" transition:animate="none"></div>

<div id="paper-ui" class="paper-ui" transition:animate="none">
	<div class="paper-header">
		<button id="paper-back-btn" class="back-btn" data-target={`/devlog/${folderSlug}`}>
			← Back
		</button>
		<div class="meta">
			<h1>{post.data.title}</h1>
			<time>{post.data.pubDate.toLocaleDateString()}</time>
		</div>
	</div>

	<div class="paper-content">
		<Content />
	</div>
</div>

<style>
    .paper-overlay {
        position: fixed;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0, 0, 0, 0.6);
        z-index: 275;
        backdrop-filter: blur(4px);

        opacity: 0;
        pointer-events: none;
        transition: opacity 0.6s ease;
    }
    .paper-overlay.show {
        opacity: 1;
        pointer-events: auto;
    }

    .paper-ui {
        position: absolute;
        top: 10%;
        left: 50%;
        width: 80%;
        max-width: 800px;
        height: 80vb;
		overflow: hidden;
        
        background-color: #fdfbf7;
        border-radius: 4px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(0,0,0,0.05);
        
        /* 居中偏移 */
        transform: translate(-50%, 20%) scale(0.95);
        
        display: flex;
        flex-direction: column;
        z-index: 300;
        opacity: 0;
        transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .paper-ui.open {
        transform: translate(-50%, 0) scale(1);
        opacity: 1;
    }

    .paper-header {
        padding: 3rem 4rem 1rem 4rem;
        border-bottom: 2px solid #eae6df;
    }

    .back-btn {
        display: inline-block;
        padding: 0.5rem 1rem;
        background: #eeebe3;
        color: #555;
        border: none;
        border-radius: 6px;
        font-weight: bold;
        margin-bottom: 2rem;
        cursor: pointer;
        transition: background 0.2s;
    }
    .back-btn:hover { background: #e2dfd5; color: #000; }

    .meta h1 {
        margin: 0 0 0.5rem 0;
        font-size: 2.5rem;
        color: #222;
        font-family: serif; 
    }
    .meta time {
        color: #888;
        font-size: 1rem;
    }

    /* 正文区域 */
    .paper-content {
        padding: 2rem 4rem 4rem 4rem;
        overflow-y: auto;
        flex: 1;
        color: #333;
        font-family: sans-serif;
        line-height: 1.8;
        font-size: 1.1rem;
        
        /* 隐藏滚动条 */
        scrollbar-width: none;
        -ms-overflow-style: none;
    }
    .paper-content::-webkit-scrollbar { display: none; }

    /* 简单美化一下 Markdown 渲染出的 HTML 元素 */
    .paper-content :global(h2) { margin-top: 2rem; color: #222; border-bottom: 1px solid #eae6df; padding-bottom: 0.5rem; }
    .paper-content :global(p) { margin-bottom: 1.5rem; }
    .paper-content :global(a) { color: #825491; text-decoration: none; border-bottom: 1px dashed #825491; }
    .paper-content :global(code) { background: #f0ede6; padding: 0.2rem 0.4rem; border-radius: 4px; font-size: 0.9em; }
    .paper-content :global(pre) { background: #2d2d2d; color: #ccc; padding: 1rem; border-radius: 8px; overflow-x: auto; }
</style>

<script>
    import { addLeaveHook } from '../../store';
    import { navigateWithAnimation } from '../../utils/navigation';
    
    document.addEventListener('astro:page-load', () => {
        const paper = document.getElementById('paper-ui');
        const overlay = document.getElementById('paper-overlay');
        const backBtn = document.getElementById('paper-back-btn');
        if(!paper || !overlay) return;

        // 1. 进场动画：纸张从下方浮现
        requestAnimationFrame(() => {
            requestAnimationFrame(() => {
                if (!paper.classList.contains('open')) paper.classList.add('open');
                if (!overlay.classList.contains('show')) overlay.classList.add('show');
            });
        });

        // 2. 返回逻辑
        const goBack = () => {
            const targetUrl = backBtn?.getAttribute('data-target') || '/devlog';
            navigateWithAnimation(targetUrl, 'DevlogBinder');
        };

        overlay.addEventListener('click', goBack);
        backBtn?.addEventListener('click', goBack);

        // 3. 离场动画
        addLeaveHook(() => {
            return new Promise((resolve) => {
                paper.classList.remove('open');
                overlay.classList.remove('show');
                
                setTimeout(() => {
                    // 物理超度，防止 backdrop-filter 闪烁 Bug
                    overlay.style.display = 'none';
                    paper.style.display = 'none';
                    resolve();
                }, 800); 
            });
        });
    });
</script>