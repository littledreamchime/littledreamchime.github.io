---
import ReturnHomeButton from "../components/InteractiveHome/Main/ReturnHomeButton.astro";
import { ANIMATION_TIMES } from "../config";
import '../styles/zIndex.css';

const timeZoomIn=`${ANIMATION_TIMES.ZOOM_IN/1000}s`;
const timeZoomOut=`${ANIMATION_TIMES.ZOOM_OUT/1000}s`;
---


<div class="desk-container">
    <div id="desk-main" class="desk-main">
        <slot />
    </div>
    <slot name="overlay"></slot>
    <ReturnHomeButton/>
</div>


<style define:vars={{timeZoomIn,timeZoomOut}}>
    /*Desk container*/
    .desk-container{
        /*Background*/
        --desk-background:#1c0e20;
        --desk-main:#8d6b9b;
        --ratio-w:16;
        --ratio-h:7.925;

        /*Main desk*/
        --ease-silky: cubic-bezier(0.25, 0.8, 0.25, 1);
        /*Paper*/
        --paper-zoom-scale:3.5;
        --paper-origin-x:85%;
        --paper-origin-y:90%;
        /*Computer*/
        --computer-zoom-scale: 2.2;
        --computer-origin-x: 50%;
        --computer-origin-y: 50%;

        position:relative;
        display: flex;
        overflow:hidden;
        justify-content: center;
        align-items: center;
        z-index: var(--z-desk-bg);

        width:100%;
        height: 100vh;

        background-color: var(--desk-background) ;
    }
    .desk-container::before {
        content: '';
        position: absolute;
        inset: -5%; 
        z-index: var(--z-negative);

        background-image: url('/Images/desk_bg_Template.png');
        background-size: cover; 
        background-position: center;
        filter: blur(20px); 
        opacity: 0.6; 
    }
    .desk-main{
        position: relative;
        container-type:inline-size;
        overflow: hidden;

        width:100%;
        max-width: calc(100vh * (var(--ratio-w) / var(--ratio-h) ));
        max-height: 100vh;
        aspect-ratio:var(--ratio-w) / var(--ratio-h);
        box-shadow: 0 0 60px rgba(41, 5, 50, 0.927);

        background-image: url('/Images/desk_bg_Template.png');background-size: 100% 100%; 
        background-position: center;
        background-repeat: no-repeat;

        transition: transform var(--timeZoomOut) var(--ease-silky),transform-origin var(--timeZoomOut) ease;
    }

    /*Zoom in*/
    .desk-main.zoom-to-paper{
        transform-origin: var(--paper-origin-x) var(--paper-origin-y);
        transform: scale(var(--paper-zoom-scale));
        transition: transform var(--timeZoomIn) var(--ease-silky),transform-origin var(--timeZoomOut) var(--ease-silky);
    }
    .desk-main.zoom-to-computer{
        transform-origin: var(--computer-origin-x) calc(var(--computer-origin-y));
        transform: scale(var(--computer-zoom-scale));
        transition: transform var(--timeZoomIn) var(--ease-silky),transform-origin var(--timeZoomOut) ease;
    }
    .desk-main.zoom-to-others{
    }
    .no-transition {
        transition: none !important;
    }
</style>

<script>
    import { currentView } from "../store";
    import {navigateWithAnimation,getViewMeta} from "../utils/navigation";
    import { addLayoutLeaveHook } from "../store";
    import { ANIMATION_TIMES } from "../config";

    let unsubscribe:()=> void=()=>{}; 

    document.addEventListener('astro:page-load', () => {
        const deskMain = document.getElementById('desk-main');
        if (!deskMain) return;

        /*Transition Animation*/
        const expectedView=currentView.get();
        const isNotHome=(expectedView!=='Home');
        if(isNotHome){
            deskMain.classList.add('no-transition');
        }
        if(unsubscribe) unsubscribe();

        unsubscribe = currentView.subscribe((view: string) => {
            deskMain.classList.remove('zoom-to-paper', 'zoom-to-computer');
            const meta=getViewMeta(view);

            if(meta.zoom !== 'none'){
                deskMain.classList.add('zoom-to-'+meta.zoom);
            }
        });

        if(isNotHome){
            deskMain.offsetHeight;
            deskMain.classList.remove('no-transition');
        }

        /*Leave time controll*/
        /* This part only controll Home, Blog, Devlog and About parent transition. */
        addLayoutLeaveHook((targetView)=>{
            return new Promise((resolve)=>{
                const currentMeta=getViewMeta(expectedView);
                const targetMeta=getViewMeta(targetView);

                if(currentMeta.parent === targetMeta.parent){
                    resolve();
                    return;
                }

                if(currentMeta.zoom===targetMeta.zoom){
                    setTimeout(resolve,ANIMATION_TIMES.NO_ZOOM_LITTLE_WAIT);
                    return;
                }

                let isResolved=false;

                const handleTransitionEnd=(e:TransitionEvent)=>{
                    if (e.propertyName === 'transform' && e.target === deskMain) {
                        deskMain.removeEventListener('transitionend', handleTransitionEnd);
                        if (!isResolved) {
                            isResolved = true;
                            resolve();
                        }
                    }
                }
                deskMain.addEventListener('transitionend', handleTransitionEnd);
                

                const fallbackTime = Math.max(ANIMATION_TIMES.ZOOM_OUT, ANIMATION_TIMES.ZOOM_IN) + 50;
                setTimeout(() => {
                    if (!isResolved) {
                        deskMain.removeEventListener('transitionend', handleTransitionEnd);
                        isResolved = true;
                        resolve();
                    }
                }, fallbackTime);
            });
        });

    });
</script>